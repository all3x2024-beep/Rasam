

@if (@TempData["msg"] is not null)
{
	<h5 class="alert alert-danger">
		@TempData["msg"]

	</h5>
}



<div class="portlet box shadow">

	<div class="portlet-heading">
		<div class="portlet-title">
			<h3 class="title">
				<i class="icon-layers"></i>
				تغییر رمز عبور @User.Identity.Name	
			</h3>
		</div><!-- /.portlet-title -->
		<div class="buttons-box">
			<a class="btn btn-sm btn-sm btn-default btn-round btn-fullscreen" rel="tooltip" title="تمام صفحه" href="#">
				<i class="icon-size-fullscreen"></i>
			</a>
			<a class="btn btn-sm btn-sm btn-default btn-round btn-collapse" rel="tooltip" title="کوچک کردن" href="#">
				<i class="icon-arrow-up"></i>
			</a>
		</div><!-- /.buttons-box -->
	</div><!-- /.portlet-heading -->

	<div class="portlet-body">
		<div class="row">
			<div class="col-4">
		</div>
		<div class="col-4">

				<p class="text-center m-t-40 m-b-40">
					<i class="icon-lock border img-circle text-primary font-xxxlg p-20"></i>
				</p>
				<hr>
				<form id="simple-form1" asp-action="ChangePassword" asp-controller="Accounting" method="post">
					<div class="form-body">
						<div class="form-group">
							<label for="oldPassword">رمز عبور پیشین</label>
							<div class="input-group has-btn-toggle-pass">
								<span class="input-group-addon">
									<i class="icon-lock"></i>
								</span>
								<input type="password" id="oldPassword" name="CurrentPassword" minlength="6" class="form-control ltr text-left" required>
							
							</div>
						</div>
						<div class="form-group">
							<label for="password">رمز عبور جدید</label>
							<div class="input-group has-btn-toggle-pass">
								<span class="input-group-addon">
									<i class="icon-key"></i>
								</span>
								<input type="password" id="password1" name="NewPassword" oninput="checkPasswords()" minlength="6" class="form-control ltr text-left" required>
							
							</div>
						</div>
						<div class="form-group">
							<label for="confirmPassword">تکرار رمز عبور جدید</label>
							<div class="input-group has-btn-toggle-pass">
								<span class="input-group-addon">
									<i class="icon-key"></i>
								</span>
								<input type="password" name="confirm_password" id="password2" oninput="checkPasswords()" minlength="6" class="form-control ltr text-left" required>
						
							</div>
						</div>
						<h3 class="text-danger" id="message"></h3>
					</div>
					<hr />
					<div class="form-actions">
						<button type="submit" class="btn btn-success btn-round btn-block">
							<i class="icon-check"></i>
							ذخیره
						</button>
				
					</div>
				</form>
		</div>
		<div class="col-4">
			</div>
		</div>
	</div>
</div>

	<script>
	function checkPasswords() {
		const password1 = document.getElementById('password1').value;
		const password2 = document.getElementById('password2').value;
		const message = document.getElementById('message');

		if (password1 === '' || password2 === '') {
			message.textContent = 'لطفاً هر دو رمز عبور را وارد کنید.';
		} else if (password1 !== password2) {
			message.textContent = 'رمز عبور جدید و تکرار آن یکسان  نیستند.';
		} else {
			message.textContent = '';
		}
	}
</script>
									