<script>

    'use strict';

    /* =========================================================
       پایه — متغیرهای سراسری و توابع کمکی
    ========================================================= */

    window.records = [];

    window.relations = [];

    let currentEditRecordId = null;
    let graphRelCache = null;   // کش روابط برای گراف

    /* =========================================================
       HELPERS
    ========================================================= */

    function getValue(obj, ...keys) {

        if (!obj) return '';

        for (const key of keys) {

            if (
                obj[key] !== undefined &&
                obj[key] !== null
            ) {
                return obj[key];
            }
        }

        return '';
    }

    function escapeHtml(value) {

        if (
            value === null ||
            value === undefined
        ) {
            return '';
        }

        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function getToken() {

        return document.querySelector(
            '#addRecordForm input[name="__RequestVerificationToken"]'
        )?.value || '';
    }

    function openModal(modal) {

        if (!modal) return;

        modal.classList.add('show');

        document.body.classList.add('modal-open');
    }

    function closeModal(modal) {

        if (!modal) return;

        modal.classList.remove('show');

        if (modal.id === 'graphModal') {
            G.token++;
            graphStop();
        }

        if (
            !document.querySelector('.modal.show')
        ) {
            document.body.classList.remove('modal-open');
        }
    }

</script>

<!-- =========================================================
     SCRIPT 02 · انتخاب‌گر چندگانه
========================================================= -->
<script>

    'use strict';

    /* =========================================================
       انتخاب‌گر چندگانه هوشمند
    ========================================================= */

    function getMultiSelectValues(select) {

        if (!select) return [];

        return Array.from(select.selectedOptions)
            .map(x => x.value)
            .filter(Boolean);
    }

    function setMultiSelectValues(select, values) {
        if (!select) return;
        const ids = Array.isArray(values) ? values.map(String) : [];
        Array.from(select.options).forEach(option => {
            option.selected = ids.includes(String(option.value));
        });
        refreshSmartMultiSelect(select);
    }

    function refreshSmartMultiSelect(select) {
        if (!select) return;
        const wrapper = select.nextElementSibling;
        if (!wrapper || !wrapper.classList.contains('smart-select-ui')) return;
        const search = wrapper.querySelector('.smart-select-search');
        const optionsBox = wrapper.querySelector('.smart-select-options');
        const chips = wrapper.querySelector('.smart-select-chips');
        const count = wrapper.querySelector('.smart-select-count');
        const selected = Array.from(select.selectedOptions);
        const keepScroll = optionsBox.scrollTop;
        chips.innerHTML = '';
        selected.forEach(option => {
            const chip = document.createElement('span');
            chip.className = 'smart-select-chip';
            chip.innerHTML = `<span>${escapeHtml(option.textContent)}</span><button type="button">×</button>`;
            chip.querySelector('button').addEventListener('click', e => {
                e.stopPropagation(); option.selected = false;
                select.dispatchEvent(new Event('change', { bubbles: true }));
            });
            chips.appendChild(chip);
        });
        count.textContent = selected.length ? `${selected.length} انتخاب` : '';
        const q = (search.value || '').trim().toLocaleLowerCase('fa');
        optionsBox.innerHTML = '';
        Array.from(select.options).forEach(option => {
            const label = option.textContent || '';
            if (q && !label.toLocaleLowerCase('fa').includes(q)) return;
            const row = document.createElement('button');
            row.type = 'button';
            row.className = 'smart-select-option' + (option.selected ? ' is-selected' : '');
            row.innerHTML = `<span class="smart-option-check">${option.selected ? '✓' : ''}</span><span>${escapeHtml(label)}</span>`;
            row.addEventListener('click', () => {
                option.selected = !option.selected;
                select.dispatchEvent(new Event('change', { bubbles: true }));
                if (wrapper.classList.contains('is-open')) search.focus({ preventScroll: true });
            });
            optionsBox.appendChild(row);
        });
        if (!optionsBox.children.length) {
            optionsBox.innerHTML = select.dataset.error
                ? '<div class="smart-select-error">' + escapeHtml(select.dataset.error) + '</div>'
                : '<div class="smart-select-empty">' + (select.options.length ? 'موردی پیدا نشد.' : 'هنوز تگی تعریف نشده است.') + '</div>';
        }
        optionsBox.scrollTop = keepScroll;
    }

    function initSmartMultiSelect(select) {
        if (!select) return;
        if (select.dataset.smartReady === '1') { refreshSmartMultiSelect(select); return; }
        select.dataset.smartReady = '1';
        select.classList.add('smart-select-native');
        const wrapper = document.createElement('div');
        wrapper.className = 'smart-select-ui';
        wrapper.innerHTML = `<div class="smart-select-head"><div class="smart-select-chips"></div><span class="smart-select-placeholder">${escapeHtml(select.dataset.placeholder || 'انتخاب کنید')}</span><span class="smart-select-count"></span><span class="smart-select-arrow" aria-hidden="true"></span></div><div class="smart-select-panel"><div class="smart-select-search-wrap"><span>⌕</span><input type="search" class="smart-select-search" placeholder="جستجو..." autocomplete="off"></div><div class="smart-select-options"></div></div>`;
        select.insertAdjacentElement('afterend', wrapper);
        const head = wrapper.querySelector('.smart-select-head');
        const search = wrapper.querySelector('.smart-select-search');
        head.addEventListener('click', e => {
            if (e.target.closest('button')) return;
            document.querySelectorAll('.smart-select-ui.is-open').forEach(x => { if (x !== wrapper) x.classList.remove('is-open'); });
            wrapper.classList.toggle('is-open');
            if (wrapper.classList.contains('is-open')) { search.value = ''; refreshSmartMultiSelect(select); requestAnimationFrame(() => search.focus()); }
        });
        search.addEventListener('input', () => refreshSmartMultiSelect(select));
        select.addEventListener('change', () => refreshSmartMultiSelect(select));
        // نکته: با کلیک روی یک گزینه، لیست دوباره ساخته می‌شود و e.target از DOM جدا می‌شود؛
        // پس contains(e.target) غلط false می‌داد و پنل بسته می‌شد. composedPath مسیر لحظهٔ کلیک را نگه می‌دارد.
        document.addEventListener('click', e => {
            const path = typeof e.composedPath === 'function' ? e.composedPath() : [];
            if (path.includes(wrapper) || wrapper.contains(e.target)) return;
            wrapper.classList.remove('is-open');
        });
        refreshSmartMultiSelect(select);
    }

    function initAllSmartMultiSelects() { document.querySelectorAll('.smart-multi-select').forEach(initSmartMultiSelect); }

</script>

