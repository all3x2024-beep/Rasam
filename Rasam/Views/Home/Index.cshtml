                    );


                    currentEditRecordId =
                        null;


                    await loadRecords();


                    alert(
                        (result.message || 'تغییرات با موفقیت ذخیره شد.') +
                        (relFailed ? '\nاما ' + relFailed + ' رابطه ذخیره نشد.' : '')
                    );

                }
                catch (error) {

                    console.error(error);

                    alert(
                        (error && error.message) ||
                        'خطا در ارتباط با سرور.'
                    );

                }
                finally {

                    button.disabled = false;

                }

            }
        );

    }

</script>

