<script>

    'use strict';

    /* =========================================================
       GRAPH · 2/4 — داده، محاسبات، چیدمان‌ها و ساخت گراف
    ========================================================= */

    /* ---------- Data ---------- */

    async function graphFetchRelations() {

        if (graphRelCache) return graphRelCache;

        const records = window.records || [];
        const cache = new Map();
        const queue = records.slice();
        const baseUrl = '@Url.Action("GetProfileRelations", "Profile")?profileId=';

        const worker = async () => {
            while (queue.length) {
                const r = queue.shift();
                const id = String(getValue(r, 'id', 'Id'));

                try {
                    const res = await fetch(baseUrl + encodeURIComponent(id), { cache: 'no-store' });
                    const data = res.ok ? await res.json() : [];
                    cache.set(id, Array.isArray(data) ? data : []);
                }
                catch (error) {
                    console.error('Graph relations:', error);
                    cache.set(id, []);
                }
            }
        };

        await Promise.all(
            Array.from({ length: Math.min(6, records.length) }, worker)
        );

        graphRelCache = cache;
        return cache;
    }

    function graphPrepare(cache) {

        const records = window.records || [];

        const typeById = new Map(
            (window.relations || []).map(x => [
                String(getValue(x, 'id', 'Id')),
                String(getValue(x, 'type', 'Type'))
            ])
        );

        G.allNodes = new Map();
        const idByUsername = new Map();

        records.forEach(r => {

            const id = String(getValue(r, 'id', 'Id'));
            const label = graphRecordLabel(r);
            const topic = String(getValue(r, 'topic', 'Topic') || '');
            const full = (String(getValue(r, 'firstName', 'FirstName') || '') + ' ' +
                          String(getValue(r, 'lastName', 'LastName') || '')).trim();

            G.allNodes.set(id, {
                id, label, rec: r, topic,
                search: (label + ' ' + full + ' ' + topic).toLocaleLowerCase('fa')
            });

            const u = String(getValue(r, 'usernameId', 'UsernameId') || '').trim().toLowerCase();
            if (u) idByUsername.set(u, id);
        });

        G.allEdges = [];
        const seen = new Set();

        cache.forEach((list, queriedId) => {
            list.forEach(x => {

                const from = String(getValue(x, 'fromProfileId', 'FromProfileId') || queriedId);

                let to = String(getValue(x, 'toProfileId', 'ToProfileId') || '');

                if (!to) {
                    const u = String(getValue(x, 'toUsernameId', 'ToUsernameId') || '').trim().toLowerCase();
                    to = idByUsername.get(u) || '';
                }

                if (!to || from === to || !G.allNodes.has(from) || !G.allNodes.has(to)) return;

                const relId = String(getValue(x, 'relationId', 'RelationId'));
                const type = String(getValue(x, 'type', 'Type') || typeById.get(relId) || 'رابطه');

                const key = from + '|' + to + '|' + relId + '|' + type;
                if (seen.has(key)) return;
                seen.add(key);

                G.allEdges.push({ from, to, type });
            });
        });

        /* درجهٔ کل هر گره */
        G.degree = new Map();
        G.allEdges.forEach(e => {
            G.degree.set(e.from, (G.degree.get(e.from) || 0) + 1);
            G.degree.set(e.to, (G.degree.get(e.to) || 0) + 1);
        });

        /* رنگ پایدار برای هر نوع رابطه / موضوع */
        const types = Array.from(new Set(G.allEdges.map(e => e.type))).sort(graphFa);
        G.typeColors = new Map(types.map((t, i) => [t, GRAPH_PALETTE[i % GRAPH_PALETTE.length]]));

        const topics = Array.from(new Set(
            Array.from(G.allNodes.values()).map(n => n.topic).filter(Boolean)
        )).sort(graphFa);
        G.topicColors = new Map(topics.map((t, i) => [t, GRAPH_PALETTE[(i + 3) % GRAPH_PALETTE.length]]));
    }

    function graphPopulateFilters() {

        const relSel = document.getElementById('graphFilterRelation');
        const topicSel = document.getElementById('graphFilterTopic');

        if (relSel) {
            const types = Array.from(new Set(G.allEdges.map(e => e.type))).sort(graphFa);
            relSel.innerHTML = '<option value="">همه روابط</option>' +
                types.map(t => '<option value="' + escapeHtml(t) + '">' + escapeHtml(t) + '</option>').join('');
            relSel.value = '';
        }

        if (topicSel) {
            const topics = Array.from(new Set(Array.from(G.allNodes.values()).map(n => n.topic).filter(Boolean)))
                .sort(graphFa);
            topicSel.innerHTML = '<option value="">همه موضوعات</option>' +
                topics.map(t => '<option value="' + escapeHtml(t) + '">' + escapeHtml(t) + '</option>').join('');
            topicSel.value = '';
        }
    }

    /* ---------- Graph metrics ---------- */

    function graphAdjacency(edges) {
        const adj = new Map();
        const add = (a, b) => {
            if (!adj.has(a)) adj.set(a, []);
            adj.get(a).push(b);
        };
        edges.forEach(e => { add(e.from, e.to); add(e.to, e.from); });
        return adj;
    }

    /* فاصلهٔ هر گره تا مبدأ (حداکثر maxDepth گام) */
    function graphBfs(adj, startId, maxDepth) {
        const dist = new Map([[startId, 0]]);
        const queue = [startId];

        for (let qi = 0; qi < queue.length; qi++) {
            const cur = queue[qi];
            const d = dist.get(cur);
            if (d >= maxDepth) continue;

            (adj.get(cur) || []).forEach(nx => {
                if (!dist.has(nx)) {
                    dist.set(nx, d + 1);
                    queue.push(nx);
                }
            });
        }

        return dist;
    }

    function graphCountComponents(nodes, edges) {
        const adj = graphAdjacency(edges);
        const seen = new Set();
        let count = 0;

        nodes.forEach(n => {
            if (seen.has(n.id)) return;
            count++;
            graphBfs(adj, n.id, Infinity).forEach((_, id) => seen.add(id));
        });

        return count;
    }

    function graphShortestPath(fromId, toId) {

        const adj = graphAdjacency(G.edges);
        const prev = new Map([[fromId, null]]);
        const queue = [fromId];

        for (let qi = 0; qi < queue.length; qi++) {
            const cur = queue[qi];
            if (cur === toId) break;

            (adj.get(cur) || []).forEach(nx => {
                if (!prev.has(nx)) {
                    prev.set(nx, cur);
                    queue.push(nx);
                }
            });
        }

        if (!prev.has(toId)) return null;

        const ids = [];
        for (let c = toId; c !== null; c = prev.get(c)) ids.push(c);

        return ids.reverse();
    }

    /* ---------- Layouts ---------- */

    function graphSortedNodes() {
        return G.nodes.slice().sort((a, b) =>
            graphFa(a.topic || '', b.topic || '') || graphFa(a.label, b.label));
    }

    function graphComputeLayout(mode) {

        const nodes = G.nodes, n = nodes.length;
        if (!n) return;

        if (mode === 'circle') {

            const R = Math.max(130, (n * (GRAPH_R * 2 + 28)) / (2 * Math.PI));

            graphSortedNodes().forEach((nd, i) => {
                const a = (i / n) * Math.PI * 2 - Math.PI / 2;
                nd.x = Math.cos(a) * R;
                nd.y = Math.sin(a) * R;
            });

            return;
        }

        if (mode === 'grid') {

            const cols = Math.ceil(Math.sqrt(n * 1.4));
            const rows = Math.ceil(n / cols);
            const gx = 150, gy = 105;

            graphSortedNodes().forEach((nd, i) => {
                nd.x = ((i % cols) - (cols - 1) / 2) * gx;
                nd.y = (Math.floor(i / cols) - (rows - 1) / 2) * gy;
            });

            return;
        }

        if (mode === 'radial') {

            /* مرکز: گره منتخب، وگرنه گرهٔ تمرکز، وگرنه پرارتباط‌ترین گره */
            let center = G.nodeMap.get(G.selectedId) || G.nodeMap.get(G.focusId);
            if (!center) center = nodes.reduce((best, nd) => (nd.deg > best.deg ? nd : best), nodes[0]);

            const dist = graphBfs(graphAdjacency(G.edges), center.id, Infinity);

            let maxLevel = 0;
            dist.forEach(d => { maxLevel = Math.max(maxLevel, d); });

            const levels = new Map();
            nodes.forEach(nd => {
                const lv = dist.has(nd.id) ? dist.get(nd.id) : maxLevel + 1;
                if (!levels.has(lv)) levels.set(lv, []);
                levels.get(lv).push(nd);
            });

            let prevRadius = 0;

            Array.from(levels.keys()).sort((a, b) => a - b).forEach(lv => {

                const ring = levels.get(lv);

                if (lv === 0) {
                    ring[0].x = 0; ring[0].y = 0;
                    return;
                }

                const need = (ring.length * (GRAPH_R * 2 + 30)) / (2 * Math.PI);
                const radius = Math.max(prevRadius + 150, need);
                prevRadius = radius;

                ring.forEach((nd, i) => {
                    const a = (i / ring.length) * Math.PI * 2 - Math.PI / 2 + lv * 0.35;
                    nd.x = Math.cos(a) * radius;
                    nd.y = Math.sin(a) * radius;
                });
            });

            return;
        }

        if (mode === 'topic') {

            const groups = new Map();
            nodes.forEach(nd => {
                const key = nd.topic || 'بدون موضوع';
                if (!groups.has(key)) groups.set(key, []);
                groups.get(key).push(nd);
            });

            const list = Array.from(groups.values()).sort((a, b) => b.length - a.length);
            const spacing = 42;
            const radii = list.map(g => spacing * Math.sqrt(g.length) + GRAPH_R + 20);

            let ringR = 0;
            if (list.length > 1) {
                const total = radii.reduce((s, r) => s + 2 * r + 50, 0);
                ringR = Math.max(Math.max.apply(null, radii) * 1.4, total / (2 * Math.PI));
            }

            list.forEach((group, gi) => {

                const a = list.length > 1 ? (gi / list.length) * Math.PI * 2 - Math.PI / 2 : 0;
                const cx = Math.cos(a) * ringR, cy = Math.sin(a) * ringR;

                group.forEach((nd, i) => {
                    const ang = i * 2.39996;
                    const rad = spacing * Math.sqrt(i + 0.5);
                    nd.x = cx + Math.cos(ang) * rad;
                    nd.y = cy + Math.sin(ang) * rad;
                });
            });
        }
    }

    /* ---------- Markers / clip paths (یکی برای هر رنگ / شعاع) ---------- */

    function graphMarkerFor(color) {

        if (!color) return 'graphArrowHead';

        const id = 'graphArrow_' + color.replace('#', '');

        if (!G.defs.querySelector('#' + id)) {
            const marker = svgEl('marker', {
                id, viewBox: '0 0 10 10', refX: '10', refY: '5',
                markerWidth: '9', markerHeight: '9',
                markerUnits: 'userSpaceOnUse', orient: 'auto'
            });
            marker.appendChild(svgEl('path', { d: 'M0,0 L10,5 L0,10 z', fill: color }));
            G.defs.appendChild(marker);
        }

        return id;
    }

    function graphClipFor(r) {

        const id = 'graphClip_' + Math.round(r);

        if (!G.defs.querySelector('#' + id)) {
            const clip = svgEl('clipPath', { id });
            clip.appendChild(svgEl('circle', { r: r - 1 }));
            G.defs.appendChild(clip);
        }

        return id;
    }

    /* ---------- Build / rebuild visible graph ---------- */

    function graphRebuild(refit) {

        graphStop();
        graphViewportSize();

        const opts = graphOpts();
        const relFilter = document.getElementById('graphFilterRelation')?.value || '';
        const topicFilter = document.getElementById('graphFilterTopic')?.value || '';

        /* مسیر قبلی با تغییر گراف معتبر نیست */
        G.path = null;
        G.pathFrom = null;
        graphUpdatePathBar();

        let ids = new Set(
            Array.from(G.allNodes.values())
                .filter(n => !topicFilter || n.topic === topicFilter)
                .map(n => n.id)
        );

        let edges = G.allEdges.filter(e =>
            (!relFilter || e.type === relFilter) &&
            !G.hiddenTypes.has(e.type) &&
            ids.has(e.from) && ids.has(e.to)
        );

        if (G.focusId) {

            /* گرهٔ تمرکز + همسایه‌ها تا «عمق» انتخابی */
            const dist = graphBfs(graphAdjacency(edges), G.focusId, opts.depth);
            const keep = new Set(dist.keys());

            edges = edges.filter(e => keep.has(e.from) && keep.has(e.to));
            ids = keep;
        }
        else {

            const need = Math.max(opts.minDeg, (relFilter || G.hiddenTypes.size) ? 1 : 0);

            if (need > 0) {
                const deg = new Map();
                edges.forEach(e => {
                    deg.set(e.from, (deg.get(e.from) || 0) + 1);
                    deg.set(e.to, (deg.get(e.to) || 0) + 1);
                });

                ids = new Set(Array.from(ids).filter(id => (deg.get(id) || 0) >= need));
                edges = edges.filter(e => ids.has(e.from) && ids.has(e.to));
            }
        }

        G.edgeLayer.textContent = '';
        G.nodeLayer.textContent = '';
        G.nodes = [];
        G.edges = [];
        G.nodeMap = new Map();
        G.layoutMode = opts.layout;

        if (!ids.size) {
            graphMessage('گرهٔ مطابق با فیلترهای انتخابی پیدا نشد.');
            graphAfterRebuild();
            return;
        }

        graphMessage('');

        /* درجهٔ هر گره در گرافِ قابل‌مشاهده */
        const vdeg = new Map();
        edges.forEach(e => {
            vdeg.set(e.from, (vdeg.get(e.from) || 0) + 1);
            vdeg.set(e.to, (vdeg.get(e.to) || 0) + 1);
        });

        /* nodes */

        const list = Array.from(ids);
        const count = list.length;

        list.forEach((id, i) => {

            const base = G.allNodes.get(id);
            if (!base) return;

            const deg = vdeg.get(id) || 0;
            const r = opts.sizeByDegree ? Math.min(GRAPH_R_MAX, GRAPH_R + deg * 2) : GRAPH_R;

            let p = G.pos.get(id);

            if (!p) {
                const ang = (i / count) * Math.PI * 2;
                const rad = 60 + Math.sqrt(count) * 40;
                p = {
                    x: Math.cos(ang) * rad + (Math.random() - .5) * 20,
                    y: Math.sin(ang) * rad + (Math.random() - .5) * 20
                };
            }

            if (id === G.focusId) p = { x: 0, y: 0 };

            const node = {
                id, label: base.label, rec: base.rec, search: base.search, topic: base.topic,
                deg, r,
                x: p.x, y: p.y, vx: 0, vy: 0, fixed: false, g: null
            };

            G.nodes.push(node);
            G.nodeMap.set(id, node);
        });

        /* edges (parallel edges get distinct curvature) */

        const groups = new Map();

        edges.forEach(e => {
            const a = G.nodeMap.get(e.from), b = G.nodeMap.get(e.to);
            if (!a || !b) return;

            const edge = {
                from: e.from, to: e.to, type: e.type, a, b, off: 0,
                color: opts.colorEdges ? (G.typeColors.get(e.type) || null) : null,
                path: null, text: null
            };
            G.edges.push(edge);

            const key = e.from < e.to ? e.from + '|' + e.to : e.to + '|' + e.from;
            if (!groups.has(key)) groups.set(key, []);
            groups.get(key).push(edge);
        });

        groups.forEach(group => {
            group.forEach((edge, idx) => {
                const base = (idx - (group.length - 1) / 2) * 46;
                edge.off = edge.from < edge.to ? base : -base;
            });
        });

        /* چیدمان ثابت (غیر از حالت فیزیکی) */

        if (opts.layout !== 'force') graphComputeLayout(opts.layout);

        /* DOM */

        G.edges.forEach(e => {

            e.path = svgEl('path', { class: 'graph-edge', fill: 'none' });
            if (e.color) e.path.style.stroke = e.color;

            e.text = svgEl('text', { class: 'graph-edge-text' });
            e.text.textContent = e.type;

            G.edgeLayer.appendChild(e.path);
            G.edgeLayer.appendChild(e.text);
        });

        G.nodes.forEach(n => {

            const g = svgEl('g', { class: 'graph-node' });
            g.dataset.id = n.id;

            const tip = svgEl('title');
            tip.textContent = n.label + (n.deg ? ' — ' + n.deg + ' رابطه' : '');
            g.appendChild(tip);

            const circle = svgEl('circle', { class: 'graph-node-circle', r: n.r });
            if (opts.colorNodes && n.topic && G.topicColors.has(n.topic)) {
                circle.style.stroke = G.topicColors.get(n.topic);
                circle.style.strokeWidth = '3.5px';
            }
            g.appendChild(circle);

            const img = String(getValue(n.rec, 'image', 'Image') || '');

            if (img) {
                g.appendChild(svgEl('image', {
                    href: img,
                    x: -n.r, y: -n.r,
                    width: n.r * 2, height: n.r * 2,
                    preserveAspectRatio: 'xMidYMid slice',
                    'clip-path': 'url(#' + graphClipFor(n.r) + ')',
                    'pointer-events': 'none'
                }));
            }
            else {
                const s = n.r / GRAPH_R;
                const head = svgEl('circle', { class: 'graph-node-icon', cx: 0, cy: -4.5 * s, r: 4.2 * s });
                const body = svgEl('path', { class: 'graph-node-icon', d: 'M-8.5,9 a8.5,7.5 0 0 1 17,0 z' });
                body.setAttribute('transform', 'scale(' + s + ')');
                g.appendChild(head);
                g.appendChild(body);
            }

            const label = svgEl('text', { class: 'graph-node-label', x: 0, y: n.r + 15 });
            label.textContent = n.label.length > 24 ? n.label.slice(0, 23) + '…' : n.label;
            g.appendChild(label);

            G.nodeLayer.appendChild(g);
            n.g = g;
        });

        graphApplyDisplayOptions();

        /* pre-settle layout so the graph opens already organised */

        if (opts.layout === 'force' && G.nodes.length <= 500) {
            const iterations = G.nodes.length > 200 ? 120 : 220;
            for (let i = 0; i < iterations; i++) {
                graphTick(Math.max(0.05, 1 - i / iterations));
            }
        }

        graphDraw();

        if (refit) graphFit();
        else graphApplyTransform();

        graphApplyClasses();

        G.alpha = 0.2;
        graphStart();

        graphAfterRebuild();
    }

    function graphRememberPositions() {
        /* موقعیت فقط برای چیدمان فیزیکی نگه داشته می‌شود */
        G.nodes.forEach(n => G.pos.set(n.id, { x: n.x, y: n.y }));
    }

    function graphRefresh(refit) {
        graphRememberPositions();
        graphRebuild(refit);
        if (G.selectedId && !G.nodeMap.has(G.selectedId)) graphSelect(null);
    }

</script>

<!-- =========================================================
     SCRIPT 18 · گراف ۳/۴ امکانات
========================================================= -->
<script>

    'use strict';

    /* =========================================================
       GRAPH · 3/4 — امکانات: آمار، راهنما، گره‌های کلیدی،
       مسیر کوتاه، گزینه‌های نمایش، خروجی تصویر و تمام‌صفحه
    ========================================================= */

    const graphNum = (v, digits) =>
        Number(v).toLocaleString('fa-IR', { maximumFractionDigits: digits === undefined ? 0 : digits });

    function graphToast(message, type) {
        try {
            if (typeof window.showToast === 'function') window.showToast(message, type || 'info', 'گراف روابط');
        } catch (e) { }
    }

    /* ---------- گزینه‌های نمایشی که بدون ساخت مجدد اعمال می‌شوند ---------- */

    function graphApplyDisplayOptions() {

        const o = graphOpts();

        G.nodes.forEach(n => {
            const t = n.g && n.g.querySelector('.graph-node-label');
            if (t) t.classList.toggle('is-hidden', !o.nodeLabels);
        });

        G.edges.forEach(e => {
            e.text.classList.toggle('is-hidden', !o.edgeLabels);

            if (o.arrows) e.path.setAttribute('marker-end', 'url(#' + graphMarkerFor(e.color) + ')');
            else e.path.removeAttribute('marker-end');
        });
    }

    /* ---------- آمار گراف ---------- */

    function graphUpdateStats() {

        const set = (id, value) => {
            const el = document.getElementById(id);
            if (el) el.textContent = value;
        };

        const n = G.nodes.length;
        const e = G.edges.length;

        const pairs = new Set(G.edges.map(x => x.from < x.to ? x.from + '|' + x.to : x.to + '|' + x.from));
        const maxPairs = n > 1 ? (n * (n - 1)) / 2 : 0;

        set('graphStatNodes', graphNum(n));
        set('graphStatEdges', graphNum(e));
        set('graphStatTypes', graphNum(new Set(G.edges.map(x => x.type)).size));
        set('graphStatDensity', graphNum(maxPairs ? pairs.size / maxPairs : 0, 2));
        set('graphStatComponents', graphNum(n ? graphCountComponents(G.nodes, G.edges) : 0));
        set('graphStatAvgDeg', graphNum(n ? (2 * e) / n : 0, 1));
    }

    /* ---------- راهنمای رنگ‌ها (کلیک روی نوع رابطه = نمایش/پنهان) ---------- */

    function graphRenderLegend() {

        const box = document.getElementById('graphLegend');
        if (!box) return;

        const opts = graphOpts();
        let html = '';

        if (opts.colorEdges && G.typeColors.size) {

            const counts = new Map();
            G.edges.forEach(e => counts.set(e.type, (counts.get(e.type) || 0) + 1));

            html += '<div class="gx-legend-title">نوع رابطه <small>(کلیک: نمایش / پنهان)</small></div>';

            Array.from(G.typeColors.keys()).sort(graphFa).forEach(type => {
                const off = G.hiddenTypes.has(type);
                html += '<button type="button" class="gx-legend-item' + (off ? ' is-off' : '') +
                    '" data-legend-type="' + escapeHtml(type) + '">' +
                    '<i style="--dot:' + G.typeColors.get(type) + '"></i>' +
                    '<span>' + escapeHtml(type) + '</span>' +
                    '<b>' + graphNum(counts.get(type) || 0) + '</b></button>';
            });
        }

        if (opts.colorNodes && G.topicColors.size) {

            html += '<div class="gx-legend-title">موضوع گره‌ها</div>';

            G.topicColors.forEach((color, topic) => {
                html += '<div class="gx-legend-item is-static"><i style="--dot:' + color + '"></i>' +
                    '<span>' + escapeHtml(topic) + '</span></div>';
            });
        }

        box.innerHTML = html;
        box.hidden = !html;
    }

    function graphUpdatePhysicsButton() {

        const btn = document.getElementById('graphPhysicsToggleBtn');
        if (!btn) return;

        const isForce = G.layoutMode === 'force';

        btn.disabled = !isForce;
        btn.title = isForce ? '' : 'فیزیک فقط در چیدمان «فیزیکی» فعال است';
        btn.textContent = G.paused && isForce ? '▶️ ادامه فیزیک' : '⏸️ توقف فیزیک';
    }

    /* بعد از هر بار ساخت گراف */
    function graphAfterRebuild() {
        graphUpdateStats();
        graphRenderLegend();
        graphUpdatePhysicsButton();
    }

    /* ---------- مسیر کوتاه بین دو گره ---------- */

    function graphUpdatePathBar(message) {

        const bar = document.getElementById('graphPathBar');
        const text = document.getElementById('graphPathText');
        if (!bar || !text) return;

        const nameOf = id => (G.allNodes.get(id) || {}).label || id;

        if (message) {
            text.textContent = message;
        }
        else if (G.path) {
            text.textContent = 'کوتاه‌ترین مسیر (' + graphNum(G.path.ids.length - 1) + ' گام): ' +
                G.path.ids.map(nameOf).join('  ←  ');
        }
        else if (G.pathFrom) {
            text.textContent = 'مبدأ: «' + nameOf(G.pathFrom) + '» — روی گرهٔ مقصد کلیک کنید.';
        }
        else {
            text.textContent = '';
        }

        bar.hidden = !text.textContent;
    }

    function graphStartPath(fromId) {
        G.path = null;
        G.pathFrom = fromId;
        graphUpdatePathBar();
        graphApplyClasses();
    }

    function graphClearPath() {
        G.path = null;
        G.pathFrom = null;
        graphUpdatePathBar();
        graphApplyClasses();
    }

    function graphShowPath(fromId, toId) {

        const ids = graphShortestPath(fromId, toId);
        const nameOf = id => (G.allNodes.get(id) || {}).label || id;

        G.pathFrom = null;

        if (!ids) {
            G.path = null;
            graphUpdatePathBar('مسیری بین «' + nameOf(fromId) + '» و «' + nameOf(toId) + '» در گراف فعلی پیدا نشد.');
            graphApplyClasses();
            return;
        }

        const nodes = new Set(ids);
        const edges = new Set();

        for (let i = 0; i < ids.length - 1; i++) {
            const a = ids[i], b = ids[i + 1];
            G.edges.forEach(e => {
                if ((e.from === a && e.to === b) || (e.from === b && e.to === a)) edges.add(e);
            });
        }

        G.path = { ids, nodes, edges };
        graphUpdatePathBar();
        graphApplyClasses();
    }

    /* ---------- خروجی تصویر (PNG / SVG) ---------- */

    function graphBlobToDataUrl(blob) {
        return new Promise((resolve, reject) => {
            const fr = new FileReader();
            fr.onload = () => resolve(fr.result);
            fr.onerror = reject;
            fr.readAsDataURL(blob);
        });
    }

    async function graphImageToDataUrl(url) {
        try {
            const res = await fetch(url, { cache: 'force-cache' });
            if (!res.ok) return '';
            return await graphBlobToDataUrl(await res.blob());
        }
        catch (error) {
            return '';
        }
    }

    function graphBackgroundColor() {

        const probes = [
            document.getElementById('graphViewport'),
            document.querySelector('#graphModal .modal-content'),
            document.body
        ];

        for (const el of probes) {
            if (!el) continue;
            const c = getComputedStyle(el).backgroundColor;
            if (c && c !== 'transparent' && c !== 'rgba(0, 0, 0, 0)') return c;
        }

        return '#ffffff';
    }

    /* نسخهٔ مستقل از SVG فعلی (استایل‌ها داخل خود فایل قرار می‌گیرد) */
    async function graphBuildExport() {

        if (!G.svg || !G.nodes.length) return null;

        const pad = 50;
        let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;

        G.nodes.forEach(n => {
            minX = Math.min(minX, n.x - n.r);
            maxX = Math.max(maxX, n.x + n.r);
            minY = Math.min(minY, n.y - n.r);
            maxY = Math.max(maxY, n.y + n.r + 24);
        });

        const w = Math.ceil(maxX - minX + pad * 2);
        const h = Math.ceil(maxY - minY + pad * 2);

        const clone = G.svg.cloneNode(true);

        const props = [
            'fill', 'fill-opacity', 'stroke', 'stroke-width', 'stroke-opacity', 'stroke-dasharray',
            'stroke-linejoin', 'stroke-linecap', 'opacity', 'font-family', 'font-size', 'font-weight',
            'text-anchor', 'dominant-baseline', 'paint-order', 'display', 'visibility'
        ];

        const srcEls = G.svg.querySelectorAll('*');
        const dstEls = clone.querySelectorAll('*');

        srcEls.forEach((el, i) => {
            const cs = getComputedStyle(el);
            const dst = dstEls[i];
            if (!dst) return;
            props.forEach(p => {
                const v = cs.getPropertyValue(p);
                if (v) dst.style.setProperty(p, v);
            });
        });

        /* تصویرها باید داخل فایل جاسازی شوند، وگرنه در PNG دیده نمی‌شوند */
        const images = Array.from(clone.querySelectorAll('image'));
        await Promise.all(images.map(async img => {
            const href = img.getAttribute('href');
            const data = href ? await graphImageToDataUrl(href) : '';
            if (data) img.setAttribute('href', data);
            else img.remove();
        }));

        const layer = clone.children[1];
        if (layer) layer.removeAttribute('transform');

        clone.removeAttribute('style');
        clone.setAttribute('xmlns', SVG_NS);
        clone.setAttribute('width', String(w));
        clone.setAttribute('height', String(h));
        clone.setAttribute('viewBox', (minX - pad) + ' ' + (minY - pad) + ' ' + w + ' ' + h);

        const bg = svgEl('rect', {
            x: minX - pad, y: minY - pad, width: w, height: h, fill: graphBackgroundColor()
        });
        clone.insertBefore(bg, clone.firstChild);

        return { svg: clone, w, h };
    }

    function graphDownloadBlob(blob, ext) {

        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');

        a.href = url;
        a.download = 'rasam-graph-' + new Date().toISOString().slice(0, 10) + '.' + ext;

        document.body.appendChild(a);
        a.click();
        a.remove();

        setTimeout(() => URL.revokeObjectURL(url), 4000);
    }

    async function graphExport(kind) {

        try {
            const built = await graphBuildExport();

            if (!built) {
                graphToast('گرافی برای خروجی گرفتن وجود ندارد.', 'warning');
                return;
            }

            const text = new XMLSerializer().serializeToString(built.svg);

            const scale = Math.min(2, 8192 / Math.max(built.w, built.h));
            const url = URL.createObjectURL(new Blob([text], { type: 'image/svg+xml;charset=utf-8' }));

            const img = new Image();

            await new Promise((resolve, reject) => {
                img.onload = resolve;
                img.onerror = reject;
                img.src = url;
            });

            const canvas = document.createElement('canvas');
            canvas.width = Math.max(1, Math.round(built.w * scale));
            canvas.height = Math.max(1, Math.round(built.h * scale));
            canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);

            URL.revokeObjectURL(url);

            canvas.toBlob(blob => {
                if (blob) graphDownloadBlob(blob, 'png');
                else graphToast('ساخت تصویر PNG انجام نشد.', 'error');
            }, 'image/png');
        }
        catch (error) {
            console.error('Graph export:', error);
            graphToast('ساخت فایل خروجی انجام نشد.', 'error');
        }
    }

    /* ---------- تمام‌صفحه ---------- */

    function graphToggleFullscreen() {

        const box = document.querySelector('#graphModal .graph-modal-content');
        const btn = document.getElementById('graphFullscreenBtn');
        if (!box) return;

        const on = box.classList.toggle('is-fullscreen');
        if (btn) btn.textContent = on ? '🗗 خروج از تمام‌صفحه' : '⛶ تمام‌صفحه';

        setTimeout(() => {
            graphViewportSize();
            graphFit();
        }, 120);
    }

</script>

<!-- =========================================================
     SCRIPT 19 · گراف ۴/۴ رابط و رویدادها
========================================================= -->
<script>

    'use strict';

    /* =========================================================
       GRAPH · 4/4 — پنل جزئیات، انتخاب، تمرکز، باز شدن مودال
       و اتصال رویدادها
    ========================================================= */

    /* ---------- Selection / sidebar / focus ---------- */

    function graphRenderSidebar(id) {

        const sidebar = document.getElementById('graphSidebar');
        const content = document.getElementById('graphSidebarContent');
        const base = G.allNodes.get(id);

        if (!sidebar || !content || !base) return;

        const r = base.rec;
        const img = String(getValue(r, 'image', 'Image') || '');
        const full = (String(getValue(r, 'firstName', 'FirstName') || '') + ' ' +
                      String(getValue(r, 'lastName', 'LastName') || '')).trim();

        const outgoing = G.allEdges.filter(e => e.from === id);
        const incoming = G.allEdges.filter(e => e.to === id);

        const nameOf = x => (G.allNodes.get(x) || {}).label || x;
        const link = x => '<a href="#" class="gx-goto" data-goto-id="' + escapeHtml(x) + '">' + escapeHtml(nameOf(x)) + '</a>';

        const lines = [];

        outgoing.slice(0, 10).forEach(e =>
            lines.push('<div class="graph-details-meta">↗ ' + escapeHtml(e.type) + ': <strong>' + link(e.to) + '</strong></div>'));

        incoming.slice(0, 10).forEach(e =>
            lines.push('<div class="graph-details-meta">↙ ' + escapeHtml(e.type) + ': <strong>' + link(e.from) + '</strong></div>'));

        const hidden = outgoing.length + incoming.length - lines.length;

        /* تعداد روابط به تفکیک نوع */
        const byType = new Map();
        outgoing.concat(incoming).forEach(e => byType.set(e.type, (byType.get(e.type) || 0) + 1));

        const typeChips = Array.from(byType.entries())
            .sort((a, b) => b[1] - a[1])
            .map(([t, c]) => '<span class="gx-type-chip"><i style="--dot:' + (G.typeColors.get(t) || '#94a3b8') + '"></i>' +
                escapeHtml(t) + ' <b>' + graphNum(c) + '</b></span>')
            .join('');

        content.innerHTML =
            (img
                ? '<img class="graph-details-avatar" src="' + escapeHtml(img) + '" alt="">'
                : '<div class="graph-details-empty-avatar">👤</div>') +
            '<h4 class="graph-details-name">' + escapeHtml(base.label) + '</h4>' +
            (full ? '<div class="graph-details-meta">نام: ' + escapeHtml(full) + '</div>' : '') +
            (typeChips ? '<div class="gx-type-chips">' + typeChips + '</div>' : '') +
            (lines.length ? '<hr class="graph-details-sep">' + lines.join('') : '') +
            (hidden > 0 ? '<div class="graph-details-meta">و ' + hidden + ' رابطه دیگر…</div>' : '') +
            '<div class="gx-side-actions">' +
                (G.focusId === id
                    ? ''
                    : '<button type="button" class="btn btn-info graph-focus-btn" data-focus-id="' + escapeHtml(id) + '">🎯 تمرکز روی این گره</button>') +
                '<button type="button" class="btn btn-secondary graph-path-btn" data-path-from="' + escapeHtml(id) + '">📍 مسیر از این گره به…</button>' +
            '</div>';

        sidebar.classList.add('active');
    }

    function graphSelect(id) {

        const previous = G.selectedId;
        const next = id || null;

        /* حالت مسیریابی: کلیک روی گرهٔ دوم = مقصد */
        if (G.pathFrom && next && next !== G.pathFrom && G.nodeMap.has(next)) {
            graphShowPath(G.pathFrom, next);
        }

        G.selectedId = next;

        const sidebar = document.getElementById('graphSidebar');

        if (G.selectedId && G.allNodes.has(G.selectedId)) graphRenderSidebar(G.selectedId);
        else {
            G.selectedId = null;
            if (sidebar) sidebar.classList.remove('active');
        }

        /* در چیدمان «حلقه‌ای» مرکز همان گرهٔ منتخب است */
        if (G.layoutMode === 'radial' && G.selectedId && G.selectedId !== previous) {
            graphRefresh(true);
            return;
        }

        graphApplyClasses();
    }

    function graphUpdateFocusBar() {

        const bar = document.getElementById('graphFocusBar');
        const text = document.getElementById('graphFocusText');

        if (!bar || !text) return;

        if (!G.focusId) {
            bar.hidden = true;
            text.textContent = '';
            return;
        }

        const base = G.allNodes.get(G.focusId);
        bar.hidden = false;
        text.textContent = 'نمایش ارتباطات «' + (base ? base.label : '') + '»';
    }

    function graphSetFocus(id) {

        G.focusId = id || null;
        graphUpdateFocusBar();

        graphRebuild(true);

        if (G.focusId) graphSelect(G.focusId);
        else graphSelect(G.selectedId);
    }

    /* ---------- Open ---------- */

    async function openGraph(focusId) {

        const modal = document.getElementById('graphModal');
        if (!modal) return;

        graphInit();

        const token = ++G.token;

        G.focusId = null;
        G.selectedId = null;
        G.pathFrom = null;
        G.path = null;
        G.hiddenTypes = new Set();
        G.pos = new Map();
        G.paused = false;

        const search = document.getElementById('graphSearchInput');
        if (search) search.value = '';

        const depth = document.getElementById('graphDepthSelect');
        if (depth) depth.value = '1';

        document.getElementById('graphSidebar')?.classList.remove('active');
        graphUpdateFocusBar();
        graphUpdatePathBar();
        graphUpdatePhysicsButton();

        openModal(modal);
        graphMessage('⏳ در حال بارگذاری گراف روابط...');

        try {

            if (!Array.isArray(window.records) || !window.records.length) {
                await loadRecords();
            }

            if (token !== G.token) return;

            if (!window.records.length) {
                graphMessage('هنوز رکوردی برای نمایش در گراف ثبت نشده است.');
                return;
            }

            if (!window.relations || !window.relations.length) {
                try { await loadRecordRelations(); } catch (e) { console.error(e); }
            }

            const cache = await graphFetchRelations();

            if (token !== G.token) return;

            graphPrepare(cache);
            graphPopulateFilters();

            const wanted = focusId ? String(focusId) : '';

            if (wanted && G.allNodes.has(wanted)) {
                graphSetFocus(wanted);
            }
            else {
                graphRebuild(true);
            }
        }
        catch (error) {
            console.error('Graph:', error);
            if (token === G.token) graphMessage('خطا در ساخت گراف روابط.');
        }
    }

    /* ---------- One-time setup ---------- */

    function graphInit() {

        if (G.ready) return;

        const container = document.getElementById('graphContainer');
        if (!container) return;

        const svg = svgEl('svg', { width: '100%', height: '100%' });

        const defs = svgEl('defs');

        const marker = svgEl('marker', {
            id: 'graphArrowHead', viewBox: '0 0 10 10',
            refX: '10', refY: '5',
            markerWidth: '9', markerHeight: '9',
            markerUnits: 'userSpaceOnUse', orient: 'auto'
        });
        marker.appendChild(svgEl('path', { d: 'M0,0 L10,5 L0,10 z', class: 'graph-arrow' }));

        defs.appendChild(marker);

        const layer = svgEl('g');
        const edgeLayer = svgEl('g');
        const nodeLayer = svgEl('g');
        layer.append(edgeLayer, nodeLayer);

        svg.append(defs, layer);

        const msg = document.createElement('div');
        msg.className = 'graph-message graph-message-overlay';
        msg.hidden = true;

        container.append(svg, msg);

        G.svg = svg; G.defs = defs; G.layer = layer; G.edgeLayer = edgeLayer; G.nodeLayer = nodeLayer; G.msg = msg;

        /* pan / drag / click */

        svg.addEventListener('pointerdown', e => {

            if (e.button !== 0) return;

            const g = e.target.closest('.graph-node');

            G.drag = {
                id: g ? g.dataset.id : null,
                sx: e.clientX, sy: e.clientY,
                tx: G.tx, ty: G.ty,
                moved: false
            };

            try { svg.setPointerCapture(e.pointerId); } catch (err) { }
        });

        svg.addEventListener('pointermove', e => {

            const d = G.drag;
            if (!d) return;

            const dx = e.clientX - d.sx, dy = e.clientY - d.sy;

            if (!d.moved && Math.hypot(dx, dy) < 4) return;

            d.moved = true;

            if (d.id) {
                const n = G.nodeMap.get(d.id);
                if (!n) return;

                const p = graphToWorld(e.clientX, e.clientY);
                n.x = p.x; n.y = p.y; n.vx = n.vy = 0; n.fixed = true;

                graphReheat(0.35);
                graphDraw();
            }
            else {
                G.tx = d.tx + dx;
                G.ty = d.ty + dy;
                graphApplyTransform();
            }
        });

        const endDrag = e => {

            const d = G.drag;
            if (!d) return;

            G.drag = null;

            try { svg.releasePointerCapture(e.pointerId); } catch (err) { }

            if (d.id) {
                const n = G.nodeMap.get(d.id);
                if (n) n.fixed = false;
                if (!d.moved) graphSelect(d.id);
            }
            else if (!d.moved) {
                graphSelect(null);
            }
        };

        svg.addEventListener('pointerup', endDrag);
        svg.addEventListener('pointercancel', endDrag);

        svg.addEventListener('wheel', e => {
            e.preventDefault();
            graphZoomAt(e.deltaY < 0 ? 1.12 : 1 / 1.12, e.clientX, e.clientY);
        }, { passive: false });

        /* toolbar */

        const $ = id => document.getElementById(id);

        const centerZoom = factor => {
            const rect = svg.getBoundingClientRect();
            graphZoomAt(factor, rect.left + rect.width / 2, rect.top + rect.height / 2);
        };

        $('graphZoomInBtn')?.addEventListener('click', () => centerZoom(1.25));
        $('graphZoomOutBtn')?.addEventListener('click', () => centerZoom(1 / 1.25));

        /* بازنشانی: چیدمان از نو محاسبه می‌شود و نما روی کل گراف قرار می‌گیرد */
        $('graphResetViewBtn')?.addEventListener('click', () => {
            G.pos = new Map();
            graphRebuild(true);
        });

        $('graphLayoutSelect')?.addEventListener('change', () => graphRefresh(true));

        $('graphPhysicsToggleBtn')?.addEventListener('click', function () {
            if (G.layoutMode !== 'force') return;

            G.paused = !G.paused;

            if (G.paused) graphStop();
            else graphReheat(0.3);

            graphUpdatePhysicsButton();
        });

        $('graphFilterRelation')?.addEventListener('change', () => graphRefresh(true));
        $('graphFilterTopic')?.addEventListener('change', () => graphRefresh(true));

        /* گزینه‌های نمایش و چیدمان */

        $('graphOptions')?.addEventListener('change', e => {

            const id = e.target.id;

            if (id === 'graphOptNodeLabels' || id === 'graphOptEdgeLabels' || id === 'graphOptArrows') {
                graphApplyDisplayOptions();
            }
            else if (id === 'graphOptNeighbors') {
                graphApplyClasses();
            }
            else {
                /* اندازه، رنگ‌ها و حداقل روابط نیاز به ساخت مجدد دارند */
                graphRefresh(false);
            }
        });

        $('graphDepthSelect')?.addEventListener('change', () => {
            if (G.focusId) graphRebuild(true);
        });

        /* راهنما: پنهان / نمایش نوع رابطه */

        $('graphLegend')?.addEventListener('click', e => {
            const btn = e.target.closest('[data-legend-type]');
            if (!btn) return;

            const type = btn.dataset.legendType;
            if (G.hiddenTypes.has(type)) G.hiddenTypes.delete(type);
            else G.hiddenTypes.add(type);

            graphRefresh(false);
        });

        /* مسیر، خروجی و تمام‌صفحه */

        $('graphPathClearBtn')?.addEventListener('click', graphClearPath);
        $('graphExportPngBtn')?.addEventListener('click', () => graphExport('png'));
        $('graphFullscreenBtn')?.addEventListener('click', graphToggleFullscreen);

        /* جست‌وجو */

        const search = $('graphSearchInput');

        search?.addEventListener('input', graphApplyClasses);

        search?.addEventListener('keydown', e => {

            if (e.key !== 'Enter') return;
            e.preventDefault();

            const q = search.value.trim().toLocaleLowerCase('fa');
            if (!q) return;

            const hit = G.nodes.find(n => n.search.includes(q));
            if (!hit) return;

            graphCenterOn(hit);
            graphSelect(hit.id);
        });

        $('graphShowAllBtn')?.addEventListener('click', () => graphSetFocus(null));

        $('graphCloseSidebarBtn')?.addEventListener('click', () => graphSelect(null));

        $('graphSidebar')?.addEventListener('click', e => {

            const focusBtn = e.target.closest('[data-focus-id]');
            if (focusBtn) { graphSetFocus(focusBtn.dataset.focusId); return; }

            const pathBtn = e.target.closest('[data-path-from]');
            if (pathBtn) { graphStartPath(pathBtn.dataset.pathFrom); return; }

            const go = e.target.closest('[data-goto-id]');
            if (go) {
                e.preventDefault();

                const id = go.dataset.gotoId;
                const n = G.nodeMap.get(id);

                if (n) { graphCenterOn(n); graphSelect(id); }
                else graphSetFocus(id);
            }
        });

        window.addEventListener('resize', () => {
            if (document.getElementById('graphModal')?.classList.contains('show')) graphViewportSize();
        });

        G.ready = true;
    }

    /* ---------- Modal wiring (از bootstrap صدا زده می‌شود) ---------- */

    function initGraphModal() {

        document.getElementById('graphBtn')?.addEventListener('click', () => openGraph(null));

        document.addEventListener('click', function (event) {
            const btn = event.target.closest('[data-graph-id]');
            if (btn) openGraph(btn.dataset.graphId);
        });

        document.getElementById('graphModal')?.addEventListener('mousedown', function (event) {
            if (event.target === this) closeModal(this);
        });

        document.addEventListener('keydown', function (event) {
            if (event.key !== 'Escape') return;
            const modal = document.getElementById('graphModal');
            if (modal && modal.classList.contains('show')) closeModal(modal);
        });
    }

</script>

<!-- =========================================================
     SCRIPT 20 · راه‌اندازی (bootstrap)
========================================================= -->
<script>

    'use strict';

    /* =========================================================
       راه‌اندازی صفحه (bootstrap)
       - همهٔ اسکریپت‌های بالا فقط تعریف می‌کنند؛ اجرا از اینجاست
       - ترتیب فراخوانی‌ها همان ترتیب اجرای کد اولیهٔ صفحه است
    ========================================================= */

    function reportInitError(name, err) {
        console.error('خطا در ' + name + ':', err);
        if (window.__reportPageError)
            window.__reportPageError('خطا در ' + name + ': ' + (err && err.message ? err.message : err));
    }

    async function initPage() {

        // هر مرحله مستقل است؛ خطای یکی نباید بقیه را متوقف کند
        const step = async (name, fn) => {
            try { await fn(); }
            catch (err) { reportInitError('مرحلهٔ ' + name, err); }
        };

        // موضوع و تگ اول و مستقل از بقیه شروع می‌شوند (خطایشان داخل خودشان مدیریت می‌شود)
        const metaPromise = step('موضوع و تگ', () => Promise.all([loadRecordTopics(), loadRecordTags()]));

        await step('کنترل‌های شبکه اجتماعی', () => initSocialControls());
        await step('انتخاب‌گر کشور', () => initCountryPickers());
        await step('جستجوی جدول', () => initTableSearch());

        await metaPromise;

        await step('روابط', () => loadRecordRelations());
        await step('رکوردها', () => loadRecords());
    }

    document.addEventListener('DOMContentLoaded', function () {

        // خطا در یک راه‌انداز نباید باعث شود بارگذاری موضوع/تگ/روابط هرگز اجرا نشود
        const safe = (name, fn) => {
            try { fn(); }
            catch (err) { reportInitError('راه‌اندازی ' + name, err); }
        };

        safe('شبکه‌های اجتماعی', () => initSocialListeners());
        safe('تصاویر', () => initImagePickers());
        safe('روابط', () => initRelationButtons());
        safe('افزودن رکورد', () => initAddRecord());
        safe('باز کردن ویرایش', () => initEditOpen());
        safe('حذف رکورد', () => initDeleteRecord());
        safe('ذخیرهٔ ویرایش', () => initEditUpdate());
        safe('گراف', () => initGraphModal());

        document.querySelectorAll('.modalCloseBtn').forEach(btn => {
            btn.addEventListener('click', function () {
                closeModal(this.closest('.modal'));
            });
        });

        initPage();
    });

</script>

<!-- =========================================================
     SCRIPT 22 · پیوست‌ها + مرصاد (مستقل؛ داخل IIFE تا با اسکریپت‌های دیگر تداخل نکند)
========================================================= -->
<script>
    (function () {
        'use strict';

        var MAX_BYTES = 25 * 1024 * 1024;

        // همان فهرست ممنوعهٔ سرور (فایل‌ها داخل wwwroot نگهداری می‌شوند)
        var BLOCKED = ['.exe', '.dll', '.com', '.bat', '.cmd', '.msi', '.scr', '.ps1', '.vbs', '.sh', '.jar',
            '.js', '.mjs', '.html', '.htm', '.xhtml', '.svg', '.aspx', '.asp', '.ashx', '.cshtml', '.razor',
            '.config', '.php', '.jsp'];

        var IMAGE_EXT = ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.bmp'];

        var URLS = {
            deleteAttachment: '@Url.Action("DeleteAttachment", "Profile")',
            mersad: '@Url.Action("Mersad", "Profile")'
        };

        var IDS = {
            new: { input: 'newAttachInput', grid: 'newAttachGrid', status: 'newAttachStatus', clear: 'newAttachClear' },
            edit: { input: 'editAttachInput', grid: 'editAttachGrid', status: 'editAttachStatus', clear: 'editAttachClear' }
        };

        var state = {
            new: { files: [], urls: {} },
            edit: { files: [], urls: {} }
        };

        var currentRecord = null;

        function $(id) { return document.getElementById(id); }

        function esc(v) {
            return String(v === null || v === undefined ? '' : v).replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
        }

        function extOf(name) {
            var s = String(name || '');
            var i = s.lastIndexOf('.');
            return i >= 0 ? s.slice(i).toLowerCase() : '';
        }

        function isImageName(name, type) {
            return (type && String(type).indexOf('image/') === 0 && type !== 'image/svg+xml') || IMAGE_EXT.indexOf(extOf(name)) >= 0;
        }

        function iconFor(name) {
            var e = extOf(name);
            if (e === '.pdf') return '📕';
            if (['.doc', '.docx', '.rtf', '.odt'].indexOf(e) >= 0) return '📘';
            if (['.xls', '.xlsx', '.csv', '.ods'].indexOf(e) >= 0) return '📗';
            if (['.ppt', '.pptx'].indexOf(e) >= 0) return '📙';
            if (['.zip', '.rar', '.7z', '.tar', '.gz'].indexOf(e) >= 0) return '🗜️';
            if (['.mp3', '.wav', '.ogg', '.m4a', '.aac'].indexOf(e) >= 0) return '🎵';
            if (['.mp4', '.avi', '.mkv', '.mov', '.wmv', '.webm'].indexOf(e) >= 0) return '🎞️';
            if (['.txt', '.md', '.log'].indexOf(e) >= 0) return '📄';
            return '📎';
        }

        function fmtSize(b) {
            if (b < 1024) return b + ' B';
            if (b < 1024 * 1024) return (b / 1024).toFixed(1) + ' KB';
            return (b / 1024 / 1024).toFixed(1) + ' MB';
        }

        function fileKey(f) { return f.name + '|' + f.size + '|' + f.lastModified; }

        function token() {
            return (typeof getToken === 'function' ? getToken() : '') ||
                (document.querySelector('input[name="__RequestVerificationToken"]') || {}).value || '';
        }

        /* ---------- پیوست‌های در انتظار ذخیره (با بند انگشتی) ---------- */

        function revokeAll(scope) {
            var urls = state[scope].urls;
            Object.keys(urls).forEach(function (k) { try { URL.revokeObjectURL(urls[k]); } catch (e) { } });
            state[scope].urls = {};
        }

        function thumbUrl(scope, file) {
            var k = fileKey(file);
            if (!state[scope].urls[k]) state[scope].urls[k] = URL.createObjectURL(file);
            return state[scope].urls[k];
        }

        function render(scope) {
            var ids = IDS[scope];
            var grid = $(ids.grid);
            if (!grid) return;

            var files = state[scope].files;
            grid.innerHTML = '';

            files.forEach(function (f, i) {
                var item = document.createElement('div');
                item.className = 'attach-item is-new';

                var media = isImageName(f.name, f.type)
                    ? '<img class="attach-thumb" alt="' + esc(f.name) + '" src="' + thumbUrl(scope, f) + '">'
                    : '<div class="attach-icon">' + iconFor(f.name) + '</div>';

                item.innerHTML =
                    media +
                    '<div class="attach-name" title="' + esc(f.name) + '">' + esc(f.name) + '</div>' +
                    '<div class="attach-size">' + fmtSize(f.size) + '</div>' +
                    '<button type="button" class="attach-remove" data-index="' + i + '" title="حذف از انتخاب‌ها" aria-label="حذف">×</button>';

                grid.appendChild(item);
            });

            var total = files.reduce(function (s, f) { return s + f.size; }, 0);
            var status = $(ids.status);
            if (status) {
                status.textContent = files.length
                    ? files.length + ' فایل انتخاب شده (' + fmtSize(total) + ') — پس از «ذخیره» بارگذاری می‌شوند'
                    : 'پیوستی انتخاب نشده (هر فایل حداکثر ۲۵ مگابایت)';
            }

            var clear = $(ids.clear);
            if (clear) clear.hidden = files.length === 0;
        }

        function addFiles(scope, list) {
            var problems = [];
            var s = state[scope];
            var known = {};
            s.files.forEach(function (f) { known[fileKey(f)] = true; });

            Array.prototype.forEach.call(list || [], function (f) {
                if (!f || f.size <= 0) { problems.push(f ? f.name + ' (خالی است)' : ''); return; }
                if (f.size > MAX_BYTES) { problems.push(f.name + ' (بیشتر از ۲۵ مگابایت)'); return; }
                if (BLOCKED.indexOf(extOf(f.name)) >= 0) { problems.push(f.name + ' (نوع فایل مجاز نیست)'); return; }
                if (known[fileKey(f)]) return;
                known[fileKey(f)] = true;
                s.files.push(f);
            });

            render(scope);

            if (problems.length)
                alert('این فایل‌ها اضافه نشدند:\n' + problems.join('\n'));
        }

        function reset(scope) {
            revokeAll(scope);
            state[scope].files = [];
            var input = $(IDS[scope].input);
            if (input) input.value = '';
            render(scope);
        }

        function setup(scope) {
            var ids = IDS[scope];
            var input = $(ids.input);
            if (!input) return;

            input.addEventListener('change', function () {
                addFiles(scope, this.files);
                this.value = '';
            });

            $(ids.grid).addEventListener('click', function (e) {
                var btn = e.target.closest ? e.target.closest('.attach-remove') : null;
                if (!btn) return;
                var i = parseInt(btn.getAttribute('data-index'), 10);
                var f = state[scope].files[i];
                if (!f) return;
                var k = fileKey(f);
                if (state[scope].urls[k]) {
                    try { URL.revokeObjectURL(state[scope].urls[k]); } catch (er) { }
                    delete state[scope].urls[k];
                }
                state[scope].files.splice(i, 1);
                render(scope);
            });

            var clear = $(ids.clear);
            if (clear) clear.addEventListener('click', function () { reset(scope); });

            render(scope);
        }

        /* ---------- پیوست‌های ثبت‌شده (فقط فرم ویرایش) ---------- */

        function existingList() {
            if (!currentRecord) return [];
            var l = currentRecord.attachments || currentRecord.Attachments || [];
            return Array.isArray(l) ? l : [];
        }

        function renderExisting() {
            var box = $('editAttachExisting');
            var title = $('editAttachExistingTitle');
            if (!box) return;

            var list = existingList();
            box.innerHTML = '';

            if (title) title.textContent = list.length ? 'پیوست‌های ثبت‌شده (' + list.length + ')' : 'پیوست ثبت‌شده‌ای وجود ندارد';

            list.forEach(function (a) {
                var id = a.id !== undefined ? a.id : a.Id;
                var name = a.fileName || a.FileName || '';
                var url = a.fileUrl || a.FileUrl || '';

                var item = document.createElement('div');
                item.className = 'attach-item';

                var media = isImageName(name)
                    ? '<img class="attach-thumb" loading="lazy" alt="' + esc(name) + '" src="' + esc(encodeURI(url)) + '">'
                    : '<div class="attach-icon">' + iconFor(name) + '</div>';

                item.innerHTML =
                    '<a href="' + esc(encodeURI(url)) + '" target="_blank" rel="noopener" title="باز کردن">' +
                    media +
                    '<div class="attach-name" title="' + esc(name) + '">' + esc(name) + '</div>' +
                    '</a>' +
                    '<button type="button" class="attach-remove" data-del-id="' + esc(id) + '" title="حذف این پیوست" aria-label="حذف">🗑</button>';

                box.appendChild(item);
            });
        }

        // حذف پیوست از سرور و همهٔ حافظه‌های صفحه؛ true/false برمی‌گرداند
        async function deleteById(id) {
            var body = new FormData();
            body.append('id', String(id));
            body.append('__RequestVerificationToken', token());

            try {
                var res = await fetch(URLS.deleteAttachment, { method: 'POST', body: body, credentials: 'same-origin' });
                var data = null;
                try { data = await res.json(); } catch (e) { }

                if (!res.ok || !data || !data.success) {
                    alert((data && data.message) || 'حذف پیوست انجام نشد.');
                    return false;
                }

                var keep = function (a) { return String(a.id !== undefined ? a.id : a.Id) !== String(id); };

                (window.records || []).forEach(function (r) {
                    var l = r.attachments || r.Attachments;
                    if (Array.isArray(l) && l.some(function (a) { return !keep(a); })) r.attachments = l.filter(keep);
                });

                if (currentRecord) currentRecord.attachments = existingList().filter(keep);

                document.dispatchEvent(new CustomEvent('rasam:attachments-changed', { detail: { id: id } }));

                return true;
            }
            catch (err) {
                console.error(err);
                alert('خطا در ارتباط با سرور.');
                return false;
            }
        }

        async function deleteExisting(id) {
            if (!confirm('این پیوست برای همیشه حذف شود؟')) return;
            if (await deleteById(id)) renderExisting();
        }

        /* ---------- API برای بقیهٔ صفحه ---------- */

        window.RasamAttach = {
            deleteById: deleteById,
            reset: reset,
            setExisting: function (record) {
                currentRecord = record || null;
                reset('edit');
                renderExisting();
            },
            appendTo: function (formData, scope) {
                state[scope].files.forEach(function (f) {
                    formData.append('AttachmentsFiles', f, f.name);
                });
            }
        };

        /* ---------- انتخاب ردیف‌ها ---------- */

        function rowChecks() {
            return Array.prototype.slice.call(document.querySelectorAll('#tableBody .row-checkbox'));
        }

        function isVisibleRow(cb) {
            var tr = cb.closest('tr');
            return !!tr && !tr.hidden && tr.style.display !== 'none';
        }

        function syncSelectAll() {
            var all = $('selectAllRowsCheckbox');
            if (!all) return;
            var vis = rowChecks().filter(isVisibleRow);
            var checked = vis.filter(function (c) { return c.checked; }).length;
            all.checked = vis.length > 0 && checked === vis.length;
            all.indeterminate = checked > 0 && checked < vis.length;
        }

        document.addEventListener('change', function (e) {
            var t = e.target;
            if (!t) return;

            if (t.id === 'selectAllRowsCheckbox') {
                rowChecks().forEach(function (c) { if (isVisibleRow(c)) c.checked = t.checked; });
                t.indeterminate = false;
            }
            else if (t.classList && t.classList.contains('row-checkbox')) {
                syncSelectAll();
            }
        });

        /* ---------- مرصاد ---------- */

        function readReport(header) {
            if (!header) return null;
            try {
                var bin = atob(header);
                var bytes = Uint8Array.from(bin, function (c) { return c.charCodeAt(0); });
                return JSON.parse(new TextDecoder('utf-8').decode(bytes));
            } catch (e) { console.error(e); return null; }
        }

        function fileNameFrom(cd) {
            if (!cd) return '';
            var m = /filename\*?=(?:UTF-8'')?"?([^";]+)"?/i.exec(cd);
            if (!m) return '';
            try { return decodeURIComponent(m[1]); } catch (e) { return m[1]; }
        }

        function nameList(names, total) {
            if (!names || !names.length) return '';
            var more = total > names.length ? ' و ' + (total - names.length) + ' مورد دیگر…' : '';
            return '<div class="mersad-names">' + names.map(esc).join('، ') + esc(more) + '</div>';
        }

        function row(label, value) {
            return '<div class="mersad-row"><span>' + label + '</span><b>' + esc(value) + '</b></div>';
        }

        function showReport(r, message, ok) {
            var sub = $('mersadReportSub');
            var body = $('mersadReportBody');
            if (!body) return;

            if (sub) sub.textContent = ok ? 'فایل ZIP دانلود شد' : (message || 'فایلی ساخته نشد');

            var h = '';

            if (!ok && message) {
                h += '<div class="mersad-names mersad-names--plain">' + esc(message) + '</div>';
            }

            if (r) {
                h += row('تعداد ردیف‌های انتخاب‌شده', r.selected);
                h += row('✅ ردیف‌های دانلودشده (کد ملی + پیوست)', r.exportedProfiles);
                h += row('📁 پوشه‌های ساخته‌شده', r.folders);
                h += row('📎 تعداد فایل‌های پیوست', r.files);
                h += row('⏭️ بدون کد ملی — نادیده گرفته شد', r.skippedNoNationalCode);
                h += nameList(r.skippedNames, r.skippedNoNationalCode);

                if (r.noAttachments) {
                    h += row('⏭️ دارای کد ملی ولی بدون پیوست — نادیده گرفته شد', r.noAttachments);
                    h += nameList(r.noAttachmentNames, r.noAttachments);
                }

                if (r.missingFiles) {
                    h += row('⚠️ فایل پیوستِ پیدا‌نشده روی سرور', r.missingFiles);
                    h += nameList(r.missingNames, r.missingFiles);
                }

                if (r.notFound) h += row('❓ رکورد پیدا‌نشده (احتمالاً حذف شده)', r.notFound);
            }

            body.innerHTML = h;

            var modal = $('mersadReportModal');
            if (typeof openModal === 'function') openModal(modal);
            else if (modal) modal.classList.add('show');
        }

        function triggerDownload(blob, name) {
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = name;
            document.body.appendChild(a);
            a.click();
            a.remove();
            setTimeout(function () { URL.revokeObjectURL(url); }, 4000);
        }

        async function runMersad() {
            var btn = $('mersadBtn');

            var ids = rowChecks()
                .filter(function (c) { return c.checked; })
                .map(function (c) { return c.value; });

            if (!ids.length) {
                alert('ابتدا یک یا چند ردیف را (با تیک ستون اول) انتخاب کنید.');
                return;
            }

            var oldHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '⏳ در حال ساخت فایل...';

            try {
                var fd = new FormData();
                ids.forEach(function (id) { fd.append('ids', id); });
                fd.append('__RequestVerificationToken', token());

                var res = await fetch(URLS.mersad, { method: 'POST', body: fd, credentials: 'same-origin' });
                var ct = res.headers.get('Content-Type') || '';

                if (ct.indexOf('application/json') >= 0) {
                    var j = await res.json();
                    showReport(j.report || null, j.message, false);
                    return;
                }

                if (!res.ok) throw new Error('HTTP ' + res.status);

                var report = readReport(res.headers.get('X-Mersad-Report'));
                var blob = await res.blob();
                var name = fileNameFrom(res.headers.get('Content-Disposition')) || 'Mersad.zip';

                triggerDownload(blob, name);
                showReport(report, null, true);
            }
            catch (err) {
                console.error(err);
                alert('ساخت فایل مرصاد انجام نشد: ' + (err && err.message ? err.message : err));
            }
            finally {
                btn.disabled = false;
                btn.innerHTML = oldHtml;
            }
        }

        function boot() {
            setup('new');
            setup('edit');

            var existingBox = $('editAttachExisting');
            if (existingBox) {
                existingBox.addEventListener('click', function (e) {
                    var btn = e.target.closest ? e.target.closest('.attach-remove') : null;
                    if (!btn) return;
                    e.preventDefault();
                    deleteExisting(btn.getAttribute('data-del-id'));
                });
            }

            var btn = $('mersadBtn');
            if (btn) btn.addEventListener('click', runMersad);
        }

        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
        else boot();
    })();
</script>

<!-- =========================================================
     SCRIPT 23 · گالری پیوست‌ها (مستقل؛ داخل IIFE)
========================================================= -->
<script>
    (function () {
        'use strict';

        var IMG = ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.bmp'];
        var VIDEO = ['.mp4', '.webm', '.mov', '.m4v', '.ogv'];
        var AUDIO = ['.mp3', '.wav', '.ogg', '.m4a', '.aac'];
        var DOCS = ['.pdf', '.doc', '.docx', '.rtf', '.odt', '.txt', '.md', '.xls', '.xlsx', '.csv', '.ods', '.ppt', '.pptx'];
        var MEDIA = VIDEO.concat(AUDIO, ['.avi', '.mkv', '.wmv']);

        var KINDS = [
            { id: 'all', label: 'همه' },
            { id: 'image', label: '🖼️ تصاویر' },
            { id: 'doc', label: '📄 اسناد' },
            { id: 'media', label: '🎞️ رسانه' },
            { id: 'other', label: '📎 سایر' }
        ];

        var PREF_KEY = 'rasam-gallery-prefs';
        var prefs = { view: 'grid', size: 130, sort: 'new' };

        try {
            var saved = JSON.parse(localStorage.getItem(PREF_KEY) || '{}');
            if (saved.view === 'grid' || saved.view === 'list') prefs.view = saved.view;
            if (saved.size >= 90 && saved.size <= 240) prefs.size = saved.size;
            if (['new', 'old', 'name', 'type'].indexOf(saved.sort) >= 0) prefs.sort = saved.sort;
        } catch (e) { }

        function savePrefs() { try { localStorage.setItem(PREF_KEY, JSON.stringify(prefs)); } catch (e) { } }

        var S = { recordId: null, query: '', kind: 'all', selected: {}, list: [], lb: -1 };

        function $(id) { return document.getElementById(id); }

        function esc(v) {
            return String(v === null || v === undefined ? '' : v).replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
        }

        function extOf(n) { var s = String(n || ''), i = s.lastIndexOf('.'); return i >= 0 ? s.slice(i).toLowerCase() : ''; }

        function kindOf(ext) {
            if (IMG.indexOf(ext) >= 0) return 'image';
            if (DOCS.indexOf(ext) >= 0) return 'doc';
            if (MEDIA.indexOf(ext) >= 0) return 'media';
            return 'other';
        }

        function iconFor(ext) {
            if (ext === '.pdf') return '📕';
            if (['.doc', '.docx', '.rtf', '.odt'].indexOf(ext) >= 0) return '📘';
            if (['.xls', '.xlsx', '.csv', '.ods'].indexOf(ext) >= 0) return '📗';
            if (['.ppt', '.pptx'].indexOf(ext) >= 0) return '📙';
            if (['.zip', '.rar', '.7z', '.tar', '.gz'].indexOf(ext) >= 0) return '🗜️';
            if (AUDIO.indexOf(ext) >= 0) return '🎵';
            if (VIDEO.concat(['.avi', '.mkv', '.wmv']).indexOf(ext) >= 0) return '🎞️';
            if (['.txt', '.md', '.log'].indexOf(ext) >= 0) return '📄';
            return '📎';
        }

        function fmtDate(s) {
            if (!s) return '';
            try {
                var d = new Date(String(s).replace(' ', 'T'));
                return isNaN(d.getTime()) ? String(s).slice(0, 10) : d.toLocaleDateString('fa-IR');
            } catch (e) { return String(s).slice(0, 10); }
        }

        function recId(r) { return String(r.id !== undefined ? r.id : r.Id); }

        function getRecord() {
            return (window.records || []).filter(function (r) { return recId(r) === String(S.recordId); })[0] || null;
        }

        function attachmentsOf(r) {
            var l = r && (r.attachments || r.Attachments);
            return Array.isArray(l) ? l : [];
        }

        function normalize(a) {
            var name = a.fileName || a.FileName || '';
            var url = a.fileUrl || a.FileUrl || '';
            var ext = extOf(name) || extOf(url);
            return {
                id: String(a.id !== undefined ? a.id : a.Id),
                name: name || 'file',
                url: encodeURI(url),
                date: a.createDate || a.CreateDate || '',
                ext: ext,
                kind: kindOf(ext)
            };
        }

        /* ---------- دکمهٔ ردیف ---------- */

        function buttonHtml(record) {
            var n = attachmentsOf(record).length;
            var id = recId(record);
            return '<button type="button" class="graph-btn gallery-btn' + (n ? '' : ' is-empty') + '" data-gallery-id="' + esc(id) +
                '" title="گالری پیوست‌ها (' + n + ')" aria-label="گالری پیوست‌ها">🖼️' +
                (n ? '<span class="gallery-count">' + n + '</span>' : '') + '</button>';
        }

        function refreshBadges() {
            (window.records || []).forEach(function (r) {
                var btn = document.querySelector('tr[data-record-id="' + recId(r) + '"] .gallery-btn');
                if (!btn) return;
                var n = attachmentsOf(r).length;
                btn.classList.toggle('is-empty', !n);
                btn.title = 'گالری پیوست‌ها (' + n + ')';
                var badge = btn.querySelector('.gallery-count');
                if (n) {
                    if (!badge) { badge = document.createElement('span'); badge.className = 'gallery-count'; btn.appendChild(badge); }
                    badge.textContent = n;
                } else if (badge) badge.remove();
            });
        }

        /* ---------- لیست نمایشی (فیلتر + جستجو + مرتب‌سازی) ---------- */

        function buildList() {
            var all = attachmentsOf(getRecord()).map(normalize);
            var counts = { all: all.length, image: 0, doc: 0, media: 0, other: 0 };
            all.forEach(function (a) { counts[a.kind]++; });

            var q = S.query.trim().toLowerCase();

            var list = all.filter(function (a) {
                return (S.kind === 'all' || a.kind === S.kind) && (!q || a.name.toLowerCase().indexOf(q) >= 0);
            });

            list.sort(function (a, b) {
                if (prefs.sort === 'old') return Number(a.id) - Number(b.id);
                if (prefs.sort === 'name') return a.name.localeCompare(b.name, 'fa');
                if (prefs.sort === 'type') return (a.ext.localeCompare(b.ext)) || a.name.localeCompare(b.name, 'fa');
                return Number(b.id) - Number(a.id);
            });

            return { all: all, list: list, counts: counts };
        }

        function renderChips(counts) {
            $('galleryChips').innerHTML = KINDS.filter(function (k) { return k.id === 'all' || counts[k.id] > 0; })
                .map(function (k) {
                    return '<button type="button" class="gal-chip' + (S.kind === k.id ? ' is-active' : '') + '" data-kind="' + k.id + '">' +
                        k.label + '<b>' + counts[k.id] + '</b></button>';
                }).join('');
        }

        function cardHtml(a) {
            var thumb = a.kind === 'image'
                ? '<img loading="lazy" alt="' + esc(a.name) + '" src="' + esc(a.url) + '" onerror="this.replaceWith(Object.assign(document.createElement(\'span\'),{className:\'gal-ficon\',textContent:\'🖼️\'}))">'
                : '<span class="gal-ficon">' + iconFor(a.ext) + '<em>' + esc((a.ext || '').replace('.', '').toUpperCase()) + '</em></span>';

            var sub = [(a.ext || '').replace('.', '').toUpperCase(), fmtDate(a.date)].filter(Boolean).join(' • ');

            return '<div class="gal-card' + (S.selected[a.id] ? ' is-selected' : '') + '" data-id="' + esc(a.id) + '">' +
                '<label class="gal-check" title="انتخاب"><input type="checkbox" class="gal-sel"' + (S.selected[a.id] ? ' checked' : '') + '></label>' +
                '<button type="button" class="gal-thumb" data-act="view" title="پیش‌نمایش">' + thumb + '</button>' +
                '<div class="gal-meta"><div class="gal-name" title="' + esc(a.name) + '">' + esc(a.name) + '</div>' +
                '<div class="gal-sub">' + esc(sub) + '</div></div>' +
                '<div class="gal-actions">' +
                '<button type="button" data-act="view" title="پیش‌نمایش">👁</button>' +
                '<a href="' + esc(a.url) + '" download="' + esc(a.name) + '" title="دانلود">⬇</a>' +
                '<button type="button" class="gal-del" data-act="delete" title="حذف">🗑</button>' +
                '</div></div>';
        }

        function render() {
            var rec = getRecord();
            if (!rec) return;

            var built = buildList();
            S.list = built.list;

            // انتخاب‌های حذف‌شده پاک شوند
            var existing = {};
            built.all.forEach(function (a) { existing[a.id] = true; });
            Object.keys(S.selected).forEach(function (k) { if (!existing[k]) delete S.selected[k]; });

            var name = [rec.firstName || rec.FirstName, rec.lastName || rec.LastName].filter(Boolean).join(' ');
            $('galleryTitle').textContent = '🖼️ پیوست‌های ' + (rec.usernameId || rec.UsernameId || '') + (name ? ' — ' + name : '');
            $('gallerySub').textContent = built.all.length
                ? built.all.length + ' پیوست' + (built.list.length !== built.all.length ? ' (' + built.list.length + ' مورد مطابق فیلتر)' : '')
                : 'پیوستی ثبت نشده است';

            renderChips(built.counts);

            var grid = $('galleryGrid');
            grid.className = 'gal-grid' + (prefs.view === 'list' ? ' gal-list' : '');
            grid.style.setProperty('--gal-size', prefs.size + 'px');
            grid.innerHTML = built.list.map(cardHtml).join('');

            var empty = $('galleryEmpty');
            if (!built.all.length) {
                empty.innerHTML = '<div class="gal-empty-icon">📭</div><div>این رکورد پیوستی ندارد.</div><div class="gal-empty-hint">برای افزودن، «ویرایش رکورد / افزودن پیوست» را بزنید.</div>';
                empty.hidden = false;
            } else if (!built.list.length) {
                empty.innerHTML = '<div class="gal-empty-icon">🔎</div><div>موردی مطابق جستجو/فیلتر پیدا نشد.</div><button type="button" class="btn btn-secondary gal-empty-action" id="galleryResetFilters">پاک کردن فیلترها</button>';
                empty.hidden = false;
            } else empty.hidden = true;

            document.querySelectorAll('#galleryViewToggle button').forEach(function (b) {
                b.classList.toggle('is-active', b.getAttribute('data-view') === prefs.view);
            });
            $('gallerySizeWrap').hidden = prefs.view === 'list';
            $('gallerySort').value = prefs.sort;
            $('gallerySize').value = prefs.size;

            updateSelBar();
        }

        function selectedIds() { return Object.keys(S.selected).filter(function (k) { return S.selected[k]; }); }

        function updateSelBar() {
            var n = selectedIds().length;
            $('gallerySelBar').hidden = n === 0;
            $('gallerySelCount').textContent = n + ' پیوست انتخاب شده';
        }

        /* ---------- باز و بسته کردن ---------- */

        function open(recordId) {
            S.recordId = recordId;
            S.query = '';
            S.kind = 'all';
            S.selected = {};
            $('gallerySearch').value = '';
            closeLightbox();
            render();
            var modal = $('galleryModal');
            if (typeof openModal === 'function') openModal(modal); else modal.classList.add('show');
        }

        /* ---------- پیش‌نمایش تمام‌صفحه ---------- */

        function openLightbox(i) {
            if (i < 0 || i >= S.list.length) return;
            S.lb = i;
            var a = S.list[i];
            var box = $('galleryLb' + 'Content');
            var stage = $('galleryLbStage');
            stage.classList.remove('is-zoom');

            var html;
            if (a.kind === 'image') html = '<img alt="' + esc(a.name) + '" src="' + esc(a.url) + '">';
            else if (a.ext === '.pdf') html = '<iframe title="' + esc(a.name) + '" src="' + esc(a.url) + '" class="gal-lb-frame"></iframe>';
            else if (VIDEO.indexOf(a.ext) >= 0) html = '<video controls autoplay src="' + esc(a.url) + '"></video>';
            else if (AUDIO.indexOf(a.ext) >= 0) html = '<audio controls autoplay src="' + esc(a.url) + '"></audio>';
            else html = '<div class="gal-lb-fallback"><div class="gal-lb-icon">' + iconFor(a.ext) + '</div><div class="gal-lb-fallback-name">' + esc(a.name) +
                '</div><div class="gal-lb-fallback-hint">پیش‌نمایش این نوع فایل ممکن نیست؛ از «دانلود» یا «باز کردن» استفاده کنید.</div></div>';

            box.innerHTML = html;

            $('galleryLbTitle').textContent = a.name;
            $('galleryLbCount').textContent = (i + 1) + ' / ' + S.list.length;
            var dl = $('galleryLbDownload'); dl.href = a.url; dl.setAttribute('download', a.name);
            $('galleryLbOpen').href = a.url;
            $('galleryLbPrev').hidden = $('galleryLbNext').hidden = S.list.length <= 1;
            $('galleryLightbox').hidden = false;

            // پیش‌بارگذاری همسایه‌ها
            [i - 1, i + 1].forEach(function (j) {
                var n = S.list[j];
                if (n && n.kind === 'image') { var im = new Image(); im.src = n.url; }
            });
        }

        function closeLightbox() {
            S.lb = -1;
            var lb = $('galleryLightbox');
            if (lb) lb.hidden = true;
            var c = $('galleryLbContent');
            if (c) c.innerHTML = '';
        }

        function step(d) {
            if (S.lb < 0 || !S.list.length) return;
            openLightbox((S.lb + d + S.list.length) % S.list.length);
        }

        /* ---------- عملیات ---------- */

        async function removeOne(id) {
            var api = window.RasamAttach;
            if (!api || !api.deleteById) { alert('امکان حذف در دسترس نیست.'); return false; }
            return await api.deleteById(id);
        }

        function downloadMany(items) {
            items.forEach(function (a, i) {
                setTimeout(function () {
                    var el = document.createElement('a');
                    el.href = a.url; el.download = a.name;
                    document.body.appendChild(el); el.click(); el.remove();
                }, i * 350);
            });
        }

        function byIds(ids) {
            var all = attachmentsOf(getRecord()).map(normalize);
            return all.filter(function (a) { return ids.indexOf(a.id) >= 0; });
        }

        /* ---------- رویدادها ---------- */

        function bind() {
            var modal = $('galleryModal');
            if (!modal) return;

            document.addEventListener('click', function (e) {
                var btn = e.target.closest ? e.target.closest('[data-gallery-id]') : null;
                if (btn) { e.preventDefault(); open(btn.getAttribute('data-gallery-id')); }
            });

            $('gallerySearch').addEventListener('input', function () { S.query = this.value; render(); });

            $('gallerySort').addEventListener('change', function () { prefs.sort = this.value; savePrefs(); render(); });

            $('gallerySize').addEventListener('input', function () {
                prefs.size = parseInt(this.value, 10) || 130; savePrefs();
                $('galleryGrid').style.setProperty('--gal-size', prefs.size + 'px');
            });

            $('galleryViewToggle').addEventListener('click', function (e) {
                var b = e.target.closest('button[data-view]');
                if (!b) return;
                prefs.view = b.getAttribute('data-view'); savePrefs(); render();
            });

            $('galleryChips').addEventListener('click', function (e) {
                var b = e.target.closest('.gal-chip');
                if (!b) return;
                S.kind = b.getAttribute('data-kind'); render();
            });

            $('galleryEmpty').addEventListener('click', function (e) {
                if (e.target.id === 'galleryResetFilters') { S.query = ''; S.kind = 'all'; $('gallerySearch').value = ''; render(); }
            });

            $('galleryGrid').addEventListener('change', function (e) {
                if (!e.target.classList.contains('gal-sel')) return;
                var card = e.target.closest('.gal-card');
                S.selected[card.getAttribute('data-id')] = e.target.checked;
                card.classList.toggle('is-selected', e.target.checked);
                updateSelBar();
            });

            $('galleryGrid').addEventListener('click', async function (e) {
                var act = e.target.closest('[data-act]');
                if (!act) return;
                var card = act.closest('.gal-card');
                var id = card.getAttribute('data-id');

                if (act.getAttribute('data-act') === 'view') {
                    var i = S.list.map(function (a) { return a.id; }).indexOf(id);
                    openLightbox(i);
                } else if (act.getAttribute('data-act') === 'delete') {
                    var item = byIds([id])[0];
                    if (!confirm('پیوست «' + (item ? item.name : '') + '» برای همیشه حذف شود؟')) return;
                    await removeOne(id);
                }
            });

            $('gallerySelAll').addEventListener('click', function () {
                S.list.forEach(function (a) { S.selected[a.id] = true; }); render();
            });
            $('gallerySelClear').addEventListener('click', function () { S.selected = {}; render(); });
            $('gallerySelDownload').addEventListener('click', function () { downloadMany(byIds(selectedIds())); });
            $('gallerySelDelete').addEventListener('click', async function () {
                var ids = selectedIds();
                if (!ids.length) return;
                if (!confirm(ids.length + ' پیوست برای همیشه حذف شود؟')) return;
                var failed = 0;
                for (var i = 0; i < ids.length; i++) { if (!(await removeOne(ids[i]))) failed++; }
                if (failed) alert(failed + ' پیوست حذف نشد.');
            });

            $('galleryEditBtn').addEventListener('click', function () {
                var id = S.recordId;
                if (typeof closeModal === 'function') closeModal(modal); else modal.classList.remove('show');
                var btn = document.querySelector('[data-edit-id="' + id + '"]');
                if (btn) btn.click();
            });

            // پیش‌نمایش
            $('galleryLbClose').addEventListener('click', closeLightbox);
            $('galleryLbPrev').addEventListener('click', function () { step(-1); });
            $('galleryLbNext').addEventListener('click', function () { step(1); });
            $('galleryLbStage').addEventListener('click', function (e) {
                if (e.target.tagName === 'IMG') this.classList.toggle('is-zoom');
                else if (e.target === this) closeLightbox();
            });

            // کیبورد (فاز capture تا Esc مودال زیرین را نبندد). صفحه راست‌به‌چپ است: ← بعدی، → قبلی
            window.addEventListener('keydown', function (e) {
                if ($('galleryLightbox').hidden) return;
                if (e.key === 'Escape') { e.stopPropagation(); e.preventDefault(); closeLightbox(); }
                else if (e.key === 'ArrowLeft') { e.preventDefault(); step(1); }
                else if (e.key === 'ArrowRight') { e.preventDefault(); step(-1); }
            }, true);

            // اگر پیوستی (از فرم ویرایش یا همین گالری) حذف شد
            document.addEventListener('rasam:attachments-changed', function () {
                refreshBadges();
                if (modal.classList.contains('show')) {
                    render();
                    if (S.lb >= 0) { if (S.list.length) openLightbox(Math.min(S.lb, S.list.length - 1)); else closeLightbox(); }
                }
            });
        }

        window.RasamGallery = { buttonHtml: buttonHtml, open: open, refreshBadges: refreshBadges };

        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind);
        else bind();
    })();
</script>

