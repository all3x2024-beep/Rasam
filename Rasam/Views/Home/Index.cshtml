<script>

    'use strict';

    /* =========================================================
       افزودن رکورد (مودال + ثبت)
    ========================================================= */



    /* راه‌اندازی رویدادها — از bootstrap صدا زده می‌شود */
    function initAddRecord() {

    document.getElementById(
            'addRecordBtn'
        )?.addEventListener(
            'click',
            function () {

                const form =
                    document.getElementById(
                        'addRecordForm'
                    );


                form?.reset();

                // reset رویداد change نمی‌فرستد؛ چیپ‌های تگ باید دستی به‌روز شوند
                form?.querySelectorAll('.smart-multi-select')
                    .forEach(refreshSmartMultiSelect);


                setSocialDraft('new', []);


                document.getElementById(
                    'newRelationRows'
                ).innerHTML = `

                        <div class="relation-empty">
                            هنوز رابطه‌ای اضافه نشده است.
                        </div>

                    `;


                resetImageStage('new', '');

                window.RasamAttach?.reset('new');


                openModal(
                    document.getElementById(
                        'addRecordModal'
                    )
                );

                ensureMetaLoaded()
                    .then(() => refreshRelationSelects('newRelationRows', null));

            }
        );

        /* =========================================================
           CREATE
        ========================================================= */

        document.getElementById(
            'addRecordForm'
        )?.addEventListener(
            'submit',
            async function (event) {

                event.preventDefault();


                const form =
                    this;


                const topic =
                    document.getElementById(
                        'newRecordTopic'
                    );


                if (!topic.value) {

                    alert(
                        'لطفاً موضوع را انتخاب کنید.'
                    );

                    return;
                }


                const nationalCode =
                    document.getElementById(
                        'newRecordNationalId'
                    )
                    ?.value
                    .trim();


                if (
                    nationalCode &&
                    !/^\d{10}$/.test(
                        nationalCode
                    )
                ) {

                    alert(
                        'کد ملی باید دقیقاً ۱۰ رقم باشد.'
                    );

                    return;
                }


                if (!validateRelationRows('newRelationRows'))
                    return;


                const formData =
                    new FormData(form);

                window.RasamAttach?.appendTo(formData, 'new');


                formData.delete('TagIds');


                getMultiSelectValues(
                    document.getElementById(
                        'newRecordTag'
                    )
                )
                .forEach(id =>
                    formData.append(
                        'TagIds',
                        id
                    )
                );



                const button =
                    document.getElementById(
                        'saveNewRecordBtn'
                    );


                button.disabled = true;


                try {

                    formData.delete('SocialMediaIds');

                    (await resolveSocialIds('new'))
                        .forEach(id =>
                            formData.append(
                                'SocialMediaIds',
                                id
                            )
                        );


                    const response =
                        await fetch(
                            '@Url.Action("Create", "Profile")',
                            {
                                method: 'POST',
                                body: formData,
                                headers: {
                                    'Accept':
                                        'application/json'
                                }
                            }
                        );


                    const result =
                        await response.json();


                    if (
                        !response.ok ||
                        !result.success
                    ) {

                        alert(
                            result.message ||
                            'ذخیره انجام نشد.'
                        );

                        return;
                    }


                    const relFailed = await saveRelations(result.id, 'newRelationRows');


                    closeModal(
                        document.getElementById(
                            'addRecordModal'
                        )
                    );


                    await loadRecords();


                    alert(
                        (result.message || 'رکورد با موفقیت ذخیره شد.') +
                        (relFailed ? '\nاما ' + relFailed + ' رابطه ذخیره نشد.' : '')
                    );

                }
                catch (error) {

                    console.error(error);

                    alert(
                        (error && error.message) ||
                        'خطا در ارتباط با سرور.'
                    );

                }
                finally {

                    button.disabled = false;

                }

            }
        );

    }

</script>

<!-- =========================================================
     SCRIPT 10 · باز کردن ویرایش
