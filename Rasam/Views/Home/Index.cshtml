<script>

    'use strict';

    /* =========================================================
       GRAPH · 1/4 — وضعیت، نمای دوربین، فیزیک و رسم
       - عنوان هر نود = مقدار UsernameId (شناسه رکورد)
       - بقیه بخش‌های گراف: graph-data / graph-features / graph-ui
    ========================================================= */

    const GRAPH_R = 18;                 // شعاع پایهٔ گره
    const GRAPH_R_MAX = 34;             // سقف شعاع وقتی «اندازه بر اساس روابط» روشن است
    const SVG_NS = 'http://www.w3.org/2000/svg';

    const GRAPH_PALETTE = [
        '#2563eb', '#7c3aed', '#0f766e', '#d97706', '#dc2626',
        '#0891b2', '#16a34a', '#be123c', '#9333ea', '#ca8a04'
    ];

    const G = {
        ready: false,
        svg: null, defs: null, edgeLayer: null, nodeLayer: null, layer: null, msg: null,

        allNodes: new Map(),      // id -> { id, label, rec, topic, search }
        allEdges: [],             // { from, to, type }
        degree: new Map(),        // id -> درجهٔ کل (روی همهٔ روابط)

        nodes: [], edges: [], nodeMap: new Map(),
        pos: new Map(),

        focusId: null, selectedId: null,
        pathFrom: null,           // مبدأ مسیر (در انتظار انتخاب مقصد)
        path: null,               // { ids, nodes:Set, edges:Set }
        hiddenTypes: new Set(),   // نوع‌های رابطه‌ای که از راهنما پنهان شده‌اند

        typeColors: new Map(),    // نوع رابطه -> رنگ
        topicColors: new Map(),   // موضوع -> رنگ
        layoutMode: 'force',

        tx: 0, ty: 0, k: 1, w: 800, h: 600,
        alpha: 0, raf: 0, paused: false,
        drag: null, token: 0
    };

    const graphFa = (a, b) => String(a).localeCompare(String(b), 'fa');

    function svgEl(tag, attrs) {
        const el = document.createElementNS(SVG_NS, tag);
        if (attrs) Object.keys(attrs).forEach(k => el.setAttribute(k, attrs[k]));
        return el;
    }

    function graphRecordLabel(r) {
        const username = String(getValue(r, 'usernameId', 'UsernameId') || '').trim();
        if (username) return username;

        const full = (String(getValue(r, 'firstName', 'FirstName') || '') + ' ' +
                      String(getValue(r, 'lastName', 'LastName') || '')).trim();

        return full || ('رکورد ' + getValue(r, 'id', 'Id'));
    }

    /* مقدار گزینه‌ها مستقیم از کنترل‌های نوار ابزار خوانده می‌شود */
    function graphOpts() {

        const el = id => document.getElementById(id);
        const on = (id, def) => { const c = el(id); return c ? c.checked : def; };

        return {
            layout: el('graphLayoutSelect')?.value || 'force',
            minDeg: parseInt(el('graphMinDegree')?.value || '0', 10) || 0,
            depth: parseInt(el('graphDepthSelect')?.value || '1', 10) || 1,
            nodeLabels: on('graphOptNodeLabels', true),
            edgeLabels: on('graphOptEdgeLabels', true),
            arrows: on('graphOptArrows', true),
            sizeByDegree: on('graphOptSizeDegree', true),
            colorEdges: on('graphOptColorEdges', true),
            colorNodes: on('graphOptColorNodes', false),
            neighbors: on('graphOptNeighbors', true)
        };
    }

    function graphMessage(text) {
        if (!G.msg || !G.svg) return;
        if (text) {
            G.msg.textContent = text;
            G.msg.hidden = false;
            G.svg.classList.add('graph-svg-hidden');
        }
        else {
            G.msg.hidden = true;
            G.svg.classList.remove('graph-svg-hidden');
        }
    }

    function graphViewportSize() {
        const vp = document.getElementById('graphViewport');
        G.w = (vp && vp.clientWidth) || 800;
        G.h = (vp && vp.clientHeight) || 600;
    }

    /* ---------- View transform ---------- */

    function graphApplyTransform() {
        G.layer.setAttribute('transform', 'translate(' + G.tx + ' ' + G.ty + ') scale(' + G.k + ')');
    }

    function graphToWorld(cx, cy) {
        const rect = G.svg.getBoundingClientRect();
        return { x: (cx - rect.left - G.tx) / G.k, y: (cy - rect.top - G.ty) / G.k };
    }

    function graphZoomAt(factor, cx, cy) {
        const rect = G.svg.getBoundingClientRect();
        const px = cx - rect.left, py = cy - rect.top;
        const nk = Math.min(4, Math.max(0.1, G.k * factor));
        const r = nk / G.k;
        G.tx = px - (px - G.tx) * r;
        G.ty = py - (py - G.ty) * r;
        G.k = nk;
        graphApplyTransform();
    }

    function graphFit() {
        if (!G.nodes.length) return;
        graphViewportSize();

        let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
        G.nodes.forEach(n => {
            minX = Math.min(minX, n.x - n.r); maxX = Math.max(maxX, n.x + n.r);
            minY = Math.min(minY, n.y - n.r); maxY = Math.max(maxY, n.y + n.r);
        });

        const pad = 70;
        const bw = Math.max(maxX - minX, 1) + pad * 2;
        const bh = Math.max(maxY - minY, 1) + pad * 2;

        G.k = Math.max(0.15, Math.min(G.w / bw, G.h / bh, 1.5));
        G.tx = G.w / 2 - ((minX + maxX) / 2) * G.k;
        G.ty = G.h / 2 - ((minY + maxY) / 2) * G.k;

        graphApplyTransform();
    }

    function graphCenterOn(n) {
        graphViewportSize();
        G.tx = G.w / 2 - n.x * G.k;
        G.ty = G.h / 2 - n.y * G.k;
        graphApplyTransform();
    }

    /* ---------- Physics (فقط در چیدمان «فیزیکی») ---------- */

    function graphTick(alpha) {

        const nodes = G.nodes, n = nodes.length;

        for (let i = 0; i < n; i++) {
            const a = nodes[i];
            for (let j = i + 1; j < n; j++) {
                const b = nodes[j];
                let dx = b.x - a.x, dy = b.y - a.y;
                let d2 = dx * dx + dy * dy;

                if (d2 < 1) { dx = Math.random() - .5; dy = Math.random() - .5; d2 = 1; }
                if (d2 > 160000) continue;

                const d = Math.sqrt(d2);
                const f = Math.min(8, 7000 / d2);
                const fx = dx / d * f, fy = dy / d * f;

                a.vx -= fx; a.vy -= fy;
                b.vx += fx; b.vy += fy;
            }
        }

        G.edges.forEach(e => {
            const a = e.a, b = e.b;
            const dx = b.x - a.x, dy = b.y - a.y;
            const d = Math.hypot(dx, dy) || 1;
            const f = (d - 150) * 0.03;
            const fx = dx / d * f, fy = dy / d * f;

            a.vx += fx; a.vy += fy;
            b.vx -= fx; b.vy -= fy;
        });

        const step = 0.35 + 0.65 * alpha;

        nodes.forEach(nd => {
            if (nd.fixed) { nd.vx = nd.vy = 0; return; }

            nd.vx -= nd.x * 0.006;
            nd.vy -= nd.y * 0.006;

            nd.vx = Math.max(-30, Math.min(30, nd.vx * 0.78));
            nd.vy = Math.max(-30, Math.min(30, nd.vy * 0.78));

            nd.x += nd.vx * step;
            nd.y += nd.vy * step;
        });
    }

    function graphStop() {
        if (G.raf) cancelAnimationFrame(G.raf);
        G.raf = 0;
    }

    function graphStart() {
        if (G.paused || G.raf || G.layoutMode !== 'force') return;

        const frame = () => {
            G.raf = 0;
            if (G.paused || G.layoutMode !== 'force' || !G.nodes.length) return;

            graphTick(G.alpha);
            G.alpha *= 0.985;
            graphDraw();

            if (G.alpha > 0.02) G.raf = requestAnimationFrame(frame);
        };

        G.raf = requestAnimationFrame(frame);
    }

    function graphReheat(alpha) {
        G.alpha = Math.max(G.alpha, alpha);
        graphStart();
    }

    /* ---------- Drawing ---------- */

    function graphEdgeGeom(e) {

        const a = e.a, b = e.b;
        const dx = b.x - a.x, dy = b.y - a.y;
        const d = Math.hypot(dx, dy) || 1;
        const ux = dx / d, uy = dy / d;

        const cx = (a.x + b.x) / 2 - uy * e.off;
        const cy = (a.y + b.y) / 2 + ux * e.off;

        let v1x = cx - a.x, v1y = cy - a.y;
        const l1 = Math.hypot(v1x, v1y) || 1;
        v1x /= l1; v1y /= l1;

        let v2x = cx - b.x, v2y = cy - b.y;
        const l2 = Math.hypot(v2x, v2y) || 1;
        v2x /= l2; v2y /= l2;

        const sx = a.x + v1x * a.r, sy = a.y + v1y * a.r;
        const ex = b.x + v2x * (b.r + 3), ey = b.y + v2y * (b.r + 3);

        return {
            d: 'M' + sx.toFixed(1) + ',' + sy.toFixed(1) +
               ' Q' + cx.toFixed(1) + ',' + cy.toFixed(1) +
               ' ' + ex.toFixed(1) + ',' + ey.toFixed(1),
            tx: 0.25 * sx + 0.5 * cx + 0.25 * ex,
            ty: 0.25 * sy + 0.5 * cy + 0.25 * ey - 4
        };
    }

    function graphDraw() {

        G.nodes.forEach(n => {
            n.g.setAttribute('transform', 'translate(' + n.x.toFixed(1) + ',' + n.y.toFixed(1) + ')');
        });

        G.edges.forEach(e => {
            const geo = graphEdgeGeom(e);
            e.path.setAttribute('d', geo.d);
            e.text.setAttribute('x', geo.tx.toFixed(1));
            e.text.setAttribute('y', geo.ty.toFixed(1));
        });
    }

    function graphApplyClasses() {

        const sel = G.selectedId;
        const q = (document.getElementById('graphSearchInput')?.value || '').trim().toLocaleLowerCase('fa');
        const opts = graphOpts();
        const path = G.path;

        const near = new Set();
        if (sel && opts.neighbors) {
            near.add(sel);
            G.edges.forEach(e => {
                if (e.from === sel) near.add(e.to);
                else if (e.to === sel) near.add(e.from);
            });
        }

        G.nodes.forEach(n => {
            n.g.classList.toggle('is-focus', n.id === G.focusId);
            n.g.classList.toggle('is-selected', n.id === sel);
            n.g.classList.toggle('is-dim', !!q && !n.search.includes(q));
            n.g.classList.toggle('is-neighbor', near.has(n.id));
            n.g.classList.toggle('is-path', !!path && path.nodes.has(n.id));
            n.g.classList.toggle('is-path-start', n.id === G.pathFrom);
        });

        G.edges.forEach(e => {
            e.path.classList.toggle('is-active', !!sel && (e.from === sel || e.to === sel));
            e.path.classList.toggle('is-path', !!path && path.edges.has(e));
        });

        const vp = document.getElementById('graphViewport');
        if (vp) {
            vp.classList.toggle('has-selection', !!sel && opts.neighbors);
            vp.classList.toggle('has-path', !!path);
        }
    }

</script>

