<script>

    'use strict';

    /* =========================================================
       بارگذاری رکوردها و روابط
    ========================================================= */

    async function loadRecords() {

        const response =
            await fetch(
                '@Url.Action("GetProfiles", "Profile")',
                {
                    cache: 'no-store'
                }
            );


        if (!response.ok)
            throw new Error(
                'خطا در دریافت رکوردها'
            );


        window.records =
            (await response.json()) || [];

        graphRelCache = null;


        // نام تصویر پروفایل (کد ملی/username) هنگام جایگزینی ثابت می‌ماند؛
        // پارامتر نسخه جلوی نمایش تصویر قدیمیِ کش‌شدهٔ مرورگر را می‌گیرد
        const imageVersion = Date.now();

        window.records.forEach(r => {

            if (r.image && typeof r.image === 'string' && r.image.indexOf('?') < 0)
                r.image = r.image + '?v=' + imageVersion;

            if (!Array.isArray(r.attachments))
                r.attachments = Array.isArray(r.Attachments) ? r.Attachments : [];

            if (!r.socialMedia && r.SocialMedia)
                r.socialMedia = r.SocialMedia;

            if (!r.relations && r.Relation)
                r.relations = r.Relation;

            // تگ‌ها: نام‌های ممکن tags / Tags / tag / Tag و فرمت $values
            if (!Array.isArray(r.tags)) {
                const t = r.tags || r.Tags || r.tag || r.Tag || [];
                r.tags = Array.isArray(t) ? t : (t.$values || t.values || []);
            }

        });

        rebuildTableSearchIndex();

        renderTable();
        syncEmptyState();
        updateStats();

        await hydrateRelations();

    }

    /* =========================================================
       HYDRATE RELATIONS
    ========================================================= */

    async function hydrateRelations() {

        const records = window.records || [];

        const pending = records.filter(r =>
            !Array.isArray(r.relations) ||
            !r.relations.length
        );

        if (!pending.length) return;

        const typeById = new Map(
            (window.relations || []).map(x => [
                String(getValue(x, 'id', 'Id')),
                getValue(x, 'type', 'Type')
            ])
        );

        const usernameById = new Map(
            records.map(x => [
                String(getValue(x, 'id', 'Id')),
                getValue(x, 'usernameId', 'UsernameId')
            ])
        );

        let changed = false;

        await Promise.all(pending.map(async r => {

            try {

                const id = getValue(r, 'id', 'Id');

                const res = await fetch(
                    '@Url.Action("GetProfileRelations", "Profile")?profileId=' +
                    encodeURIComponent(id),
                    { cache: 'no-store' }
                );

                if (!res.ok) return;

                const data = await res.json();

                if (!data || !data.length) return;

                r.relations = data.map(x => ({

                    type:
                        getValue(x, 'type', 'Type') ||
                        typeById.get(String(getValue(x, 'relationId', 'RelationId'))) ||
                        '',

                    toUsernameId:
                        getValue(x, 'toUsernameId', 'ToUsernameId') ||
                        usernameById.get(String(getValue(x, 'toProfileId', 'ToProfileId'))) ||
                        ''

                }));

                changed = true;

            }
            catch (error) {
                console.error('Table relations:', error);
            }

        }));

        if (changed) {
            rebuildTableSearchIndex();
            renderTable();
        }
    }

</script>

<!-- =========================================================
     SCRIPT 14 · جست‌وجوی جدول
========================================================= -->
<script>

    'use strict';

    /* =========================================================
       جست‌وجوی جدول
    ========================================================= */

    let tableSearchFrame = 0;
    let tableSearchWasActive = false;
    const tableSearchIndex = new Map();

    const SEARCH_SKIP_KEYS = new Set([
        'image', 'Image',
        'myFile', 'MyFile'
    ]);

    function normalizeSearchText(value) {

        if (value === null || value === undefined) return '';

        return String(value)
            .normalize('NFKC')
            .replace(/[يى]/g, 'ی')
            .replace(/ك/g, 'ک')
            .replace(/[ۀة]/g, 'ه')
            .replace(/[\u200c\u200d\u200e\u200f]/g, '')
            .replace(/[٠-٩۰-۹]/g, ch => {
                const code = ch.charCodeAt(0);

                if (code >= 0x0660 && code <= 0x0669) {
                    return String(code - 0x0660);
                }

                if (code >= 0x06F0 && code <= 0x06F9) {
                    return String(code - 0x06F0);
                }

                return ch;
            })
            .toLocaleLowerCase('fa')
            .replace(/\s+/g, ' ')
            .trim();
    }

    function collectSearchValues(value, parts, seen, depth) {

        if (value === null || value === undefined) return;

        if (
            typeof value === 'string' ||
            typeof value === 'number' ||
            typeof value === 'boolean'
        ) {
            const text = normalizeSearchText(value);

            // URL/محتوای تصویر برای جستجو کاربردی نیست و می‌تواند حجیم باشد.
            if (text && !/^data:image\//i.test(text)) {
                parts.push(text);
            }

            return;
        }

        if (depth > 8 || typeof value !== 'object') return;

        if (seen.has(value)) return;
        seen.add(value);

        if (Array.isArray(value)) {
            for (const item of value) {
                collectSearchValues(
                    item,
                    parts,
                    seen,
                    depth + 1
                );
            }

            return;
        }

        for (const [key, child] of Object.entries(value)) {

            if (SEARCH_SKIP_KEYS.has(key)) continue;

            collectSearchValues(
                child,
                parts,
                seen,
                depth + 1
            );
        }
    }

    function buildRecordSearchInfo(record) {

        const parts = [];

        collectSearchValues(
            record,
            parts,
            new WeakSet(),
            0
        );

        const text = parts.join(' ');

        return {
            text,
            compact: text.replace(/\s+/g, '')
        };
    }

    function rebuildTableSearchIndex() {

        tableSearchIndex.clear();

        for (const record of (window.records || [])) {

            const id = getValue(
                record,
                'id',
                'Id'
            );

            if (
                id === '' ||
                id === null ||
                id === undefined
            ) {
                continue;
            }

            tableSearchIndex.set(
                String(id),
                buildRecordSearchInfo(record)
            );
        }
    }

    function applyTableSearch(rawValue) {

        const body =
            document.getElementById('tableBody');

        const input =
            document.getElementById('searchInput');

        if (!body) return;

        const query =
            normalizeSearchText(
                rawValue !== undefined
                    ? rawValue
                    : (input?.value || '')
            );

        const rows =
            body.querySelectorAll(
                'tr[data-record-row="1"]'
            );

        // وقتی جستجو فعال نیست و قبلاً هم فعال نبوده، هیچ عملیات DOM انجام نده.
        if (!query && !tableSearchWasActive) {
            return;
        }

        let visibleCount = 0;

        if (!query) {

            rows.forEach(row => {
                if (row.hidden) row.hidden = false;
            });

            tableSearchWasActive = false;

        }
        else {

            const compactQuery =
                query.replace(/\s+/g, '');

            rows.forEach(row => {

                const id =
                    row.dataset.recordId;

                let info =
                    tableSearchIndex.get(id);

                // اگر هنوز GetProfiles تمام نشده، ستون‌های قابل مشاهده را جستجو کن.
                if (!info) {

                    const fallback =
                        normalizeSearchText(
                            row.textContent || ''
                        );

                    info = {
                        text: fallback,
                        compact: fallback.replace(/\s+/g, '')
                    };
                }

                const matched =
                    info.text.includes(query) ||
                    info.compact.includes(compactQuery);

                if (row.hidden !== !matched) {
                    row.hidden = !matched;
                }

                if (matched) visibleCount++;
            });

            tableSearchWasActive = true;
        }

        const emptyState =
            document.getElementById('emptyState');

        if (!emptyState) return;

        const hasRecords =
            Array.isArray(window.records) &&
            window.records.length > 0;

        const emptyTitle =
            document.getElementById('emptyTitle');

        const emptyText =
            document.getElementById('emptyText');

        if (
            hasRecords &&
            query &&
            visibleCount === 0
        ) {

            emptyState.hidden = false;

            if (emptyTitle) {
                emptyTitle.textContent =
                    'نتیجه‌ای برای جستجو پیدا نشد';
            }

            if (emptyText) {
                emptyText.textContent =
                    'عبارت جستجو را تغییر دهید و دوباره امتحان کنید.';
            }

        }
        else {

            emptyState.hidden = hasRecords;

            if (emptyTitle) {
                emptyTitle.textContent =
                    'هنوز رکوردی ثبت نشده است';
            }

            if (emptyText) {
                emptyText.textContent =
                    'برای شروع، روی «افزودن رکورد» کلیک کنید.';
            }
        }
    }

    function initTableSearch() {

        const input =
            document.getElementById('searchInput');

        if (!input) return;

        input.addEventListener(
            'input',
            function () {

                if (tableSearchFrame) {
                    cancelAnimationFrame(tableSearchFrame);
                }

                const value = this.value;

                tableSearchFrame =
                    requestAnimationFrame(() => {

                        tableSearchFrame = 0;

                        applyTableSearch(value);
                    });
            }
        );
    }

</script>

