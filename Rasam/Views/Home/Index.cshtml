                    const result =
                        await response.json();


                    if (
                        !response.ok ||
                        !result.success
                    ) {

                        alert(
                            result.message ||
                            'ذخیره تغییرات انجام نشد.'
                        );

                        return;
                    }


                    let relFailed = 0;

                    // اگر روابط فعلی خوانده نشده باشند، حذف و ثبت مجدد انجام نمی‌شود تا روابط قبلی از بین نروند
                    if (editRelationsReady) {

                        const delRelResponse = await fetch(
                            '@Url.Action("DeleteProfileRelations", "Profile")?profileId=' +
                            encodeURIComponent(currentEditRecordId),
