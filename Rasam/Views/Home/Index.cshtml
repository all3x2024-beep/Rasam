    const SOCIAL_LINK_ICON =
        '<g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></g>';

    function socialLogoSvg(name, size) {

        const s = size || 20;
        const logo = SOCIAL_LOGOS[name];

        let inner;
        let fill = '';

        if (logo && logo.svg) {
            inner = logo.svg;
        }
        else if (logo) {
            inner = '<path d="' + logo.p + '"/>';
            fill = ' fill="' + logo.c + '"';
        }
        else {
            inner = SOCIAL_LINK_ICON;
        }

        return '<svg xmlns="http://www.w3.org/2000/svg" width="' + s +
            '" height="' + s + '" viewBox="0 0 24 24"' + fill +
            ' aria-hidden="true" focusable="false">' + inner + '</svg>';
    }

    function renderSocialLogos(items) {

        if (!items || !items.length) {
            return '<span class="meta-empty">-</span>';
        }

        let html = '<div class="social-logos">';

        items.forEach(x => {

            const name = String(getValue(x, 'name', 'Name') || '');
            const username = String(getValue(x, 'username', 'Username') || '');

            if (!name) return;

            html += '<span class="social-logo" tabindex="0"' +
                ' data-tip="' + escapeHtml(username || name) + '"' +
                ' aria-label="' + escapeHtml(name + (username ? ': ' + username : '')) + '">' +
                socialLogoSvg(name, 22) +
                '</span>';
        });

        return html + '</div>';
    }

    /* آیکن و دکمه حذف یکسان برای همه‌جا (شبکه اجتماعی، روابط) */
    const DELETE_ICON_SVG =
        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" ' +
        'stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">' +
        '<path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>';

    const SOCIAL_OTHER = '__other';
    const socialDrafts = { new: [], edit: [] };

    function socialEl(scope, part) {
        return document.getElementById(scope + part);
    }

    function resetSocialInputs(scope) {

        const select = socialEl(scope, 'SocialNetwork');
        const custom = socialEl(scope, 'SocialCustomName');
        const value = socialEl(scope, 'SocialUsername');

        if (select) select.value = '';

        if (custom) {
            custom.value = '';
            custom.hidden = true;
        }

        if (value) value.value = '';

        const addRow = document.querySelector(scope === 'new' ? '#newSocialPicker' : '#editSocialPicker')?.closest('.social-add-row');
        if (addRow) addRow.classList.remove('has-custom');

        refreshSocialPicker(scope);
    }

    function renderSocialTable(scope) {

        const body = socialEl(scope, 'SocialRows');
        const wrap = socialEl(scope, 'SocialTableWrap');
        const empty = socialEl(scope, 'SocialEmpty');

        if (!body) return;

        const list = socialDrafts[scope];

        body.textContent = '';

        list.forEach((item, index) => {

            const row = document.createElement('div');
            row.className = 'social-grid-row';
            row.setAttribute('role', 'row');

            const cIndex = document.createElement('span');
            cIndex.className = 'social-col-idx';
            cIndex.textContent = String(index + 1);

            const cNetwork = document.createElement('span');
            cNetwork.className = 'social-network';
            const logoBox = document.createElement('span');
            logoBox.className = 'social-logo-inline';
            logoBox.innerHTML = socialLogoSvg(item.name, 18);
            const label = document.createElement('span');
            label.className = 'social-network-name';
            label.textContent = item.name;
            cNetwork.append(logoBox, label);

            const cValue = document.createElement('span');
            cValue.className = 'social-value';
            cValue.setAttribute('dir', 'auto');
            cValue.textContent = item.username;

            const cAction = document.createElement('span');
            cAction.className = 'social-col-act';
            const remove = document.createElement('button');
            remove.type = 'button';
            remove.className = 'del-btn social-del-btn';
            remove.dataset.index = String(index);
            remove.title = 'حذف';
            remove.setAttribute('aria-label', 'حذف');
            remove.innerHTML = DELETE_ICON_SVG;
            cAction.appendChild(remove);

            row.append(cIndex, cNetwork, cValue, cAction);
            body.appendChild(row);
        });

        if (wrap) wrap.hidden = !list.length;
        if (empty) empty.hidden = !!list.length;
    }

    function addSocialEntry(scope, silent) {

        const select = socialEl(scope, 'SocialNetwork');
        const custom = socialEl(scope, 'SocialCustomName');
        const valueInput = socialEl(scope, 'SocialUsername');

        if (!select || !valueInput) return false;

        const isOther = select.value === SOCIAL_OTHER;

        const name = isOther
            ? custom.value.trim()
            : select.value;

        const username = valueInput.value.trim();

        if (!name) {
            if (!silent) {
                alert(isOther
                    ? 'نام شبکه را وارد کنید.'
                    : 'ابتدا شبکه اجتماعی را انتخاب کنید.');
            }
            return false;
        }

        if (!username) {
            if (!silent) {
                alert('مقدار (نام کاربری، شناسه یا لینک) را وارد کنید.');
                valueInput.focus();
            }
            return false;
        }

        if (name.length > 100 || username.length > 100) {
            if (!silent) {
                alert('طول نام شبکه و مقدار نباید بیشتر از ۱۰۰ کاراکتر باشد.');
            }
            return false;
        }

        const duplicate = socialDrafts[scope].some(x =>
            x.name.toLowerCase() === name.toLowerCase() &&
            x.username.toLowerCase() === username.toLowerCase()
        );

        if (duplicate) {
            if (!silent) {
                alert('این مورد قبلاً برای این رکورد اضافه شده است.');
            }
            return false;
        }

        socialDrafts[scope].push({ id: 0, name: name, username: username });

        renderSocialTable(scope);
        resetSocialInputs(scope);

        if (!silent) select.focus();

        return true;
    }

    function setSocialDraft(scope, items) {

        socialDrafts[scope] = (items || [])
            .map(x => ({
                id: Number(getValue(x, 'id', 'Id')) || 0,
                name: String(getValue(x, 'name', 'Name') || '').trim(),
                username: String(getValue(x, 'username', 'Username') || '').trim()
            }))
            .filter(x => x.name);

        renderSocialTable(scope);
        resetSocialInputs(scope);
    }

    function appendSocialToFormData(formData, scope) {

        addSocialEntry(scope, true);

        Array.from(formData.keys())
            .filter(key => key.startsWith('SocialMedia['))
            .forEach(key => formData.delete(key));

        socialDrafts[scope].forEach((item, i) => {

            if (item.id) {
                formData.append('SocialMedia[' + i + '].Id', String(item.id));
            }

            formData.append('SocialMedia[' + i + '].Name', item.name);
            formData.append('SocialMedia[' + i + '].Username', item.username);
        });
    }

    async function resolveSocialIds(scope) {

        addSocialEntry(scope, true);

        const list = socialDrafts[scope];

        if (!list.length) return [];

        const key = (n, u) =>
            String(n || '').trim().toLowerCase() + '|' +
            String(u || '').trim().toLowerCase();

        const listResponse = await fetch(
            '@Url.Action("GetSocialMedia", "MetaData")',
            { cache: 'no-store' }
        );

        const catalog = listResponse.ok
            ? await listResponse.json()
            : [];

        const known = new Map(
            catalog.map(x => [
                key(getValue(x, 'name', 'Name'),
                    getValue(x, 'username', 'Username')),
                Number(getValue(x, 'id', 'Id'))
            ])
        );

        const ids = [];

        for (const item of list) {

            const k = key(item.name, item.username);

            let id = known.get(k);

            if (!id) {

                const fd = new FormData();

                fd.append('name', item.name);
                fd.append('username', item.username);
                fd.append('__RequestVerificationToken', getToken());

                const createResponse = await fetch(
                    '@Url.Action("CreateSocialMedia", "MetaData")',
                    { method: 'POST', body: fd }
                );

                const created = await createResponse.json();

                if (!createResponse.ok || !created.success) {
                    throw new Error(
                        created.message ||
                        'ثبت شبکه اجتماعی انجام نشد.'
                    );
                }

                id = Number(created.id);
                known.set(k, id);
            }

            if (!ids.includes(id)) ids.push(id);
        }

        return ids;
    }

    function solidBackground(el) {

        let node = el;

        while (node && node.nodeType === 1) {

            const bg = getComputedStyle(node).backgroundColor;

            if (bg && bg !== 'transparent' && !/rgba?\(\s*0\s*,\s*0\s*,\s*0\s*,\s*0\s*\)/.test(bg)) {
                return bg;
            }

            node = node.parentElement;
        }

        return '#ffffff';
    }

    function socialPickerLabel(value) {

        if (!value) return { name: 'انتخاب شبکه اجتماعی…', logo: '', muted: true };

        if (value === SOCIAL_OTHER) return { name: 'سایر…', logo: socialLogoSvg('', 20) };

        return { name: value, logo: socialLogoSvg(value, 20) };
    }

    function refreshSocialPicker(scope) {

        const select = socialEl(scope, 'SocialNetwork');
        const picker = socialEl(scope, 'SocialPicker');

        if (!select || !picker) return;

        const current = picker.querySelector('.social-picker-current');
        if (!current) return;

        const info = socialPickerLabel(select.value);

        current.innerHTML = '';

        if (info.logo) {
            const logo = document.createElement('span');
            logo.className = 'social-logo-inline';
            logo.innerHTML = info.logo;
            current.appendChild(logo);
        }

        const text = document.createElement('span');
        text.textContent = info.name;
        if (info.muted) text.className = 'social-picker-placeholder';
        current.appendChild(text);

        picker.querySelectorAll('.social-picker-item').forEach(item => {
            item.classList.toggle('active', item.dataset.value === select.value);
        });
    }

    function positionSocialPanel(button, panel) {

        const r = button.getBoundingClientRect();
        const gap = 6;
        const margin = 12;
        const want = 280;

        const below = window.innerHeight - r.bottom - margin;
        const above = r.top - margin;
        const openUp = below < Math.min(want, 220) && above > below;
        const maxH = Math.max(160, Math.min(want, openUp ? above : below));

        panel.style.position = 'fixed';
        panel.style.left = r.left + 'px';
        panel.style.right = 'auto';
        panel.style.width = r.width + 'px';
        panel.style.minWidth = '0';
        panel.style.maxHeight = maxH + 'px';
        panel.style.setProperty('--pk-max', maxH + 'px');

        if (openUp) {
            panel.style.top = 'auto';
            panel.style.bottom = (window.innerHeight - r.top + gap) + 'px';
        }
        else {
            panel.style.bottom = 'auto';
            panel.style.top = (r.bottom + gap) + 'px';
        }
    }

    function closeSocialPickers(except) {

        document.querySelectorAll('.social-picker.open').forEach(p => {

            if (p === except) return;

            p.classList.remove('open');
            p.querySelector('.social-picker-btn')?.setAttribute('aria-expanded', 'false');
            p.querySelector('.social-picker-panel').hidden = true;
        });
    }

    function buildSocialPicker(scope) {

        const select = socialEl(scope, 'SocialNetwork');
        const picker = socialEl(scope, 'SocialPicker');

        if (!select || !picker) return;

        picker.innerHTML = '';

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'input social-picker-btn';
        button.setAttribute('aria-haspopup', 'listbox');
        button.setAttribute('aria-expanded', 'false');

        const current = document.createElement('span');
        current.className = 'social-picker-current';

        const caret = document.createElement('span');
        caret.className = 'social-picker-caret';
        caret.setAttribute('aria-hidden', 'true');

        button.append(current, caret);

        const panel = document.createElement('div');
        panel.className = 'social-picker-panel';
        panel.setAttribute('role', 'listbox');
        panel.hidden = true;

        const search = document.createElement('input');
        search.type = 'search';
        search.className = 'social-picker-search';
        search.placeholder = 'جستجوی شبکه اجتماعی...';
        search.setAttribute('aria-label', 'جستجوی شبکه اجتماعی');
        search.autocomplete = 'off';
        panel.appendChild(search);

        const itemsWrap = document.createElement('div');
        itemsWrap.className = 'social-picker-items';
        panel.appendChild(itemsWrap);

        const noResults = document.createElement('div');
        noResults.className = 'social-picker-no-results';
        noResults.textContent = 'شبکه‌ای پیدا نشد.';
        noResults.hidden = true;
        panel.appendChild(noResults);

        const values = [''].concat(SOCIAL_NETWORKS, [SOCIAL_OTHER]);

        values.forEach(value => {

            const info = socialPickerLabel(value);

            const item = document.createElement('button');
            item.type = 'button';
            item.className = 'social-picker-item' + (value ? '' : ' is-placeholder');
            item.dataset.value = value;
            item.setAttribute('role', 'option');

            if (info.logo) {
                const logo = document.createElement('span');
                logo.className = 'social-logo-inline';
                logo.innerHTML = info.logo;
                item.appendChild(logo);
            }

            const text = document.createElement('span');
            text.textContent = info.name;
            item.appendChild(text);

            item.addEventListener('click', function () {

                select.value = value;
                select.dispatchEvent(new Event('change'));

                refreshSocialPicker(scope);
                closeSocialPickers();
            });

            itemsWrap.appendChild(item);
        });

        search.addEventListener('input', function () {
            const query = this.value.trim().toLocaleLowerCase();
            let visible = 0;
            itemsWrap.querySelectorAll('.social-picker-item').forEach(item => {
                const label = item.textContent.trim().toLocaleLowerCase();
                const show = !query || label.includes(query);
                item.hidden = !show;
                if (show) visible++;
            });
            noResults.hidden = visible !== 0;
        });

        picker.append(button, panel);

        button.addEventListener('click', function (event) {

            event.stopPropagation();

            const willOpen = !picker.classList.contains('open');

            closeSocialPickers(willOpen ? picker : null);

            if (willOpen) {

                panel.style.setProperty('--pk-bg', solidBackground(button));
                panel.style.setProperty('--pk-fg', getComputedStyle(button).color);

                panel.hidden = false;
                positionSocialPanel(button, panel);
                picker.classList.add('open');
                button.setAttribute('aria-expanded', 'true');
                search.value = '';
                itemsWrap.querySelectorAll('.social-picker-item').forEach(item => item.hidden = false);
                noResults.hidden = true;
                search.focus({ preventScroll: true });

                const activeItem = itemsWrap.querySelector('.active');
                if (activeItem) itemsWrap.scrollTop = Math.max(0, activeItem.offsetTop - itemsWrap.offsetTop - 60);
            }
            else {
                closeSocialPickers();
            }
        });

        picker.addEventListener('keydown', function (event) {

            if (event.key === 'Escape' && picker.classList.contains('open')) {
                event.stopPropagation();
                closeSocialPickers();
                button.focus();
            }
        });

        refreshSocialPicker(scope);
    }

    function initSocialControls() {

        ['new', 'edit'].forEach(scope => {

            const select = socialEl(scope, 'SocialNetwork');

            if (!select) return;

            select.innerHTML = '';

            const placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.textContent = 'انتخاب شبکه اجتماعی…';
            select.appendChild(placeholder);

            SOCIAL_NETWORKS.forEach(name => {
                const option = document.createElement('option');
                option.value = name;
                option.textContent = name;
                select.appendChild(option);
            });

            const other = document.createElement('option');
            other.value = SOCIAL_OTHER;
            other.textContent = 'سایر…';
            select.appendChild(other);

            buildSocialPicker(scope);


            select.addEventListener('change', function () {

                const custom = socialEl(scope, 'SocialCustomName');
                const isOther = select.value === SOCIAL_OTHER;

                const addRow = document.querySelector(scope === 'new' ? '#newSocialPicker' : '#editSocialPicker')?.closest('.social-add-row');
                if (addRow) addRow.classList.toggle('has-custom', isOther);

                if (custom) {
                    custom.hidden = !isOther;
                    if (isOther) custom.focus();
                    else custom.value = '';
                }

                if (!isOther && select.value) {
                    socialEl(scope, 'SocialUsername')?.focus();
                }
            });


            socialEl(scope, 'SocialAddBtn')
                ?.addEventListener('click', function () {
                    addSocialEntry(scope, false);
                });


            socialEl(scope, 'SocialUsername')
                ?.addEventListener('keydown', function (event) {
                    if (event.key === 'Enter') {
                        event.preventDefault();
                        addSocialEntry(scope, false);
                    }
                });


            socialEl(scope, 'SocialCustomName')
                ?.addEventListener('keydown', function (event) {
                    if (event.key === 'Enter') {
                        event.preventDefault();
                        socialEl(scope, 'SocialUsername')?.focus();
                    }
                });


            socialEl(scope, 'SocialRows')
                ?.addEventListener('click', function (event) {

                    const button = event.target.closest('.social-del-btn');

                    if (!button) return;

                    socialDrafts[scope].splice(Number(button.dataset.index), 1);

                    renderSocialTable(scope);
                });


            renderSocialTable(scope);
        });
    }

    /* راه‌اندازی رویدادها — از bootstrap صدا زده می‌شود */
    function initSocialListeners() {

        (function () {

            const tip = document.createElement('div');
            tip.className = 'social-tip';
            tip.hidden = true;
            document.body.appendChild(tip);

            function show(target) {

                tip.textContent = target.getAttribute('data-tip') || '';
                tip.hidden = false;

                const r = target.getBoundingClientRect();
                const w = tip.offsetWidth;

                let left = r.left + r.width / 2 - w / 2;
                left = Math.max(6, Math.min(left, window.innerWidth - w - 6));

                let top = r.top - tip.offsetHeight - 8;
                if (top < 6) top = r.bottom + 8;

                tip.style.left = left + 'px';
                tip.style.top = top + 'px';
            }

            document.addEventListener('mouseover', e => {
                const t = e.target.closest && e.target.closest('.social-logo[data-tip]');
                if (t) show(t);
            });

            document.addEventListener('mouseout', e => {
                if (e.target.closest && e.target.closest('.social-logo[data-tip]')) tip.hidden = true;
            });

            document.addEventListener('focusin', e => {
                const t = e.target.closest && e.target.closest('.social-logo[data-tip]');
                if (t) show(t);
            });

            document.addEventListener('focusout', () => { tip.hidden = true; });

            window.addEventListener('scroll', () => { tip.hidden = true; }, true);

        })();

        document.addEventListener('click', function (event) {

            if (!event.target.closest('.social-picker')) closeSocialPickers();
        });

        window.addEventListener('resize', () => closeSocialPickers());

        document.addEventListener('scroll', function (event) {

            const t = event.target;
            if (t && t.closest && t.closest('.social-picker-panel')) return;

            closeSocialPickers();
        }, true);

    }

</script>

