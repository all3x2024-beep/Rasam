@model IEnumerable<Rasam.Models.SocialAccount.Profile>

@{
    ViewData["Title"] = "مدیریت پروفایل‌ها";
}


<!-- =========================================================
     گزارش خطاهای جاوااسکریپت (برای عیب‌یابی؛ استایل در css/components/alerts.css)
========================================================= -->
<script>
    (function () {
        var shown = {};

        function show(msg) {
            if (shown[msg]) return;

            if (!document.body) {
                document.addEventListener('DOMContentLoaded', function () { show(msg); });
                return;
            }

            shown[msg] = true;

            var box = document.getElementById('pageErrorBanner');

            if (!box) {
                box = document.createElement('div');
                box.id = 'pageErrorBanner';
                box.className = 'page-error-banner';

                var close = document.createElement('button');
                close.type = 'button';
                close.className = 'page-error-banner-close';
                close.textContent = '×';
                close.onclick = function () { box.remove(); };

                box.appendChild(close);
                document.body.appendChild(box);
            }

            var line = document.createElement('div');
            line.textContent = '⚠ ' + msg;
            box.appendChild(line);
        }

        window.__reportPageError = show;

        window.addEventListener('error', function (e) {
            show('خطای جاوااسکریپت: ' + (e.message || 'نامشخص') + (e.lineno ? ' (خط ' + e.lineno + ')' : ''));
        });

        window.addEventListener('unhandledrejection', function (e) {
            var r = e.reason;
            show('خطای ناهمگام: ' + (r && r.message ? r.message : r));
        });
    })();
</script>

<!-- =========================================================
     STATISTICS
========================================================= -->

<section class="stats">


    <div class="stat">
        <div class="stat-top">
            <div class="stat-text">
                <div class="stat-label">موضوع</div>
                <div class="stat-value" id="topicCount">۰</div>
            </div>
        </div>
        <div class="stat-caption">تعداد موضوعات یکتا</div>
    </div>

    <div class="stat">
        <div class="stat-top">
            <div class="stat-text">
                <div class="stat-label">شناسه رکورد</div>
                <div class="stat-value" id="idCount">۰</div>
            </div>
        </div>
        <div class="stat-caption">رکوردهای دارای شناسه رکورد</div>
    </div>

    <div class="stat">
        <div class="stat-top">
            <div class="stat-text">
                <div class="stat-label">کد ملی</div>
                <div class="stat-value" id="nationalCount">۰</div>
            </div>
        </div>
        <div class="stat-caption">رکوردهای دارای کد ملی</div>
    </div>

    <div class="stat">
        <div class="stat-top">
            <div class="stat-text">
                <div class="stat-label">موبایل</div>
                <div class="stat-value" id="mobileCount">۰</div>
            </div>
        </div>
        <div class="stat-caption">رکوردهای دارای موبایل</div>
    </div>

    <div class="stat">
        <div class="stat-top">
            <div class="stat-text">
                <div class="stat-label">تصویر</div>
                <div class="stat-value" id="attachmentCount">۰</div>
            </div>
        </div>
        <div class="stat-caption">رکوردهای دارای تصویر</div>
    </div>


</section>

<!-- =========================================================
     MAIN TABLE
========================================================= -->

<section class="card">


    <div class="toolbar">

        <button class="btn btn-primary"
                id="addRecordBtn"
                type="button">
            ➕ افزودن رکورد
        </button>

        <input id="searchInput"
               class="search"
               type="text"
               placeholder="جستجو در نام، نام خانوادگی، شناسه رکورد، موضوع، کد ملی، موبایل، تگ، شبکه اجتماعی...">

        <button class="btn btn-info"
                id="graphBtn"
                type="button">
            🕸️ گراف روابط
        </button>

        <button class="btn btn-info"
                id="mersadBtn"
                type="button"
                title="پیوست‌های ردیف‌های انتخاب‌شده (به تفکیک کد ملی) در یک فایل ZIP دانلود می‌شود">
            📦 مرصاد
        </button>

    </div>


    <div class="table-wrap">

        <table>

            <thead>

                <tr>

                    <th class="col-select">
                        <input type="checkbox"
                               id="selectAllRowsCheckbox"
                               title="انتخاب همه">
                    </th>

                    <th>#</th>

                    <th>تصویر پروفایل</th>

                    <th>موضوع</th>

                    <th>شناسه رکورد</th>

                    <th>نام</th>

                    <th>نام خانوادگی</th>

                    <th>کد ملی</th>

                    <th>موبایل</th>

                    <th>کشور</th>

                    <th>تگ‌ها</th>

                    <th>شبکه‌های اجتماعی</th>

                    <th>روابط</th>

                    <th>عملیات</th>

                </tr>

            </thead>


            <tbody id="tableBody">

                @if (Model != null)
                {
                    var rowNumber = 1;

                    foreach (var item in Model)
                    {
                        <tr data-record-row="1" data-record-id="@item.Id">

                            <td class="col-select">

                                <input type="checkbox"
                                       class="row-checkbox"
                                       value="@item.Id">

                            </td>


                            <td>
                                @rowNumber
                            </td>


                            <td>

                                @if (!string.IsNullOrWhiteSpace(item.Image))
                                {
                                    <img src="@item.Image"
                                         class="profile-avatar"
                                         alt="تصویر پروفایل">
                                }
                                else
                                {
                                    <div class="profile-avatar-empty">
                                        👤
                                    </div>
                                }

                            </td>


                            <td>
                                @(item.Topic?.Title ?? "-")
                            </td>


                            <td>
                                <strong>
                                    @(item.UsernameId ?? "-")
                                </strong>
                            </td>


                            <td class="profile-name-cell">
                                @(item.FirstName ?? "-")
                            </td>


                            <td class="profile-name-cell">
                                @(item.LastName ?? "-")
                            </td>


                            <td>
                                @(item.NationalCode ?? "-")
                            </td>


                            <td>
                                @(item.Phone ?? "-")
                            </td>


                            <td>
                                @(item.Country ?? "-")
                            </td>


                            <td class="table-meta-cell">

                                @if (item.Tag != null && item.Tag.Any())
                                {
                                    <div class="meta-chips">

                                        @foreach (var tag in item.Tag.Take(4))
                                        {
                                            <span class="meta-chip tag">
                                                @tag.Title
                                            </span>
                                        }

                                        @if (item.Tag.Count > 4)
                                        {
                                            <span class="meta-more">
                                                +@(item.Tag.Count - 4)
                                            </span>
                                        }

                                    </div>
                                }
                                else
                                {
                                    <span class="meta-empty">-</span>
                                }

                            </td>


                            <td class="table-meta-cell">

                                @if (item.SocialMedia != null && item.SocialMedia.Any())
                                {
                                    <div class="social-logos">
                                        @foreach (var social in item.SocialMedia)
                                        {
                                            <span class="social-logo" tabindex="0" data-tip="@(string.IsNullOrWhiteSpace(social.Username) ? social.Name : social.Username)" aria-label="@social.Name">
                                                @* رندر مستقیم لگوها *@
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="meta-empty">-</span>
                                }

                            </td>


                            <td class="table-meta-cell">

                                @if (item.Relation != null && item.Relation.Any())
                                {
                                    <div class="meta-chips">

                                        @foreach (var relation in item.Relation.Take(3))
                                        {
                                            <span class="meta-chip relation">
                                                @relation.Type
                                            </span>
                                        }

                                        @if (item.Relation.Count > 3)
                                        {
                                            <span class="meta-more">
                                                +@(item.Relation.Count - 3)
                                            </span>
                                        }

                                    </div>
                                }
                                else
                                {
                                    <span class="meta-empty">-</span>
                                }

                            </td>


                            <td class="col-actions">

                                <div class="row-actions">

                                    <button type="button"
                                            class="edit-btn"
                                            data-edit-id="@item.Id"
                                            title="ویرایش"
                                            aria-label="ویرایش">
                                        ✏️
                                    </button>

                                    <button type="button"
                                            class="graph-btn"
                                            data-graph-id="@item.Id"
                                            title="گراف ارتباطی این رکورد"
                                            aria-label="گراف ارتباطی این رکورد">
                                        🕸️
                                    </button>

                                    <button type="button"
                                            class="edit-btn delete-btn"
                                            data-delete-id="@item.Id"
                                            title="حذف رکورد"
                                            aria-label="حذف رکورد">
                                        🗑️
                                    </button>

                                </div>

                            </td>

                        </tr>

                        rowNumber++;
                    }
                }

            </tbody>

        </table>

    </div>


    <div class="empty-state"
         id="emptyState"
         hidden>

        <div class="empty-icon">
            📭
        </div>

        <h3 id="emptyTitle">
            هنوز رکوردی ثبت نشده است
        </h3>

        <p id="emptyText">
            برای شروع، روی «افزودن رکورد» کلیک کنید.
        </p>

    </div>


</section>

<!-- =========================================================
     MERSAD REPORT MODAL
========================================================= -->
<div class="modal" id="mersadReportModal">
    <div class="modal-content">
        <div class="modal-header">
            <div>
                <h3>📦 گزارش مرصاد</h3>
                <div class="modal-header-sub" id="mersadReportSub"></div>
            </div>
            <button class="close-btn modalCloseBtn" type="button">×</button>
        </div>
        <div class="modal-body" id="mersadReportBody"></div>
        <div class="modal-footer">
            <button class="btn btn-secondary modalCloseBtn" type="button">بستن</button>
        </div>
    </div>
</div>

<!-- =========================================================
     GALLERY MODAL (گالری پیوست‌های هر ردیف)
========================================================= -->
<div class="modal" id="galleryModal">
    <div class="modal-content gallery-modal-content">
        <div class="modal-header">
            <div>
                <h3 id="galleryTitle">🖼️ گالری پیوست‌ها</h3>
                <div class="modal-header-sub" id="gallerySub"></div>
            </div>
            <button class="close-btn modalCloseBtn" type="button">×</button>
        </div>

        <div class="modal-body gallery-body">

            <div class="gal-toolbar">
                <input id="gallerySearch" class="input gal-search" type="search" placeholder="🔎 جستجو در نام فایل..." autocomplete="off">

                <select id="gallerySort" class="input gal-sort" aria-label="مرتب‌سازی">
                    <option value="new">جدیدترین</option>
                    <option value="old">قدیمی‌ترین</option>
                    <option value="name">نام (الف تا ی)</option>
                    <option value="type">نوع فایل</option>
                </select>

                <div class="gal-seg" id="galleryViewToggle" role="group" aria-label="نوع نمایش">
                    <button type="button" data-view="grid" title="نمایش شبکه‌ای">▦</button>
                    <button type="button" data-view="list" title="نمایش فهرستی">☰</button>
                </div>

                <label class="gal-size" id="gallerySizeWrap" title="اندازهٔ بند انگشتی">
                    🔍
                    <input type="range" id="gallerySize" min="90" max="240" step="10" value="130">
                </label>
            </div>

            <div class="gal-chips" id="galleryChips"></div>

            <div class="gal-selbar" id="gallerySelBar" hidden>
                <span id="gallerySelCount"></span>
                <span class="gal-sp"></span>
                <button type="button" id="gallerySelAll">انتخاب همهٔ نتایج</button>
                <button type="button" id="gallerySelDownload">⬇ دانلود</button>
                <button type="button" id="gallerySelDelete" class="gal-danger">🗑 حذف</button>
                <button type="button" id="gallerySelClear">لغو انتخاب</button>
            </div>

            <div class="gal-grid" id="galleryGrid"></div>

            <div class="gal-empty" id="galleryEmpty" hidden></div>

        </div>

        <div class="modal-footer">
            <button class="btn btn-secondary" id="galleryEditBtn" type="button">✏️ ویرایش رکورد / افزودن پیوست</button>
            <button class="btn btn-secondary modalCloseBtn" type="button">بستن</button>
        </div>
    </div>
</div>

<div class="gal-lightbox" id="galleryLightbox" hidden role="dialog" aria-modal="true" aria-label="پیش‌نمایش پیوست">
    <div class="gal-lb-top">
        <div class="gal-lb-title" id="galleryLbTitle"></div>
        <span id="galleryLbCount"></span>
        <a class="gal-lb-btn" id="galleryLbDownload" href="#" download>⬇ دانلود</a>
        <a class="gal-lb-btn" id="galleryLbOpen" href="#" target="_blank" rel="noopener">↗ باز کردن</a>
        <button type="button" class="gal-lb-btn" id="galleryLbClose" aria-label="بستن">✕ بستن</button>
    </div>
    <div class="gal-lb-stage" id="galleryLbStage">
        <button type="button" class="gal-lb-nav gal-lb-prev" id="galleryLbPrev" aria-label="قبلی">❯</button>
        <button type="button" class="gal-lb-nav gal-lb-next" id="galleryLbNext" aria-label="بعدی">❮</button>
        <div id="galleryLbContent"></div>
    </div>
</div>

<!-- =========================================================
     ADD MODAL
========================================================= -->
<div class="modal" id="addRecordModal">
    <div class="modal-content">
        <div class="modal-header">
            <div>
                <h3>افزودن رکورد جدید</h3>
                <div class="modal-header-sub">اطلاعات رکورد</div>
            </div>
            <button class="close-btn modalCloseBtn" type="button">×</button>
        </div>

        <form id="addRecordForm" asp-controller="Profile" asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="modal-body">
                <div class="form-grid">

                    <!-- RECORD CORE: IMAGE RIGHT / FIELDS LEFT -->
                    <div class="record-core-layout">
                        <!-- RIGHT: PROFILE IMAGE -->
                        <div class="form-group record-image-column">
                            <label>🖼️ تصویر پروفایل</label>
                            <div class="record-image-panel" title="عکس همزمان با ذخیره رکورد بارگذاری می‌شود و به‌عنوان تصویر پروفایل در جدول اصلی نمایش داده خواهد شد.">
                                <div class="image-stage">
                                    <img id="newRecordImagePreviewImg" alt="پیش‌نمایش تصویر پروفایل" hidden>
                                    <span class="image-stage-empty" id="newRecordImageEmpty">👤</span>
                                </div>

                                <div class="image-side">
                                    <span class="image-badge" id="newRecordImageBadge" hidden></span>
                                    <div class="image-file-control">
                                        <input id="newRecordImage" name="MyFile" class="image-file-input" type="file" accept="image/*">
                                        <label for="newRecordImage" class="image-file-button">📁 انتخاب تصویر</label>
                                        <button type="button" class="image-file-clear" id="newRecordImageClear" title="لغو انتخاب" aria-label="لغو انتخاب تصویر" hidden>×</button>
                                    </div>
                                    <div class="image-file-status" id="newRecordImageStatus">تصویری انتخاب نشده (حداکثر ۵ مگابایت)</div>
                                </div>
                            </div>
                        </div>

                        <!-- LEFT: 4 + 4 FIELDS -->
                        <div class="record-fields-column">
                            <div class="record-fields-row record-fields-row-primary">
                                <div class="form-group">
                                    <label>👤 نام</label>
                                    <input id="newRecordFirstName" name="FirstName" class="input" type="text">
                                </div>
                                <div class="form-group">
                                    <label>👥 نام خانوادگی</label>
                                    <input id="newRecordLastName" name="LastName" class="input" type="text">
                                </div>
                                <div class="form-group">
                                    <label>🪪 کد ملی</label>
                                    <input id="newRecordNationalId" name="NationalCode" class="input" type="text" maxlength="10" inputmode="numeric">
                                </div>
                                <div class="form-group">
                                    <label>📱 موبایل</label>
                                    <input id="newRecordMobile" name="Phone" class="input" type="text">
                                </div>
                            </div>

                            <div class="record-fields-row record-fields-row-secondary">
                                <div class="form-group">
                                    <label>📂 موضوع</label>
                                    <select id="newRecordTopic" name="TopicId" class="input" required>
                                        <option value="">در حال بارگذاری...</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>🆔 شناسه رکورد</label>
                                    <input id="newRecordUsernameId" name="UsernameId" class="input" type="text">
                                </div>
                                <div class="form-group">
                                    <label>🆔 شناسه شخصی</label>
                                    <input id="newRecordPid" name="PID" class="input" type="text">
                                </div>
                                <div class="form-group">
                                    <label>🌍 کشور</label>
                                    <input id="newRecordCountry" name="Country" class="input country-picker-input" type="text" readonly autocomplete="off" placeholder="انتخاب کشور...">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAGS -->
                    <div class="form-group full">
                        <label>🏷️ تگ‌ها</label>
                        <select id="newRecordTag" name="TagIds" class="input smart-multi-select" data-placeholder="تگ‌ها را انتخاب کنید" multiple></select>
                    </div>

                    <!-- SOCIAL MEDIA -->
                    <div class="form-group full">
                        <label>🌐 شبکه‌های اجتماعی</label>
                        <div class="social-box">
                            <div class="social-empty-state" id="newSocialEmpty">
                                <div class="relation-empty">هنوز شبکه‌ای برای این رکورد ثبت نشده است.</div>
                            </div>

                            <div class="social-add-row">
                                <select id="newSocialNetwork" class="input social-network-select" tabindex="-1" aria-hidden="true"></select>
                                <div class="social-picker" id="newSocialPicker"></div>
                                <input id="newSocialCustomName" class="input social-custom-name" type="text" maxlength="100" placeholder="نام شبکه را بنویسید" autocomplete="off" hidden>
                                <input id="newSocialUsername" class="input social-value-input" type="text" maxlength="100" dir="auto" placeholder="نام کاربری، شناسه یا لینک" autocomplete="off">
                                <button type="button" class="btn btn-secondary" id="newSocialAddBtn">➕ افزودن</button>
                            </div>

                            <div class="social-table-wrap" id="newSocialTableWrap" hidden>
                                <div class="social-grid" role="table" aria-label="شبکه‌های اجتماعی">
                                    <div class="social-grid-head" role="row">
                                        <span class="social-col-idx" role="columnheader">#</span>
                                        <span role="columnheader">شبکه</span>
                                        <span role="columnheader">مقدار</span>
                                        <span class="social-col-act" role="columnheader">عملیات</span>
                                    </div>
                                    <div class="social-grid-body" id="newSocialRows" role="rowgroup"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- RELATIONS -->
                    <div class="form-group full">
                        <label>🔗 روابط</label>
                        <div id="newRelationRows">
                            <div class="relation-empty">هنوز رابطه‌ای اضافه نشده است.</div>
                        </div>
                        <button type="button" class="btn btn-secondary" id="addNewRelationRowBtn">➕ افزودن رابطه</button>
                    </div>

                    <!-- ATTACHMENTS -->
                    <div class="form-group full">
                        <label>📎 پیوست‌ها</label>
                        <div class="attach-box">
                            <div class="attach-controls">
                                <input id="newAttachInput" class="attach-file-input" type="file" multiple>
                                <label for="newAttachInput" class="attach-pick-btn">📁 انتخاب فایل‌های پیوست</label>
                                <button type="button" class="btn btn-secondary" id="newAttachClear" hidden>پاک کردن انتخاب‌ها</button>
                                <span class="attach-status" id="newAttachStatus">پیوستی انتخاب نشده (هر فایل حداکثر ۲۵ مگابایت)</span>
                            </div>
                            <div class="attach-grid" id="newAttachGrid"></div>
                        </div>
                    </div>

                    <!-- THEORY -->
                    <div class="form-group full">
                        <label>📝 نظریه</label>
                        <textarea id="newRecordNotes" name="Theory" class="input textarea-input"></textarea>
                    </div>

                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-success" id="saveNewRecordBtn" type="submit">💾 ذخیره رکورد</button>
                <button class="btn btn-secondary modalCloseBtn" type="button">انصراف</button>
            </div>
        </form>
    </div>
</div>

<!-- =========================================================
     EDIT MODAL
========================================================= -->
<div class="modal" id="editModal">
    <div class="modal-content">
        <div class="modal-header">
            <div>
                <h3>ویرایش اطلاعات</h3>
                <div class="modal-header-sub" id="editRecordTitle">اطلاعات رکورد</div>
            </div>
            <button class="close-btn modalCloseBtn" type="button">×</button>
        </div>

        <form id="editRecordForm">
            <div class="modal-body">
                <div class="form-grid">

                    <!-- RECORD CORE: IMAGE RIGHT / FIELDS LEFT -->
                    <div class="record-core-layout">
                        <!-- RIGHT: PROFILE IMAGE -->
                        <div class="form-group record-image-column">
                            <label>🖼️ تصویر پروفایل</label>
                            <div class="record-image-panel" title="عکس همزمان با ذخیره رکورد بارگذاری می‌شود و به‌عنوان تصویر پروفایل در جدول اصلی نمایش داده خواهد شد.">
                                <div class="image-stage">
                                    <img id="editImagePreviewImg" alt="پیش‌نمایش تصویر پروفایل" hidden>
                                    <span class="image-stage-empty" id="editImageEmpty">👤</span>
                                </div>

                                <div class="image-side">
                                    <span class="image-badge" id="editImageBadge" hidden></span>
                                    <div class="image-file-control">
                                        <input id="editRecordImage" name="MyFile" class="image-file-input" type="file" accept="image/*">
                                        <label for="editRecordImage" class="image-file-button">📁 انتخاب تصویر</label>
