    function initCountryPicker(input) {
        if (!input || input.dataset.countryReady === '1') return;
        input.dataset.countryReady = '1';
        const wrapper = document.createElement('div'); wrapper.className = 'country-picker';
        input.parentNode.insertBefore(wrapper, input); wrapper.appendChild(input);
        wrapper.insertAdjacentHTML('beforeend', `<span class="country-picker-arrow">⌄</span><div class="country-picker-panel"><div class="country-picker-search"><span>⌕</span><input type="search" placeholder="جستجوی کشور..." autocomplete="off"></div><div class="country-picker-options"></div></div>`);
        const search = wrapper.querySelector('.country-picker-search input'); const options = wrapper.querySelector('.country-picker-options');
        const render = () => {
            const q = search.value.trim().toLocaleLowerCase('fa'); options.innerHTML = '';
            countryList.filter(x => !q || x.toLocaleLowerCase('fa').includes(q)).forEach(country => {
                const item = document.createElement('button'); item.type='button'; item.className='country-picker-option'+(input.value===country?' is-selected':'');
                item.innerHTML=`<span>${escapeHtml(country)}</span>${input.value===country?'<b>✓</b>':''}`;
                item.addEventListener('click',()=>{input.value=country; input.dispatchEvent(new Event('change',{bubbles:true})); wrapper.classList.remove('is-open');}); options.appendChild(item);
            });
            if(!options.children.length) options.innerHTML='<div class="country-picker-empty">کشوری پیدا نشد.</div>';
        };
        input.addEventListener('click',()=>{ document.querySelectorAll('.country-picker.is-open').forEach(x=>{if(x!==wrapper)x.classList.remove('is-open')}); wrapper.classList.toggle('is-open'); if(wrapper.classList.contains('is-open')){search.value='';render();requestAnimationFrame(()=>search.focus())} });
        input.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();input.click()}}); search.addEventListener('input',render); document.addEventListener('click',e=>{if(!wrapper.contains(e.target))wrapper.classList.remove('is-open')}); render();
    }

    function initCountryPickers(){document.querySelectorAll('.country-picker-input').forEach(initCountryPicker);}

</script>

<!-- =========================================================
     SCRIPT 04 · موضوعات
========================================================= -->
<script>

    'use strict';

    /* =========================================================
       موضوعات
       - پاسخ سرور هر شکلی (camelCase / PascalCase / آرایه یا {data:[]}) باشد پشتیبانی می‌شود
       - خطای یک بخش جلوی بقیهٔ راه‌اندازی را نمی‌گیرد
       - هنگام باز کردن مودال در صورت شکست، دوباره تلاش می‌شود
    ========================================================= */

    window.metaCache = window.metaCache || { topics: null, tags: null };
    let topicsLoading = null;
    let tagsLoading = null;

    function pickMetaField(obj, exactKeys, suffixes) {

        for (const k of exactKeys) {
            if (obj[k] !== undefined && obj[k] !== null && obj[k] !== '') return obj[k];
        }

        for (const key of Object.keys(obj)) {
            const low = key.toLowerCase();
            if (suffixes.some(sfx => low.endsWith(sfx)) &&
                obj[key] !== undefined && obj[key] !== null && obj[key] !== '' &&
                typeof obj[key] !== 'object') {
                return obj[key];
            }
        }

        return '';
    }

    // پاسخ‌های متداول API را تا چند لایه باز می‌کند؛ مانند data.tags، result.items و $values.
    function unwrapMetaList(raw) {

        let value = raw;
        const wrapperKeys = [
            '$values', 'values', 'value', 'data', 'items', 'result',
            'tags', 'taglist', 'tagitems', 'list', 'records',
            'topics', 'topiclist', 'topicitems',
            'relations', 'relationlist', 'relationitems'
        ];

        for (let depth = 0; depth < 6; depth++) {

            if (Array.isArray(value)) return value;
            if (!value || typeof value !== 'object') return null;

            const key = Object.keys(value).find(k =>
                wrapperKeys.includes(k.toLowerCase()) &&
                value[k] !== undefined && value[k] !== null
            );

            if (!key) return null;
            value = value[key];
        }

        return Array.isArray(value) ? value : null;
    }

    function normalizeMetaList(raw) {

        const list = unwrapMetaList(raw);
        if (!list) return [];

        return list.map(x => {

            if (x === null || typeof x !== 'object') {
                return { id: String(x), title: String(x) };
            }

            return {
                id: String(pickMetaField(x, ['id', 'Id', 'ID', 'value', 'Value'], ['id', 'value'])),
                title: String(pickMetaField(x, ['title', 'Title', 'name', 'Name', 'text', 'Text', 'label', 'Label'], ['title', 'name', 'text', 'label']))
            };

        }).filter(x => x.id !== '' && x.title !== '');
    }

    async function fetchMetaList(url, errorMessage) {

        const response = await fetch(url, { cache: 'no-store', credentials: 'same-origin' });

        if (!response.ok)
            throw new Error(errorMessage + ' (HTTP ' + response.status + ')');

        const text = await response.text();

        let parsed;

        try {
            parsed = JSON.parse(text);
        }
        catch (e) {
            throw new Error(errorMessage + ': پاسخ JSON نیست → ' + text.trim().slice(0, 80));
        }

        const list = normalizeMetaList(parsed);

        if (!list.length) {
            console.warn('پاسخ خام', url, parsed);
            const rawList = unwrapMetaList(parsed);

            if (rawList && rawList.length) {
                throw new Error(errorMessage + ': ساختار آیتم‌ها ناشناخته است → ' + JSON.stringify(rawList[0]).slice(0, 120));
            }

            // پاسخ شیء غیرخالی با ساختار ناشناخته نباید به‌عنوان «بدون تگ» کش شود.
            if (!rawList && parsed && typeof parsed === 'object' && Object.keys(parsed).length) {
                throw new Error(errorMessage + ': ساختار پاسخ ناشناخته است → ' + JSON.stringify(parsed).slice(0, 120));
            }
        }

        return list;
    }

    function fillTopicSelects(topics, failed) {

        const failText = typeof failed === 'string' ? failed : '';

        ['newRecordTopic', 'editRecordTopic'].forEach(id => {

            const select = document.getElementById(id);

            if (!select) return;

            const previous = select.value;

            select.innerHTML = '';

            const placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.textContent = failed
                ? (failText || 'خطا در بارگذاری موضوعات')
                : 'انتخاب موضوع';
            select.appendChild(placeholder);

            topics.forEach(topic => {
                const option = document.createElement('option');
                option.value = topic.id;
                option.textContent = topic.title;
                select.appendChild(option);
            });

            if (previous && Array.from(select.options).some(o => o.value === previous))
                select.value = previous;
        });
    }

    async function loadRecordTopics(force) {

        if (!force && window.metaCache.topics) {
            fillTopicSelects(window.metaCache.topics, false);
            return window.metaCache.topics;
        }

        if (topicsLoading) return topicsLoading;

        topicsLoading = (async () => {
            try {
                const topics = await fetchMetaList(
                    '@Url.Action("GetTopics", "MetaData")',
                    'خطا در دریافت موضوعات'
                );
                window.metaCache.topics = topics;
                fillTopicSelects(topics, false);
                return topics;
            }
            catch (err) {
                console.error(err);
                window.metaCache.topics = null;
                fillTopicSelects([], (err && err.message) ? err.message : true);
                return [];
            }
            finally {
                topicsLoading = null;
            }
        })();

        return topicsLoading;
    }

    /* انتخاب موضوع رکورد در فرم ویرایش (اول با شناسه، بعد با عنوان) */
    function applyRecordTopic(record) {

        const select = document.getElementById('editRecordTopic');

        if (!select) return;

        const rawTopic = getValue(record, 'topic', 'Topic');

        let id = getValue(record, 'topicId', 'TopicId', 'topicID', 'TopicID');
        let title = '';

        if (rawTopic && typeof rawTopic === 'object') {
            if (id === '') id = getValue(rawTopic, 'id', 'Id');
            title = String(getValue(rawTopic, 'title', 'Title', 'name', 'Name'));
        }
        else if (rawTopic) {
            title = String(rawTopic);
        }

        id = (id === '' || id === null || id === undefined) ? '' : String(id);

        const options = Array.from(select.options);

        let match = id ? options.find(o => o.value === id) : null;

        if (!match && title)
            match = options.find(o => (o.textContent || '').trim() === title.trim());

        if (!match && id) {
            // موضوع در لیست نیست (مثلاً غیرفعال شده)؛ برای اینکه ذخیره خراب نشود موقتاً اضافه می‌شود
            match = document.createElement('option');
            match.value = id;
            match.textContent = title || ('موضوع ' + id);
            select.appendChild(match);
        }

        select.value = match ? match.value : '';
    }


</script>

