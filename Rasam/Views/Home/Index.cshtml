<script>

    'use strict';

    /* =========================================================
       حذف رکورد و مودال تأیید
    ========================================================= */

    let deleteRecordConfirmModal;
    let deleteRecordConfirmBtn;
    let deleteRecordCancelBtn;
    let deleteRecordConfirmCloseBtn;
    let deleteRecordConfirmTitle;
    let deleteRecordConfirmSub;
    let deleteRecordConfirmIcon;
    let deleteRecordConfirmText;
    let pendingDelete = null;
    let pendingDeleteButton = null;
    let deleteModalResultMode = false;

    function resetDeleteModal() {
        deleteModalResultMode = false;
        pendingDelete = null;
        pendingDeleteButton = null;

        if (deleteRecordConfirmTitle) {
            deleteRecordConfirmTitle.textContent = '⚠️ تأیید حذف';
        }

        if (deleteRecordConfirmSub) {
            deleteRecordConfirmSub.textContent =
                'حذف این مورد قابل بازگشت نیست.';
        }

        if (deleteRecordConfirmIcon) {
            deleteRecordConfirmIcon.textContent = '🗑️';
        }

        if (deleteRecordConfirmText) {
            deleteRecordConfirmText.innerHTML =
                'آیا از حذف <strong id="deleteRecordConfirmName"></strong> مطمئن هستید؟';
        }

        if (deleteRecordConfirmBtn) {
            deleteRecordConfirmBtn.disabled = false;
            deleteRecordConfirmBtn.textContent = '🗑️ حذف';
            deleteRecordConfirmBtn.classList.remove('btn-secondary');
            deleteRecordConfirmBtn.classList.add('btn-danger');
        }

        if (deleteRecordCancelBtn) {
            deleteRecordCancelBtn.hidden = false;
            deleteRecordCancelBtn.disabled = false;
        }
    }

    function closeDeleteConfirm() {
        if (deleteRecordConfirmModal) {
            closeModal(deleteRecordConfirmModal);
        }
        resetDeleteModal();
    }

    function showDeleteError(message) {
        deleteModalResultMode = true;
        pendingDelete = null;

        if (deleteRecordConfirmTitle) {
            deleteRecordConfirmTitle.textContent = '❌ حذف انجام نشد';
        }

        if (deleteRecordConfirmSub) {
            deleteRecordConfirmSub.textContent =
                'عملیات حذف توسط سرور انجام نشد.';
        }

        if (deleteRecordConfirmIcon) {
            deleteRecordConfirmIcon.textContent = '⚠️';
        }

        if (deleteRecordConfirmText) {
            deleteRecordConfirmText.textContent =
                message || 'حذف رکورد انجام نشد.';
        }

        if (deleteRecordCancelBtn) {
            deleteRecordCancelBtn.hidden = true;
        }

        if (deleteRecordConfirmBtn) {
            deleteRecordConfirmBtn.disabled = false;
            deleteRecordConfirmBtn.textContent = 'بستن';
            deleteRecordConfirmBtn.classList.remove('btn-danger');
            deleteRecordConfirmBtn.classList.add('btn-secondary');
        }
    }

    function openRecordDeleteConfirm(name, deleteFunction, button) {
        pendingDelete = deleteFunction;
        pendingDeleteButton = button || null;
        deleteModalResultMode = false;

        const nameElement =
            document.getElementById('deleteRecordConfirmName');

        if (nameElement) {
            nameElement.textContent = `«${name}»`;
        }

        if (deleteRecordConfirmModal) {
            openModal(deleteRecordConfirmModal);
        }
    }

    async function deleteRecord(id, button) {
        if (!id) return false;

        const record =
            (window.records || []).find(
                x =>
                    String(getValue(x, 'id', 'Id')) === String(id)
            );

        if (!record) {
            showDeleteError('رکورد موردنظر پیدا نشد.');
            return false;
        }

        const deleteButton = button || pendingDeleteButton;

        if (deleteButton) {
            deleteButton.disabled = true;
        }

        try {
            const body = new URLSearchParams();
            body.set('id', String(id));
            body.set('__RequestVerificationToken', getToken());

            const response =
                await fetch(
                    '@Url.Action("Delete", "Profile")',
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type':
                                'application/x-www-form-urlencoded; charset=UTF-8'
                        },
                        body: body.toString()
                    }
                );

            let result = null;

            try {
                result = await response.json();
            }
            catch {
                result = null;
            }

            if (!response.ok || !result || !result.success) {
                showDeleteError(
                    result?.message ||
                    'حذف رکورد انجام نشد.'
                );
                return false;
            }

            window.records =
                (window.records || []).filter(
                    x =>
                        String(getValue(x, 'id', 'Id')) !== String(id)
                );

            tableSearchIndex.delete(String(id));
            graphRelCache = null;

            renderTable();
            updateStats();

            return true;
        }
        catch (error) {
            console.error('Delete profile:', error);
            showDeleteError(
                'خطا در ارتباط با سرور هنگام حذف رکورد.'
            );
            return false;
        }
        finally {
            if (deleteButton) {
                deleteButton.disabled = false;
            }
        }
    }

    /* راه‌اندازی رویدادها — از bootstrap صدا زده می‌شود */
    function initDeleteRecord() {

    deleteRecordConfirmModal = document.getElementById('deleteRecordConfirmModal');

    deleteRecordConfirmBtn = document.getElementById('deleteRecordConfirmBtn');

    deleteRecordCancelBtn = document.getElementById('deleteRecordCancelBtn');

    deleteRecordConfirmCloseBtn = document.getElementById('deleteRecordConfirmCloseBtn');

    deleteRecordConfirmTitle = document.getElementById('deleteRecordConfirmTitle');

    deleteRecordConfirmSub = document.getElementById('deleteRecordConfirmSub');

    deleteRecordConfirmIcon = document.getElementById('deleteRecordConfirmIcon');

    deleteRecordConfirmText = document.getElementById('deleteRecordConfirmText');

        deleteRecordCancelBtn?.addEventListener('click', closeDeleteConfirm);

        deleteRecordConfirmCloseBtn?.addEventListener('click', closeDeleteConfirm);

        deleteRecordConfirmModal?.addEventListener('mousedown', function (event) {
            if (event.target === this) {
                closeDeleteConfirm();
            }
        });

        document.addEventListener('keydown', function (event) {
            if (event.key !== 'Escape') return;
            if (deleteRecordConfirmModal?.classList.contains('show')) {
                closeDeleteConfirm();
            }
        });

        deleteRecordConfirmBtn?.addEventListener('click', async function () {
            if (deleteModalResultMode) {
                closeDeleteConfirm();
                return;
            }

            if (!pendingDelete || this.disabled) return;

            const action = pendingDelete;
            this.disabled = true;

            try {
                const success = await action();
                if (success) {
                    closeDeleteConfirm();
                }
            }
            finally {
                this.disabled = false;
            }
        });

        document.addEventListener('click', function (event) {
            const button = event.target.closest('[data-delete-id]');
            if (!button) return;

            const id = button.dataset.deleteId;

            const record =
                (window.records || []).find(
                    x => String(getValue(x, 'id', 'Id')) === String(id)
                );

            if (!record) {
                openRecordDeleteConfirm(
                    'رکورد نامشخص',
                    function () {
                        showDeleteError('رکورد موردنظر پیدا نشد.');
                        return false;
                    },
                    button
                );
                return;
            }

            const title =
                String(
                    getValue(record, 'usernameId', 'UsernameId') ||
                    (
                        String(getValue(record, 'firstName', 'FirstName') || '') +
                        ' ' +
                        String(getValue(record, 'lastName', 'LastName') || '')
                    ).trim() ||
                    id
                );

            openRecordDeleteConfirm(
                title,
                function () {
                    return deleteRecord(id, button);
                },
                button
            );
        });

    }

</script>

