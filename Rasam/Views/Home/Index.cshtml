<script>

    'use strict';

    /* =========================================================
       انتخاب تصویر
    ========================================================= */

    const IMAGE_DEFAULT_STATUS = 'تصویری انتخاب نشده (حداکثر ۵ مگابایت)';

    const imageScopes = {
        new: {
            input: 'newRecordImage',
            img: 'newRecordImagePreviewImg',
            empty: 'newRecordImageEmpty',
            status: 'newRecordImageStatus',
            clear: 'newRecordImageClear',
            badge: 'newRecordImageBadge',
            original: ''
        },
        edit: {
            input: 'editRecordImage',
            img: 'editImagePreviewImg',
            empty: 'editImageEmpty',
            status: 'editImageFileStatus',
            clear: 'editRecordImageClear',
            badge: 'editImageBadge',
            original: ''
        }
    };

    function imageEls(scope) {
        const s = imageScopes[scope];

        return {
            input: document.getElementById(s.input),
            img: document.getElementById(s.img),
            empty: document.getElementById(s.empty),
            status: document.getElementById(s.status),
            clear: document.getElementById(s.clear),
            badge: document.getElementById(s.badge)
        };
    }

    function renderImageStage(scope, src, isNew) {
        const e = imageEls(scope);
        if (!e.img) return;

        if (src) {
            e.img.src = src;
            e.img.hidden = false;
            e.empty.hidden = true;
        }
        else {
            e.img.removeAttribute('src');
            e.img.hidden = true;
            e.empty.hidden = false;
        }

        e.badge.hidden = !src;
        e.badge.textContent = isNew ? '✓ تصویر جدید' : '✓ تصویر فعلی';
        e.badge.classList.toggle('is-new', !!isNew);
    }

    function resetImageStage(scope, originalSrc) {
        const e = imageEls(scope);
        if (!e.input) return;

        imageScopes[scope].original = originalSrc || '';

        e.input.value = '';
        e.status.textContent = IMAGE_DEFAULT_STATUS;
        e.status.title = '';
        e.clear.hidden = true;

        renderImageStage(scope, imageScopes[scope].original, false);
    }

    function setupImagePicker(scope) {
        const e = imageEls(scope);
        if (!e.input) return;

        e.input.addEventListener('change', function () {
            const file = this.files && this.files[0];
            const original = imageScopes[scope].original;

            if (!file) {
                resetImageStage(scope, original);
                return;
            }

            if (!file.type.startsWith('image/')) {
                alert('لطفاً فقط فایل تصویر انتخاب کنید.');
                resetImageStage(scope, original);
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                alert('حجم تصویر نباید بیشتر از ۵ مگابایت باشد.');
                resetImageStage(scope, original);
                return;
            }

            const reader = new FileReader();

            reader.onload = function (event) {
                renderImageStage(scope, event.target.result, true);
                e.status.textContent = file.name;
                e.status.title = file.name;
                e.clear.hidden = false;
            };

            reader.readAsDataURL(file);
        });

        e.clear.addEventListener('click', function () {
            resetImageStage(scope, imageScopes[scope].original);
        });
    }

    /* راه‌اندازی رویدادها — از bootstrap صدا زده می‌شود */
    function initImagePickers() {

        setupImagePicker('new');

        setupImagePicker('edit');

        resetImageStage('new', '');

        resetImageStage('edit', '');

    }

</script>

