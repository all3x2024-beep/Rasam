<script>

    'use strict';

    /* =========================================================
       روابط پروفایل‌ها
    ========================================================= */

    window.relationsLoaded = false;
    let relationsLoading = null;

    /* انواع رابطه — ساختار پاسخ (camelCase / PascalCase / آرایه یا {data:[]}) نرمال می‌شود */
    async function loadRecordRelations() {

        if (relationsLoading) return relationsLoading;

        relationsLoading = (async () => {
            try {
                const response = await fetch(
                    '@Url.Action("GetRelations", "MetaData")',
                    { cache: 'no-store', credentials: 'same-origin' }
                );

                if (!response.ok)
                    throw new Error('خطا در دریافت انواع رابطه (HTTP ' + response.status + ')');

                const parsed = await response.json();
                const list = unwrapMetaList(parsed);

                if (!list)
                    throw new Error('ساختار پاسخ انواع رابطه ناشناخته است');

                window.relations = list
                    .filter(x => x !== null && typeof x === 'object')
                    .map(x => ({
                        id: String(pickMetaField(x, ['id', 'Id', 'ID', 'value', 'Value'], ['id', 'value'])),
                        type: String(pickMetaField(x, ['type', 'Type', 'title', 'Title', 'name', 'Name'], ['type', 'title', 'name']))
                    }))
                    .filter(x => x.id !== '' && x.type !== '');

                window.relationsLoaded = true;

                return window.relations;
            }
            finally {
                relationsLoading = null;
            }
        })();

        return relationsLoading;
    }

    function profileOptions(excludeId) {

        return window.records

            .filter(x =>
                String(
                    getValue(
                        x,
                        'id',
                        'Id'
                    )
                ) !==
                String(
                    excludeId || ''
                )
            )

            .map(x => {

                const id =
                    getValue(
                        x,
                        'id',
                        'Id'
                    );


                const username =
                    getValue(
                        x,
                        'usernameId',
                        'UsernameId'
                    );


                const name =
                    (
                        getValue(
                            x,
                            'firstName',
                            'FirstName'
                        ) +
                        ' ' +
                        getValue(
                            x,
                            'lastName',
                            'LastName'
                        )
                    ).trim();


                return `
                            <option value="${escapeHtml(id)}">
                                ${escapeHtml(
                                    username ||
                                    name ||
                                    ('رکورد ' + id)
                                )}
                            </option>
                        `;

            })

            .join('');
    }

    function relationOptions() {

        return (window.relations || [])
            .map(x => '<option value="' + escapeHtml(x.id) + '">' + escapeHtml(x.type) + '</option>')
            .join('');
    }

    /* مقدار select را می‌گذارد؛ اگر گزینه‌اش در فهرست نبود موقتاً اضافه می‌کند تا مقدار گم نشود */
    function setSelectValue(select, value, fallbackText) {

        if (!select) return;

        value = (value === null || value === undefined) ? '' : String(value);

        if (!value) {
            select.value = '';
            return;
        }

        let option = Array.from(select.options).find(o => o.value === value);

        if (!option) {
            option = document.createElement('option');
            option.value = value;
            option.textContent = fallbackText ? String(fallbackText) : ('مورد ' + value);
            select.appendChild(option);
        }

        select.value = value;
    }

    /* فهرست گزینه‌های ردیف‌های موجود را دوباره می‌سازد و مقدارهای انتخاب‌شده را نگه می‌دارد */
    function refreshRelationSelects(containerId, excludeId) {

        const container = document.getElementById(containerId);

        if (!container) return;

        container.querySelectorAll('.relation-row').forEach(row => {

            const target = row.querySelector('.relation-target');
            const type = row.querySelector('.relation-type');

            if (!target || !type) return;

            const targetValue = target.value;
            const typeValue = type.value;

            target.innerHTML = '<option value="">انتخاب رکورد مقصد</option>' + profileOptions(excludeId);
            type.innerHTML = '<option value="">انتخاب نوع رابطه</option>' + relationOptions();

            setSelectValue(target, targetValue);
            setSelectValue(type, typeValue);
        });
    }

    function addRelationRow(
        containerId,
        fromProfileId,
        existing = null
    ) {

        const container = document.getElementById(containerId);

        if (!container) return null;

        container.querySelector('.relation-empty')?.remove();

        const row = document.createElement('div');

        row.className = 'relation-row';

        row.innerHTML =
            '<select class="input relation-target">' +
                '<option value="">انتخاب رکورد مقصد</option>' +
                profileOptions(fromProfileId) +
            '</select>' +
            '<select class="input relation-type">' +
                '<option value="">انتخاب نوع رابطه</option>' +
                relationOptions() +
            '</select>' +
            '<button type="button" class="del-btn remove-relation-row" title="حذف" aria-label="حذف">' +
                DELETE_ICON_SVG +
            '</button>';

        container.appendChild(row);

        if (existing) {

            setSelectValue(
                row.querySelector('.relation-target'),
                getValue(existing, 'toProfileId', 'ToProfileId'),
                getValue(existing, 'toUsernameId', 'ToUsernameId')
            );

            setSelectValue(
                row.querySelector('.relation-type'),
                getValue(existing, 'relationId', 'RelationId'),
                getValue(existing, 'relation', 'Relation', 'type', 'Type')
            );
        }

        // اگر انواع رابطه هنوز نیامده‌اند (یا قبلاً خطا داشته‌اند) دوباره تلاش می‌شود
        if (!window.relationsLoaded) {
            loadRecordRelations()
                .then(() => refreshRelationSelects(containerId, fromProfileId))
                .catch(err => console.error(err));
        }

        return row;
    }

    /* ردیف‌های کامل (مقصد + نوع)، بدون تکرار */
    function getRelationRows(containerId) {

        const container = document.getElementById(containerId);

        if (!container) return [];

        const seen = new Set();

        return Array.from(container.querySelectorAll('.relation-row'))

            .map(row => ({
                toProfileId: row.querySelector('.relation-target')?.value || '',
                relationId: row.querySelector('.relation-type')?.value || ''
            }))

            .filter(x => {

                if (!x.toProfileId || !x.relationId) return false;

                const key = x.toProfileId + '|' + x.relationId;

                if (seen.has(key)) return false;

                seen.add(key);

                return true;
            });
    }

    /* ردیف نیمه‌پر (فقط مقصد یا فقط نوع) به‌جای حذف بی‌صدا، خطا می‌دهد */
    function validateRelationRows(containerId) {

        const container = document.getElementById(containerId);

        if (!container) return true;

        for (const row of container.querySelectorAll('.relation-row')) {

            const target = row.querySelector('.relation-target');
            const type = row.querySelector('.relation-type');

            const hasTarget = !!(target && target.value);
            const hasType = !!(type && type.value);

            if (hasTarget !== hasType) {

                alert('در بخش روابط، هر ردیف باید هم رکورد مقصد و هم نوع رابطه داشته باشد؛ ردیف ناقص را کامل یا حذف کنید.');

                (hasTarget ? type : target)?.focus();

                return false;
            }
        }

        return true;
    }

    async function saveRelations(
        fromProfileId,
        containerId
    ) {
        const rows = getRelationRows(containerId);
        let failed = 0;

        for (const row of rows) {
            const formData = new FormData();

            formData.append('fromProfileId', String(fromProfileId));
            formData.append('toProfileId', String(row.toProfileId));
            formData.append('relationId', String(row.relationId));
            formData.append('__RequestVerificationToken', getToken());

            try {
                const response = await fetch(
                    '@Url.Action("CreateProfileRelation", "Profile")',
                    {
                        method: 'POST',
                        body: formData,
                        credentials: 'same-origin'
                    }
                );

                const result = await response.json();

                if (!response.ok || !result.success) {
                    failed++;
                    console.error('Create relation:', result);
                }
            }
            catch (error) {
                failed++;
                console.error('Create relation:', error);
            }
        }

        return failed;
    }

    /* راه‌اندازی رویدادها — از bootstrap صدا زده می‌شود */
    function initRelationButtons() {

        /* =========================================================
           ADD RELATION BUTTONS
        ========================================================= */

        document.addEventListener(
            'click',
            function (event) {


                if (
                    event.target.closest(
                        '#addNewRelationRowBtn'
                    )
                ) {

                    addRelationRow(
                        'newRelationRows',
                        null
                    );

                }


                if (
                    event.target.closest(
                        '#addEditRelationRowBtn'
                    )
                ) {

                    addRelationRow(
                        'editRelationRows',
                        currentEditRecordId
                    );

                }


                const removeButton =
                    event.target.closest(
                        '.remove-relation-row'
                    );


                if (removeButton) {

                    const row =
                        removeButton.closest(
                            '.relation-row'
                        );


                    row?.remove();

                }

            }
        );

    }

</script>

