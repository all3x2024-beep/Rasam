<script>

    'use strict';

    /* =========================================================
       باز کردن فرم ویرایش
    ========================================================= */

    let editOpenToken = 0;
    let editRelationsReady = false;

    /* روابط ورودی (دیگران → این رکورد) فقط نمایش داده می‌شوند؛ از روی رکورد مبدأ ویرایش می‌شوند */
    function renderIncomingRelations(list) {

        const box = document.getElementById('editIncomingRelations');

        if (!box) return;

        if (!list || !list.length) {
            box.hidden = true;
            box.innerHTML = '';
            return;
        }

        const nameOf = id => {
            const r = (window.records || []).find(x => String(getValue(x, 'id', 'Id')) === String(id));
            return (r && getValue(r, 'usernameId', 'UsernameId')) || ('رکورد ' + id);
        };

        box.innerHTML =
            '<div class="relation-incoming-title">روابط ورودی (فقط نمایش؛ از روی رکورد مبدأ ویرایش می‌شوند)</div>' +
            list.map(rel =>
                '<div class="relation-incoming-item">' +
                    '<span>' + escapeHtml(nameOf(getValue(rel, 'fromProfileId', 'FromProfileId'))) + '</span>' +
                    '<span>←</span>' +
                    '<span>' + escapeHtml(getValue(rel, 'relation', 'Relation', 'type', 'Type')) + '</span>' +
                '</div>'
            ).join('');

        box.hidden = false;
    }

    async function openEditModal(record) {

        currentEditRecordId =
            getValue(
                record,
                'id',
                'Id'
            );


        document.getElementById(
            'editRecordInternalId'
        ).value =
            currentEditRecordId;


        document.getElementById(
            'editRecordUsernameId'
        ).value =
            getValue(
                record,
                'usernameId',
                'UsernameId'
            );


        document.getElementById(
            'editPid'
        ).value =
            getValue(
                record,
                'pid',
                'PID'
            );


        document.getElementById(
            'editFirstName'
        ).value =
            getValue(
                record,
                'firstName',
                'FirstName'
            );


        document.getElementById(
            'editLastName'
        ).value =
            getValue(
                record,
                'lastName',
                'LastName'
            );


        document.getElementById(
            'editNationalId'
        ).value =
            getValue(
                record,
                'nationalCode',
                'NationalCode'
            );


        document.getElementById(
            'editMobile'
        ).value =
            getValue(
                record,
                'phone',
                'Phone'
            );


        document.getElementById(
            'editCountry'
        ).value =
            getValue(
                record,
                'country',
                'Country'
            );


        document.getElementById(
            'editNotes'
        ).value =
            getValue(
                record,
                'theory',
                'Theory'
            );


        const openToken = ++editOpenToken;

        editRelationsReady = false;


        await ensureMetaLoaded();

        // اگر در این فاصله رکورد دیگری باز شد، این اجرا کنار می‌رود
        if (openToken !== editOpenToken) return;


        applyRecordTopic(record);


        applyRecordTags(record);


        setSocialDraft('edit', record.socialMedia || record.SocialMedia || []);


        const currentImage = getValue(record, 'image', 'Image');
        resetImageStage('edit', currentImage || '');

        window.RasamAttach?.setExisting(record);


        const relationContainer =
            document.getElementById(
                'editRelationRows'
            );


        renderIncomingRelations([]);


        relationContainer.innerHTML = `

                    <div class="relation-empty">
                        ⏳ در حال بارگذاری روابط...
                    </div>

                `;


        try {

            const response =
                await fetch(
                    '@Url.Action("GetProfileRelations", "Profile")?profileId=' +
                    encodeURIComponent(
                        currentEditRecordId
                    ),
                    {
                        cache: 'no-store',
                        credentials: 'same-origin'
                    }
                );


            if (openToken !== editOpenToken) return;


            relationContainer.innerHTML = '';


            if (response.ok) {

                const relationData =
                    await response.json();

                if (openToken !== editOpenToken) return;

                const list =
                    Array.isArray(relationData)
                        ? relationData
                        : (unwrapMetaList(relationData) || []);

                // فقط روابط خروجی (این رکورد → مقصد) قابل ویرایش‌اند؛
                // روابط ورودی جدا و فقط‌خواندنی نمایش داده می‌شوند
                const current = String(currentEditRecordId);
                const outgoing = [];
                const incoming = [];

                list.forEach(rel => {

                    const from = String(getValue(rel, 'fromProfileId', 'FromProfileId'));
                    const to = String(getValue(rel, 'toProfileId', 'ToProfileId'));

                    const isOutgoing = from !== '' ? from === current : to !== current;

                    (isOutgoing ? outgoing : incoming).push(rel);
                });


                if (!outgoing.length) {

                    relationContainer.innerHTML = `

                                <div class="relation-empty">
                                    هنوز رابطه‌ای ثبت نشده است.
                                </div>

                            `;

                }
                else {

                    outgoing.forEach(
                        relation => {

                            addRelationRow(
                                'editRelationRows',
                                currentEditRecordId,
                                relation
                            );

                        }
                    );

                }

                renderIncomingRelations(incoming);

                // فقط وقتی روابط فعلی با موفقیت خوانده شدند، ذخیره اجازه دارد آن‌ها را جایگزین کند
                editRelationsReady = true;

            }
            else {

                relationContainer.innerHTML = `

                            <div class="relation-empty">
                                دریافت روابط انجام نشد.
                            </div>

                        `;

            }

        }
        catch (err) {

            console.error(err);

            if (openToken !== editOpenToken) return;

            relationContainer.innerHTML = `

                        <div class="relation-empty">
                            خطا در دریافت روابط.
                        </div>

                    `;

        }


        document.getElementById(
            'editRecordTitle'
        ).textContent =
            'ویرایش رکورد ' +
            (
                getValue(
                    record,
                    'usernameId',
                    'UsernameId'
                ) || ''
            );


        openModal(
            document.getElementById(
                'editModal'
            )
        );

    }

    /* راه‌اندازی رویدادها — از bootstrap صدا زده می‌شود */
    function initEditOpen() {

        document.addEventListener(
            'click',
            async function (event) {

                const button =
                    event.target.closest(
                        '[data-edit-id]'
                    );


                if (!button)
                    return;


                const id =
                    button.dataset.editId;


                const record =
                    window.records.find(
                        x =>
                            String(
                                getValue(
                                    x,
                                    'id',
                                    'Id'
                                )
                            ) ===
                            String(id)
                    );


                if (!record) {

                    alert(
                        'رکورد موردنظر پیدا نشد.'
                    );

                    return;
                }


                await openEditModal(record);

            }
        );

    }

</script>

