     SCRIPT 05 · تگ‌ها
========================================================= -->
<script>

    'use strict';

    /* =========================================================
       تگ‌ها
    ========================================================= */

    function fillTagSelects(tags, errorMessage) {

        ['newRecordTag', 'editRecordTag'].forEach(id => {

            const select = document.getElementById(id);

            if (!select) return;

            const previous = getMultiSelectValues(select);

            select.innerHTML = '';

            if (errorMessage) select.dataset.error = errorMessage;
            else delete select.dataset.error;

            tags.forEach(tag => {
                const option = document.createElement('option');
                option.value = tag.id;
                option.textContent = tag.title;
                option.selected = previous.includes(tag.id);
                select.appendChild(option);
            });

            initSmartMultiSelect(select);
            refreshSmartMultiSelect(select);

            const ph = select.nextElementSibling?.querySelector('.smart-select-placeholder');
            if (ph) {
                ph.textContent = errorMessage
                    ? '⚠ ' + errorMessage
                    : 'تگ‌ها را انتخاب کنید (' + tags.length + ' تگ)';
            }
        });
    }

    async function loadRecordTags(force) {

        if (!force && window.metaCache.tags) {
            fillTagSelects(window.metaCache.tags);
            return window.metaCache.tags;
        }

        if (tagsLoading) return tagsLoading;

        tagsLoading = (async () => {
            try {
                const tags = await fetchMetaList(
                    '@Url.Action("GetTags", "MetaData")',
                    'خطا در دریافت تگ‌ها'
                );
                window.metaCache.tags = tags;
                fillTagSelects(tags);
                return tags;
            }
            catch (err) {
                console.error(err);
                window.metaCache.tags = null;
                fillTagSelects([], 'بارگذاری تگ‌ها ناموفق بود: ' + (err && err.message ? err.message : err));
                return [];
            }
            finally {
                tagsLoading = null;
            }
        })();

        return tagsLoading;
    }

    /* هر بار که مودال باز می‌شود موضوع‌ها، تگ‌ها و انواع رابطه تازه‌سازی می‌شوند
       (هم برای تلاش مجدد پس از خطا، هم برای دیدن موارد تازه‌اضافه‌شده).
       فهرست رکوردها (مقصد روابط) فقط در صورت خالی بودن دوباره گرفته می‌شود.
       این تابع هرگز reject نمی‌شود. */
    async function ensureMetaLoaded() {

        const tasks = [
            loadRecordTopics(true),
            loadRecordTags(true),
            loadRecordRelations().catch(err => console.error(err))
        ];

        if (!Array.isArray(window.records) || !window.records.length)
            tasks.push(loadRecords().catch(err => console.error(err)));

        await Promise.all(tasks);
    }

    /* انتخاب تگ‌های رکورد در فرم ویرایش (با شناسه یا در نبود شناسه با عنوان) */
    function applyRecordTags(record) {

        const select = document.getElementById('editRecordTag');

        if (!select) return;

        const ids = new Set();
        const titles = new Set();

        const tagIds = getValue(record, 'tagIds', 'TagIds');

        if (Array.isArray(tagIds))
            tagIds.forEach(x => ids.add(String(x)));

        const tags = getValue(record, 'tags', 'Tags');

        (Array.isArray(tags) ? tags : []).forEach(t => {
            if (t !== null && typeof t === 'object') {
                const id = getValue(t, 'id', 'Id', 'tagId', 'TagId');
                const title = getValue(t, 'title', 'Title', 'name', 'Name');
                if (id !== '') ids.add(String(id));
                else if (title !== '') titles.add(String(title).trim());
            }
            else if (t !== null && t !== undefined && t !== '') {
                titles.add(String(t).trim());
            }
        });

        const selected = Array.from(select.options)
            .filter(o => ids.has(o.value) || titles.has((o.textContent || '').trim()))
            .map(o => o.value);

        setMultiSelectValues(select, selected);
    }


</script>

