@{
    ViewData["Title"] = "ورود اطلاعات پروفایل از اکسل";
}

<section class="card" dir="rtl">

    <div class="toolbar">

        <button class="btn btn-primary">
              
            📊 ورود اطلاعات پروفایل از اکسل
        </button>

    </div>

    <div class="table-wrap">

        @if (TempData["ImportError"] is string report)
        {
            <div class="p-3" dir="rtl">
                <h5>⚠️ گزارش نهایی Import</h5>

                <pre class="text-wrap mb-0"
                     style="white-space: pre-wrap; overflow-wrap: anywhere;">@report</pre>
            </div>
        }

        @if (TempData["ImportSuccess"] is string success)
        {
            <div class="p-3" role="status">
                <strong>✅ عملیات موفق</strong>
                <p class="mb-0 mt-2">@success</p>
            </div>
        }

        <div class="p-3">

            <div class="mb-4">
                <strong>راهنما</strong>

                <p class="mt-2 mb-0">
                    فایل اکسل باید شامل ستون‌های موردنیاز جدول Profile باشد.
                    فقط فایل با فرمت XLSX انتخاب کنید.
                </p>
            </div>

            <form asp-controller="Import"
                  asp-action="ProfilesImport"
                  method="post"
                  enctype="multipart/form-data"
                  id="profileImportForm">

                @Html.AntiForgeryToken()

                <div class="mb-3">

                    <label for="file" class="form-label">
                        انتخاب فایل اکسل
                    </label>

                    <input type="file"
                           id="file"
                           name="file"
                           class="form-control"
                           accept=".xlsx"
                           required />

                    <p id="fileInfo" class="mt-2 mb-0"></p>

                    <p id="fileError"
                       class="mt-2 mb-0"
                       hidden
                       role="alert"></p>

                </div>

                <div class="toolbar">

                    <button type="submit"
                            id="submitButton"
                            class="btn btn-primary">
                        📤 شروع Import
                    </button>

                    <button type="button"
                            id="removeFileBtn"
                            class="btn btn-info">
                        🗑️ حذف فایل انتخاب‌شده
                    </button>

                </div>

            </form>

        </div>

    </div>

</section>

@section Scripts {
    <script>
        (() => {
            const fileInput = document.getElementById('file');
            const fileInfo = document.getElementById('fileInfo');
            const fileError = document.getElementById('fileError');
            const form = document.getElementById('profileImportForm');
            const submitButton = document.getElementById('submitButton');
            const removeFileBtn = document.getElementById('removeFileBtn');

            let isSubmitting = false;

            function clearError() {
                fileError.textContent = '';
                fileError.hidden = true;
                fileInput.setCustomValidity('');
            }

            function showError(message) {
                fileError.textContent = message;
                fileError.hidden = false;
                fileInput.setCustomValidity(message);
            }

            function resetFile() {
                fileInput.value = '';
                fileInfo.textContent = '';
                clearError();
            }

            function validateFile(file) {
                clearError();

                if (!file) {
                    fileInfo.textContent = '';
                    return false;
                }

                if (!file.name.toLowerCase().endsWith('.xlsx')) {
                    resetFile();
                    showError('لطفاً یک فایل با فرمت XLSX انتخاب کنید.');
                    return false;
                }

                if (file.size === 0) {
                    resetFile();
                    showError('فایل انتخاب‌شده خالی است.');
                    return false;
                }

                const sizeMB = (file.size / (1024 * 1024)).toFixed(2);

                fileInfo.textContent =
                    `نام فایل: ${file.name} | حجم: ${sizeMB} MB`;

                return true;
            }

            fileInput.addEventListener('change', function () {
                const file = this.files && this.files[0];

                if (!file) {
                    fileInfo.textContent = '';
                    clearError();
                    return;
                }

                validateFile(file);
            });

            removeFileBtn.addEventListener('click', function () {
                if (isSubmitting) {
                    return;
                }

                resetFile();
            });

            form.addEventListener('submit', function (event) {
                if (isSubmitting) {
                    event.preventDefault();
                    return;
                }

                const file = fileInput.files && fileInput.files[0];

                if (!file) {
                    event.preventDefault();
                    showError('ابتدا یک فایل اکسل انتخاب کنید.');
                    fileInput.reportValidity();
                    return;
                }

                if (!validateFile(file)) {
                    event.preventDefault();
                    fileInput.reportValidity();
                    return;
                }

                if (!form.checkValidity()) {
                    event.preventDefault();
                    form.reportValidity();
                    return;
                }

                isSubmitting = true;

                submitButton.disabled = true;
                removeFileBtn.disabled = true;

                submitButton.textContent =
                    '⏳ در حال پردازش فایل...';
            });
        })();
    </script>
}
