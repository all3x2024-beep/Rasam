            );

        }


        async function parseResponse(response) {

            const text =
                await response.text();


            try {

                return JSON.parse(text);

            }
            catch {

                return {
                    success: false,
                    message: text || 'خطای نامشخص از سرور.'
                };

            }

        }


        // =========================================================
