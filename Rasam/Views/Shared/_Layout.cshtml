                const topics =
                    await response.json();


                const list =
                    document.getElementById(
                        'settingsTopicList'
                    );

                const empty =
                    document.getElementById(
                        'settingsTopicsEmpty'
                    );


                if (!list || !empty) {
                    return;
                }


                list.innerHTML = '';


                if (!Array.isArray(topics) || topics.length === 0) {

                    empty.hidden = false;

                    return;

                }


                empty.hidden = true;


                topics.forEach(function (topic) {

                    const item =
                        document.createElement('div');

                    item.className =
                        'settings-tag-item';


