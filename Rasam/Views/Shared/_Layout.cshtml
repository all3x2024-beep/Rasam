<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <script>
        (function () {
            try {
                if (localStorage.getItem('rasam-theme') === 'dark') {
                    document.documentElement.classList.add('dark');
                }
            } catch (e) { }
        })();
    </script>

    <title>
        @ViewData["Title"] - سامانه بانک اطلاعات تصویری رصام
    </title>

    <link rel="shortcut icon" href="~/favicon.ico"type="image/x-icon" />


    @* ---- core ---- *@
    <link rel="stylesheet" href="~/css/core/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/core/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/core/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/core/footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/core/login.css" asp-append-version="true" />
    @* ---- components (پایه) ---- *@
    <link rel="stylesheet" href="~/css/components/buttons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/counter.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/toast.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/table.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/empty-state.css" asp-append-version="true" />

    @* ---- components ---- *@
    <link rel="stylesheet" href="~/css/components/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/smart-select.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/social-picker.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/dialogs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/profile-menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/alerts.css" asp-append-version="true" />

    @* ---- pages ---- *@
    <link rel="stylesheet" href="~/css/pages/records-table.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/record-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/record-image.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/relations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/attachments.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/gallery.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/mersad.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/settings.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/graph.css" asp-append-version="true" />


</head>

<body>

    @{
        // نام کاربر فعال؛ اگر کاربر وارد نشده باشد فقط آیکون نمایش داده می‌شود
        var currentUserName = User.Identity?.IsAuthenticated == true ? User.Identity.Name : null;
    }

    <canvas class="app-bg-canvas"
            id="appBackgroundCanvas">
    </canvas>


    <div class="app-shell">


        <!-- Header -->

        <header class="header">

<a asp-controller="Home" asp-action="Index"
   style="text-decoration:none; color:inherit">
    <div class="brand">
        <div class="brand-icon">🗂️</div>
        <div class="brand-text">
            <h1>سامانه بانک اطلاعات تصویری رصام</h1>
            <p>مدیریت اطلاعات فضای مجازی</p>
        </div>
    </div>
</a>


            <div class="actions">

                <button class="btn btn-toggle" title="درون‌ریزی"
                        onclick="location.href='@Url.Action("Menu", "Import")'">
                    📥
                </button>

                <button class="btn btn-toggle"
                        id="settingsBtn"
                        type="button"
                        title="تنظیمات">

                    ⚙️

                </button>


                <button class="btn btn-toggle"
                        id="themeToggleBtn"
                        type="button"
                        title="تغییر پوسته"
                        aria-label="تغییر پوسته">

                    🌙

                </button>


                <div class="profile-menu">

                    <button class="btn btn-toggle profile-menu-toggle"
                            id="profileMenuBtn"
                            type="button"
                            title="مدیریت پروفایل"
                            aria-label="مدیریت پروفایل"
                            aria-haspopup="true"
                            aria-expanded="false">

                        <span class="profile-menu-icon" aria-hidden="true">👤</span>

                        @if (!string.IsNullOrWhiteSpace(currentUserName))
                        {
                            <span class="profile-menu-name" dir="auto">@currentUserName</span>
                        }

                    </button>

                    <div class="profile-submenu"
                         id="profileSubmenu"
                         role="menu">

                        <a class="profile-submenu-item"
                           role="menuitem"
                           href="@Url.Action("ChangePassword", "Accounting")">
                            🔑 تغییر رمز
                        </a>

                        <a class="profile-submenu-item"
                           role="menuitem"
                           href="@Url.Action("UserIndex", "Accounting")">
                            👤 تغییر پروفایل
                        </a>

                        <a class="profile-submenu-item profile-submenu-danger"
                           role="menuitem"
                           href="@Url.Action("LogOut", "Accounting")">
                            🚪 خروج
                        </a>

                    </div>

                </div>

            </div>

        </header>


        <!-- Main -->

        <main role="main"
              class="app-main">

            @RenderBody()

        </main>


        <!-- Footer -->
        <footer class="statusbar mt-auto p-2">
            <div class="statusbar-col statusbar-status">

                <span class="status-dot active"
                      id="statusDot">
                </span>

                <span id="statusText">
                    سامانه آماده به کار است
                </span>

            </div>


            <div class="statusbar-col statusbar-clock"
                 id="statusbarClock">

                —

            </div>


            <div class="statusbar-col statusbar-credit">

                توسعه یافته توسط سرباز گمنام

            </div>

        </footer>
    </div>


    <!-- ================================
         Settings Modal
    ================================= -->
    @Html.AntiForgeryToken()

    <!-- ==============================
         Settings Modal
    ================================ -->

    <div class="modal"
         id="settingsModal">


        <div class="modal-content settings-content">

            <div class="modal-header">

                <div>
                    <h3>⚙️ تنظیمات سامانه</h3>

                    <div class="modal-header-sub">
                        مدیریت موضوعات، تگ‌ها و روابط سامانه
                    </div>
                </div>

                <button class="close-btn modalCloseBtn"
                        type="button">
                    ×
                </button>

            </div>


            <div class="settings-tabs"
                 role="tablist">

                <button class="settings-tab active"
                        type="button"
                        role="tab"
                        aria-selected="true"
                        data-tab="backup">
                    💾 پشتیبان‌گیری
                </button>

                <button class="settings-tab"
                        type="button"
                        role="tab"
                        aria-selected="false"
                        data-tab="topics">
                    🗂️ موضوعات <span class="settings-tab-count"></span>
                </button>

                <button class="settings-tab"
                        type="button"
                        role="tab"
                        aria-selected="false"
                        data-tab="tags">
                    🏷️ تگ‌ها <span class="settings-tab-count"></span>
                </button>

                <button class="settings-tab"
                        type="button"
                        role="tab"
                        aria-selected="false"
                        data-tab="relations">
                    🔗 روابط <span class="settings-tab-count"></span>
                </button>

            </div>

            <div class="modal-body">


                <!-- ==============================
                     Backup / Restore
                ================================= -->

                <div class="settings-section is-active" data-tab="backup" role="tabpanel">

                    <div class="settings-section-header">

                        <div>

                            <h4>💾 پشتیبان‌گیری و بازیابی</h4>

                            <p>
                                از اطلاعات پایگاه داده پشتیبان بگیرید یا اطلاعات قبلی را وارد کنید.
                                مبنای داده فایل اکسل (DATA.xlsx) است و عکس‌ها در پوشه PHOTO قرار می‌گیرند.
                            </p>

                        </div>

                    </div>

                    <div class="bk-actions">

                        <button class="btn btn-primary"
                                id="bkBackupBtn"
                                type="button">
                            ⬇️ پشتیبان‌گیری
                        </button>

                        <button class="btn btn-secondary"
                                id="bkRestoreBtn"
                                type="button">
                            📦 بازیابی
                        </button>

                    </div>

                    <p class="bk-note">
                        بازیابی، اطلاعات فعلی را پاک نمی‌کند؛ فقط موارد جدید اضافه می‌شوند
                        و رکوردهایی که شناسه یا کد ملی‌شان از قبل ثبت شده باشد به‌عنوان تکراری رد می‌شوند.
                        برای بازیابی، پوشه‌ای شامل فایل اکسل (DATA.xlsx) و پوشه عکس‌ها را انتخاب کنید.
                    </p>

                    <div class="bk-danger-box">

                        <div>
                            <strong>حذف همه داده‌ها</strong>
                            <span>
                                پروفایل‌ها، روابط، شبکه‌های اجتماعی، تصاویر و موضوعات حذف می‌شوند.
                                تگ‌ها و انواع رابطه باقی می‌مانند. قبل از ادامه حتماً پشتیبان‌گیری کنید.
                            </span>
                        </div>

                        <button class="btn btn-danger"
                                id="bkDeleteAllBtn"
                                type="button">
                            🗑️ حذف کامل بدون بازگشت
                        </button>

                    </div>

                    <input type="file"
                           id="bkFolderInput"
                           webkitdirectory
                           directory
                           multiple
                           hidden />

                </div>


                <!-- ==============================
                     Topics
                ================================= -->

                <div class="settings-section" data-tab="topics" role="tabpanel">

                    <div class="settings-section-header">

                        <div>

                            <h4>🗂️ موضوعات</h4>

                            <p>
                                موضوعات قابل انتخاب برای پروفایل‌ها را مدیریت کنید.
                            </p>

                        </div>

                    </div>


                    <div class="tag-create-row">

                        <input id="newTopicInput"
                               type="text"
                               placeholder="مثلاً پرونده‌های عمومی، بررسی ویژه..."
                               autocomplete="off">

                        <button class="btn btn-primary"
                                id="addTopicBtn"
                                type="button">

                            ➕ افزودن موضوع

                        </button>

                    </div>


                    <div class="settings-tag-list"
                         id="settingsTopicList">
                    </div>


                    <div class="settings-empty"
                         id="settingsTopicsEmpty"
                         hidden>

                        هنوز موضوعی تعریف نشده است.

                    </div>

                </div>


                <!-- ==============================
                     Tags
                ================================= -->

                <div class="settings-section" data-tab="tags" role="tabpanel">

                    <div class="settings-section-header">

                        <div>

                            <h4>🏷️ تگ‌ها</h4>

                            <p>
                                تگ‌های قابل انتخاب هنگام ویرایش پروفایل را تعریف کنید.
                            </p>

                        </div>

                    </div>


                    <div class="tag-create-row">

                        <input id="newTagInput"
                               type="text"
                               placeholder="مثلاً مهم، بررسی، ویژه..."
                               autocomplete="off">

                        <button class="btn btn-primary"
                                id="addTagBtn"
                                type="button">

                            ➕ افزودن تگ

                        </button>

                    </div>


                    <div class="settings-tag-list"
                         id="settingsTagList">
                    </div>


                    <div class="settings-empty"
                         id="settingsTagsEmpty"
                         hidden>

                        هنوز تگی تعریف نشده است.

                    </div>

                </div>


                <!-- ==============================
                     Relations
                ================================= -->

                <div class="settings-section" data-tab="relations" role="tabpanel">

                    <div class="settings-section-header">

                        <div>

                            <h4>🔗 روابط</h4>

                            <p>
                                انواع ارتباط قابل انتخاب بین پروفایل‌ها را مدیریت کنید.
                            </p>

                        </div>

                    </div>


                    <div class="tag-create-row">

                        <input id="newRelationInput"
                               type="text"
                               placeholder="مثلاً مدیر، همکار، وابسته..."
                               autocomplete="off">

                        <button class="btn btn-primary"
                                id="addRelationBtn"
                                type="button">

                            ➕ افزودن رابطه

                        </button>

                    </div>


                    <div class="settings-tag-list"
                         id="settingsRelationList">
                    </div>


                    <div class="settings-empty"
                         id="settingsRelationsEmpty"
                         hidden>

                        هنوز رابطه‌ای تعریف نشده است.

                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button class="btn btn-secondary modalCloseBtn"
                        type="button">

                    بستن

                </button>

            </div>

        </div>


    </div>

    <!-- ==============================
         Delete Confirmation Modal
    ================================ -->

    <div class="modal"
         id="deleteConfirmModal">


        <div class="modal-content delete-confirm-content">

            <div class="modal-header">

                <div>

                    <h3>⚠️ تأیید حذف</h3>

                    <div class="modal-header-sub">
                        حذف این مورد قابل بازگشت نیست.
                    </div>

                </div>

                <button class="close-btn"
                        id="deleteConfirmCloseBtn"
                        type="button">
                    ×
                </button>

            </div>


            <div class="modal-body">

                <div class="delete-confirm-message">

                    <span class="delete-confirm-icon">
                        🗑️
                    </span>

                    <div>
                        آیا از حذف
                        <strong id="deleteConfirmName"></strong>
                        مطمئن هستید؟
                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button class="btn btn-secondary"
                        id="deleteCancelBtn"
                        type="button">

                    انصراف

                </button>

                <button class="btn btn-danger"
                        id="deleteConfirmBtn"
                        type="button">

                    🗑️ حذف

                </button>

            </div>

        </div>


    </div>

    <!-- ==============================
         Delete ALL data – confirmation modal
    ================================ -->

    <div class="modal"
         id="bkDeleteModal">

        <div class="modal-content bk-confirm-content">

            <div class="modal-header">

                <div>
                    <h3>⚠️ حذف همه داده‌ها</h3>
                    <div class="modal-header-sub">این عملیات قابل بازگشت نیست.</div>
                </div>

                <button class="close-btn"
                        id="bkDeleteCloseX"
                        type="button">
                    ×
                </button>

            </div>

            <div class="modal-body">

                <p class="bk-confirm-text">
                    همه پروفایل‌ها، روابط، شبکه‌های اجتماعی، تصاویر و موضوعات حذف می‌شوند.
                    قبل از ادامه از «پشتیبان‌گیری» استفاده کنید.
                    برای تأیید، کلمه <strong>حذف</strong> را در کادر زیر بنویسید.
                </p>

                <input class="bk-confirm-input"
                       id="bkDeleteInput"
                       type="text"
                       autocomplete="off"
                       placeholder="حذف" />

            </div>

            <div class="modal-footer">

                <button class="btn btn-secondary"
                        id="bkDeleteCancelBtn"
                        type="button">
                    انصراف
                </button>

                <button class="btn btn-danger"
                        id="bkDeleteConfirmBtn"
                        type="button"
                        disabled>
                    🗑️ حذف کامل
                </button>

            </div>

        </div>

    </div>

    <!-- ==============================
         Backup / Restore progress modal
    ================================ -->

    <div class="modal"
         id="bkProgressModal">

        <div class="modal-content bk-progress-content">

            <div class="modal-header">

                <div>
                    <h3 id="bkTitle">💾 پشتیبان‌گیری و بازیابی</h3>
                    <div class="modal-header-sub" id="bkSub"></div>
                </div>

                <button class="close-btn"
                        id="bkCloseX"
                        type="button"
                        disabled>
                    ×
                </button>

            </div>

            <div class="modal-body">

                <div class="bk-bar">
                    <div class="bk-bar-fill" id="bkBarFill"></div>
                </div>

                <div class="bk-meta">
                    <span id="bkStatus"></span>
                    <span id="bkPct">۰٪</span>
                </div>

                <div class="bk-result" id="bkResult" hidden></div>

                <div class="bk-log" id="bkLog"></div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-primary"
                        id="bkReloadBtn"
                        type="button"
                        hidden>
                    🔄 تازه‌سازی صفحه
                </button>

                <button class="btn btn-secondary"
                        id="bkCloseBtn"
                        type="button"
                        disabled>
                    بستن
                </button>

            </div>

        </div>

    </div>


    <script>
        (function () {
            'use strict';
            var modal = document.getElementById('settingsModal');
            if (!modal) return;

            var tabs = Array.prototype.slice.call(modal.querySelectorAll('.settings-tab'));
            var panels = Array.prototype.slice.call(modal.querySelectorAll('.settings-section[data-tab]'));

            function activate(name) {
                tabs.forEach(function (t) {
                    var on = t.getAttribute('data-tab') === name;
                    t.classList.toggle('active', on);
                    t.setAttribute('aria-selected', on ? 'true' : 'false');
                });
                panels.forEach(function (p) {
                    p.classList.toggle('is-active', p.getAttribute('data-tab') === name);
                });
            }

            tabs.forEach(function (t) {
                t.addEventListener('click', function () { activate(t.getAttribute('data-tab')); });
            });

            // item counters on the tabs
            [['settingsTopicList', 'topics'], ['settingsTagList', 'tags'], ['settingsRelationList', 'relations']].forEach(function (pair) {
                var list = document.getElementById(pair[0]);
                var badge = modal.querySelector('.settings-tab[data-tab="' + pair[1] + '"] .settings-tab-count');
                if (!list || !badge) return;

                function update() {
                    var n = list.querySelectorAll('.settings-tag-item').length;
                    badge.textContent = n ? n.toLocaleString('fa-IR') : '';
                }
                new MutationObserver(update).observe(list, { childList: true, subtree: true });
                update();
            });
        })();
    </script>

    <script>

        document.addEventListener('DOMContentLoaded', function () {

            console.log('Rasam Metadata JS loaded');


            // =====================================================
            // Elements
            // =====================================================

            const themeToggleBtn =
                document.getElementById('themeToggleBtn');

            const profileMenuBtn =
                document.getElementById('profileMenuBtn');

            const profileSubmenu =
                document.getElementById('profileSubmenu');


            // =====================================================
            // Theme Toggle
            // =====================================================

            function applyTheme(isDark) {

                document.documentElement.classList.toggle('dark', isDark);

                if (themeToggleBtn) {
                    themeToggleBtn.textContent = isDark ? '☀️' : '🌙';
                    themeToggleBtn.setAttribute(
                        'aria-label',
                        isDark ? 'تغییر به پوسته روشن' : 'تغییر به پوسته تیره'
                    );
                    themeToggleBtn.title = isDark ? 'پوسته روشن' : 'پوسته تیره';
                }

            }

            const savedTheme = localStorage.getItem('rasam-theme');
            applyTheme(savedTheme === 'dark');

            if (themeToggleBtn) {

                themeToggleBtn.addEventListener('click', function () {

                    const isDark =
                        !document.documentElement.classList.contains('dark');

                    applyTheme(isDark);
                    localStorage.setItem(
                        'rasam-theme',
                        isDark ? 'dark' : 'light'
                    );

                });

            }


            // =====================================================
            // Profile Menu
            // =====================================================

            if (profileMenuBtn && profileSubmenu) {

                profileMenuBtn.addEventListener('click', function (event) {

                    event.stopPropagation();

                    const isOpen = profileSubmenu.classList.toggle('show');
                    profileMenuBtn.setAttribute(
                        'aria-expanded',
                        isOpen ? 'true' : 'false'
                    );

                });

                document.addEventListener('click', function () {

                    profileSubmenu.classList.remove('show');
                    profileMenuBtn.setAttribute('aria-expanded', 'false');

                });

                document.addEventListener('keydown', function (event) {

                    if (event.key === 'Escape') {
                        profileSubmenu.classList.remove('show');
                        profileMenuBtn.setAttribute('aria-expanded', 'false');
                    }

                });

            }


            const settingsBtn =
                document.getElementById('settingsBtn');

            const settingsModal =
                document.getElementById('settingsModal');

            const deleteConfirmModal =
                document.getElementById('deleteConfirmModal');

            const deleteConfirmName =
                document.getElementById('deleteConfirmName');

            const deleteConfirmBtn =
                document.getElementById('deleteConfirmBtn');

            const deleteCancelBtn =
                document.getElementById('deleteCancelBtn');

            const deleteConfirmCloseBtn =
                document.getElementById('deleteConfirmCloseBtn');


            let pendingDelete = null;


            // =====================================================
            // Settings Modal
            // =====================================================

            if (settingsBtn && settingsModal) {

                settingsBtn.addEventListener('click', function () {

                    settingsModal.classList.add('show');

                    loadTopics();
                    loadTags();
                    loadRelations();

                });

            }


            // =====================================================
            // Close Main Modal
            // =====================================================

            document
                .querySelectorAll('.modalCloseBtn')
                .forEach(function (button) {

                    button.addEventListener('click', function () {

                        const modal =
                            button.closest('.modal');

                        if (modal) {
                            modal.classList.remove('show');
                        }

                    });

                });


            // =====================================================
            // Close Delete Modal
            // =====================================================

            function closeDeleteModal() {

                if (deleteConfirmModal) {
                    deleteConfirmModal.classList.remove('show');
                }

                pendingDelete = null;

            }


            deleteCancelBtn?.addEventListener(
                'click',
                closeDeleteModal
            );


            deleteConfirmCloseBtn?.addEventListener(
                'click',
                closeDeleteModal
            );


            // =====================================================
            // Outside Modal Click
            // =====================================================

            window.addEventListener('click', function (event) {

                if (event.target.classList.contains('modal')) {

                    event.target.classList.remove('show');

                    if (event.target === deleteConfirmModal) {
                        pendingDelete = null;
                    }

                }

            });


            // =====================================================
            // Escape
            // =====================================================

            window.addEventListener('keydown', function (event) {

                if (event.key !== 'Escape') {
                    return;
                }


                const modal =
                    document.querySelector('.modal.show');


                if (!modal) {
                    return;
                }


                modal.classList.remove('show');

                if (modal === deleteConfirmModal) {
                    pendingDelete = null;
                }

            });


            // =====================================================
            // Add Topic
            // =====================================================

            document
                .getElementById('addTopicBtn')
                ?.addEventListener('click', addTopic);


            document
                .getElementById('newTopicInput')
                ?.addEventListener('keydown', function (event) {

                    if (event.key === 'Enter') {

                        event.preventDefault();

                        addTopic();

                    }

                });


            // =====================================================
            // Add Tag
            // =====================================================

            document
                .getElementById('addTagBtn')
                ?.addEventListener('click', addTag);


            document
                .getElementById('newTagInput')
                ?.addEventListener('keydown', function (event) {

                    if (event.key === 'Enter') {

                        event.preventDefault();

                        addTag();

                    }

                });


            // =====================================================
            // Add Relation
            // =====================================================

            document
                .getElementById('addRelationBtn')
                ?.addEventListener('click', addRelation);


            document
                .getElementById('newRelationInput')
                ?.addEventListener('keydown', function (event) {

                    if (event.key === 'Enter') {

                        event.preventDefault();

                        addRelation();

                    }

                });


            // =====================================================
            // Delete Confirmation
            // =====================================================

            deleteConfirmBtn?.addEventListener(
                'click',
                async function () {

                    if (!pendingDelete) {
                        return;
                    }


                    const action =
                        pendingDelete;


                    deleteConfirmBtn.disabled = true;


                    try {

                        await action();

                    }
                    finally {

                        deleteConfirmBtn.disabled = false;

                        closeDeleteModal();

                    }

                }
            );


            // =====================================================
            // Anti Forgery
            // =====================================================

            window.getAntiForgeryToken = function () {

                const input =
                    document.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    );

                return input ? input.value : '';

            };


            // =====================================================
            // Open Delete Modal
            // =====================================================

            window.openDeleteConfirm = function (
                name,
                deleteFunction
            ) {

                pendingDelete = deleteFunction;


                if (deleteConfirmName) {
                    deleteConfirmName.textContent =
                        `"${name}"`;
                }


                if (deleteConfirmModal) {
                    deleteConfirmModal.classList.add('show');
                }

            };


        });


        // =========================================================
