        // =========================================================

        async function addTopic() {

            const input =
                document.getElementById(
                    'newTopicInput'
                );


            if (!input) {
                return;
            }


            const title =
                input.value.trim();


            if (!title) {

                alert('عنوان موضوع را وارد کنید.');

                input.focus();

                return;

            }


            const formData =
                new FormData();

            formData.append('title', title);

            formData.append(
                '__RequestVerificationToken',
                getAntiForgeryToken()
            );


            try {

                const response =
                    await fetch(
                        '/MetaData/CreateTopic',
                        {
                            method: 'POST',
                            body: formData
                        }
                    );


                const result =
                    await parseResponse(response);


                if (!response.ok || !result.success) {

                    alert(
                        result.message ||
                        'افزودن موضوع انجام نشد.'
                    );

                    return;

                }


                input.value = '';

                await loadTopics();

                notifyMetadataChanged('topic');

            }
            catch (error) {

                console.error(
                    'CreateTopic error:',
                    error
                );

                alert('خطا در ارتباط با سرور.');

            }

        }


