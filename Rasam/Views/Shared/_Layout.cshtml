        async function loadTopics() {

            try {

                const response =
                    await fetch('/MetaData/GetTopics', {
                        cache: 'no-store'
                    });


                if (!response.ok) {
                    console.error(
                        'GetTopics failed:',
                        response.status
                    );
                    return;
